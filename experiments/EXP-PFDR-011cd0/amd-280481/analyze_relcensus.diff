+def ss4_estimation_rungs(rows: dict, hrows: dict) -> dict:
+    """AMD-20261002-280481 A-1 (b) and A-2 (i).  The (SS, 4) P0 estimation rungs are the TWO
+    HIGHEST even rungs b <= 32 at which the archived census-mode random-arm SS m = 4 instances
+    with status completed_valid number at least one and are ALL complete at scope A_fix under
+    I-8's completeness definition (archived_complete).  Records the per-rung completeness table
+    (instance counts only, no relation count; complete counts completed_valid instances that are
+    complete).  Stops P0 (non-zero exit, before design.json and power.json are written) if fewer
+    than two rungs qualify or the selection is not exactly {22, 24}."""
+    expected = (22, 24)
+    label = "SS m 4 P0 inputs estimated at 22-24 bits; TA-1 assumed, not verified by P0"
+    tab = {b: {"complete": 0, "completed_valid": 0, "total": 0} for b in range(12, 33, 2)}
+    for k, row in rows.items():
+        b, c, mm, arm, mode = k
+        if mm != 4 or mode != "census" or b is None or b > 32 or b % 2:
+            continue
+        t = tab.setdefault(b, {"complete": 0, "completed_valid": 0, "total": 0})
+        t["total"] += 1
+        if row.get("status") != "completed_valid":
+            continue
+        t["completed_valid"] += 1
+        if archived_complete(row, hrows[k], "SS", "A_fix"):
+            t["complete"] += 1
+    qualifying = sorted(b for b, t in tab.items() if t["completed_valid"] >= 1 and t["complete"] == t["completed_valid"])
+    selected = qualifying[-2:]
+    rec = {"rule": "AMD-20261002-280481 A-1 (b): the two highest even rungs b <= 32 whose archived "
+                   "census-mode random-arm SS m = 4 completed_valid instances number >= 1 and are all "
+                   "complete at scope A_fix (I-8 completeness)",
+           "completeness_table": {str(b): tab[b] for b in sorted(tab)},
+           "completeness_table_note": "instance counts only (complete / completed_valid / total); "
+                                      "complete counts completed_valid instances complete at A_fix",
+           "qualifying_rungs": qualifying, "selected_rungs": selected,
+           "expected_rungs": list(expected), "label": label}
+    if len(qualifying) < 2 or tuple(selected) != expected:
+        print(json.dumps({"p0_stop": "AMD-20261002-280481 A-1 (b)", "selection": rec}), file=sys.stderr)
+        raise SystemExit("P0 stop (AMD-20261002-280481 A-1 (b)): "
+                         + ("fewer than two rungs qualify" if len(qualifying) < 2 else
+                            f"selection {selected} is not exactly {list(expected)}")
+                         + "; design.json and power.json not written")
+    return rec
+
