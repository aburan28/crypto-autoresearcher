      "measurement_methods": {
        "allocated_storage": "st_blocks*512; physical totals deduplicate (st_dev,st_ino)",
        "disk_io": "macOS proc_pid_rusage RUSAGE_INFO_V4 ri_diskio_bytesread and ri_diskio_byteswritten before wait/reap; unavailable fails",
        "kernel_peak_rss": "wait4 ru_maxrss in bytes on the frozen macOS platform",
        "logical_io": "all source-owned open,close,stat,read,write,fsync,rename,link,unlink wrappers increment calls and exact byte counts",
        "sampled_rss": "parent proc_pid_rusage physical footprint every 10ms"
      },
      "optimizer_conservation": [
        "push_calls = frontier_pushes + push_terminal_leaves + push_pruned_cap + push_pruned_bound",
        "frontier_pops = nodes_started + pop_pruned_bound",
        "nodes_completed = nodes_started on success",
        "branch_children_generated = 2*nodes_completed",
        "optimizer_include_branches = optimizer_exclude_branches = nodes_completed",
        "frontier_pushes = frontier_pops + remaining_frontier_nodes + final_filter_discards",
        "bound_calls = frontier_pushes + push_pruned_bound",
        "metric_cache_lookups = metric_cache_hits + metric_cache_misses",
        "metric_cache_misses = metric_cache_inserts = metric_cache_final_entries",
        "metric_cache_peak_entries >= metric_cache_final_entries",
        "full_model_cache_lookups = full_model_cache_hits + full_model_cache_misses",
        "full_model_cache_misses = full_model_cache_inserts = full_model_cache_final_entries",
        "full_model_cache_peak_entries >= full_model_cache_final_entries",
        "retained_model_calls = full_model_cache_misses",
        "retained_model_cells = sum(event.formal_family_count for every retained-model miss event)",
        "frontier_serialized_entries = remaining_frontier_nodes",
        "frontier_serialized_bytes = byte_length(canonical_json(frontier_states))",
        "frontier_peak_entries >= remaining_frontier_nodes",
        "nodes_pruned_conflict = 0 for the pinned optimizer",
        "conflict_vertices_removed = exact sum of include-branch removed available vertices",
        "full_objective_exact iff remaining_frontier_nodes=0, absolute_gap=0, and lower_bound=upper_bound"
      ],
