{
  "source_schema": {
    "accounting": {
      "aggregate_equations": [
        "observed_totals = componentwise_sum(supervisor.observed_counters, attempt.observed_counters for every attempt)",
        "charged_totals = componentwise_sum(supervisor.charged_counters, attempt.charged_counters for every attempt)",
        "failed_attempt_totals = componentwise_sum(attempt.charged_counters for attempts with failure.status != success)",
        "logical_artifact_bytes = sum(storage_artifact.logical_bytes for every logical artifact)",
        "physical_artifact_bytes = sum(one allocated_bytes value per distinct (st_dev,st_ino))",
        "final_retained_allocated_bytes = sum(allocated_bytes for retained distinct physical artifacts)",
        "peak_live_temporary_allocated_bytes is the maximum sampled live allocated total, not a sum over samples",
        "campaign_storage_charge = peak_live_temporary_allocated_bytes + final_retained_allocated_bytes",
        "cpu totals are sums; wall_makespan_ns is max(end)-min(start); peak RSS is max, never sum"
      ],
      "attempt_exact_keys": [
        "schema",
