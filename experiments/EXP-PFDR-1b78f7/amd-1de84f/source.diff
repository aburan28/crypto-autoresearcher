+def _twist_orders_exhaustive(p):
+    """#E for y^2 = x^3 + g^i, i = 0..5, by the Legendre-symbol sum over every x (no BSGS)."""
+    from crypto_autoresearcher.index_calculus.curve import primitive_root
+
+    sq = bytearray(p)
+    for y in range(1, p):
+        sq[y * y % p] = 1
+    g = primitive_root(p)
+    orders = []
+    for i in range(6):
+        b = pow(g, i, p)
+        s = 0
+        for x in range(p):
+            v = (x * x * x + b) % p
+            if v:
+                s += 1 if sq[v] else -1
+        orders.append(p + 1 + s)
+    return orders
+
