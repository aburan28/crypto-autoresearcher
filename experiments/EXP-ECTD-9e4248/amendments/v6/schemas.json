{
  "schema": "crypto.autoresearch.ectd_v6_schema_bundle.v1",
  "jcs_profile": {
    "bom": false,
    "encoding": "UTF-8",
    "profile": "RFC8785",
    "terminal_lf": false,
    "unsafe_integer_rule": "Every integer with absolute value greater than 9007199254740991 is encoded as a base-10 string matching ^-?(0|[1-9][0-9]*)$; record fields declared exactDecimal use that encoding at every magnitude."
  },
  "rejection_precedence": [
    "INPUT_SERIALIZATION_MISMATCH",
    "EMPTY_TRACE_INTERVAL",
    "NONINTEGRAL_P",
    "NONINTEGRAL_N",
    "N_BIT_LENGTH_MISMATCH",
    "P_NOT_ODD",
    "N_NOT_ODD",
    "P_COMPOSITE",
    "N_COMPOSITE",
    "HASSE_BOUND_FAILURE",
    "ORDER_IDENTITY_FAILURE",
    "DISCRIMINANT_IDENTITY_FAILURE",
    "ACCEPTED"
  ],
  "rejection_registry": {
    "INPUT_SERIALIZATION_MISMATCH": {"class": "arithmetic_rejection", "details": ["expected_sha256", "observed_sha256"], "stage": "SERIALIZATION"},
    "EMPTY_TRACE_INTERVAL": {"class": "resource_incomplete", "details": ["lower_N", "upper_N_exclusive", "L", "r"], "stage": "INTERVAL"},
    "NONINTEGRAL_P": {"class": "arithmetic_rejection", "details": ["p_numerator", "denominator"], "stage": "ARITHMETIC"},
    "NONINTEGRAL_N": {"class": "arithmetic_rejection", "details": ["M", "h"], "stage": "ARITHMETIC"},
    "N_BIT_LENGTH_MISMATCH": {"class": "arithmetic_rejection", "details": ["N", "expected_bits", "observed_bits"], "stage": "ARITHMETIC"},
    "P_NOT_ODD": {"class": "arithmetic_rejection", "details": ["p"], "stage": "ARITHMETIC"},
    "N_NOT_ODD": {"class": "arithmetic_rejection", "details": ["N"], "stage": "ARITHMETIC"},
    "P_COMPOSITE": {"class": "arithmetic_rejection", "details": ["p"], "stage": "PRIMALITY"},
    "N_COMPOSITE": {"class": "arithmetic_rejection", "details": ["N"], "stage": "PRIMALITY"},
    "HASSE_BOUND_FAILURE": {"class": "arithmetic_rejection", "details": ["p", "t", "t_squared", "four_p"], "stage": "ARITHMETIC"},
    "ORDER_IDENTITY_FAILURE": {"class": "arithmetic_rejection", "details": ["p", "t", "M", "h", "N"], "stage": "ARITHMETIC"},
    "DISCRIMINANT_IDENTITY_FAILURE": {"class": "arithmetic_rejection", "details": ["p", "t", "D_K", "f_pi", "lhs", "rhs"], "stage": "ARITHMETIC"},
    "SOURCE_GAP": {"class": "resource_incomplete", "details": ["missing_paths"], "stage": "SOURCE_CUSTODY"},
    "FIELD_CONSTRUCTION_FAILURE": {"class": "construction_rejection", "details": ["field_id", "reason"], "stage": "FIELD"},
    "CM_MODEL_ABSENT": {"class": "construction_rejection", "details": ["D_K", "enumerated_models"], "stage": "CM_MODEL"},
    "CM_MODEL_AMBIGUOUS": {"class": "construction_rejection", "details": ["D_K", "canonical_keys"], "stage": "CM_MODEL"},
    "TWIST_ORDER_MISMATCH": {"class": "construction_rejection", "details": ["model_key", "twist_orders"], "stage": "TWIST"},
    "ORDER_CERTIFICATE_FAILURE": {"class": "construction_rejection", "details": ["curve_key", "claimed_M"], "stage": "ORDER_CERTIFICATE"},
    "ORDER_N_POINT_CERTIFICATE_FAILURE": {"class": "construction_rejection", "details": ["curve_key", "point_key", "N"], "stage": "ORDER_N_POINT"},
    "Q_DIVISION_POLYNOMIAL_FAILURE": {"class": "construction_rejection", "details": ["curve_key", "q"], "stage": "Q_DIVISION_POLYNOMIAL"},
    "ELL_DIVISION_POLYNOMIAL_FAILURE": {"class": "construction_rejection", "details": ["curve_key", "ell"], "stage": "ELL_DIVISION_POLYNOMIAL"},
    "CYCLIC_LINE_ENUMERATION_FAILURE": {"class": "construction_rejection", "details": ["prime", "expected_lines", "observed_lines"], "stage": "CYCLIC_LINES"},
    "FROBENIUS_STABILITY_FAILURE": {"class": "construction_rejection", "details": ["kernel_sha256", "prime"], "stage": "FROBENIUS_STABILITY"},
    "KERNEL_CANONICALIZATION_FAILURE": {"class": "construction_rejection", "details": ["kernel_sha256", "reason"], "stage": "CANONICAL_KERNEL"},
    "VELU_CODOMAIN_FAILURE": {"class": "construction_rejection", "details": ["kernel_sha256", "codomain_key"], "stage": "VELU_CODOMAIN"},
    "DUAL_COMPOSITION_FAILURE": {"class": "construction_rejection", "details": ["isogeny_sha256", "degree"], "stage": "DUAL"},
    "END_RING_CERTIFICATE_FAILURE": {"class": "construction_rejection", "details": ["endpoint_key", "reason"], "stage": "END_RING"},
    "ENDPOINT_CONDUCTOR_FAILURE": {"class": "construction_rejection", "details": ["endpoint_key", "reported_conductor", "reason"], "stage": "ENDPOINT_CONDUCTOR"},
    "D7_TWO_ADIC_CERTIFICATE_FAILURE": {"class": "construction_rejection", "details": ["endpoint_key", "observed_v2"], "stage": "ENDPOINT_CONDUCTOR"},
    "D7_Q_ADIC_CERTIFICATE_FAILURE": {"class": "construction_rejection", "details": ["endpoint_key", "q", "observed_vq"], "stage": "ENDPOINT_CONDUCTOR"},
    "HORIZONTAL_WHOLE_CONDUCTOR_FAILURE": {"class": "construction_rejection", "details": ["endpoint_A_conductor", "endpoint_B_conductor", "q"], "stage": "ENDPOINT_CONDUCTOR"},
    "CONTROL_MEASUREMENT_INVALID": {"class": "construction_rejection", "details": ["arm", "reason"], "stage": "CONTROL"},
    "RESOURCE_LIMIT": {"class": "resource_incomplete", "details": ["resource", "limit"], "stage": "RESOURCE"},
    "DEPENDENCY_FAILURE": {"class": "failed_infrastructure", "details": ["dependency", "reason"], "stage": "INFRASTRUCTURE"},
    "TIMEOUT": {"class": "failed_infrastructure", "details": ["stage", "limit_seconds"], "stage": "INFRASTRUCTURE"},
    "CRASH": {"class": "failed_infrastructure", "details": ["stage", "exit_code"], "stage": "INFRASTRUCTURE"},
    "UNREGISTERED_EXCEPTION": {"class": "invalid", "details": ["exception_type"], "stage": "INTEGRITY"},
    "CUSTODY_FAILURE": {"class": "invalid", "details": ["path", "expected_sha256", "observed_sha256"], "stage": "INTEGRITY"},
    "FALSE_RECEIPT": {"class": "invalid", "details": ["receipt_sha256", "reason"], "stage": "INTEGRITY"},
    "POST_TARGET_GATE_FAILURE": {"class": "invalid", "details": ["gate", "target_bytes_existed"], "stage": "INTEGRITY"},
    "CONSTRUCTION_COMPLETE": {"class": "completed_static_construction", "details": [], "stage": "COMPLETE"}
  },
  "$defs": {
    "decimal": {"pattern": "^-?(0|[1-9][0-9]*)$", "type": "string"},
    "nonnegativeDecimal": {"pattern": "^(0|[1-9][0-9]*)$", "type": "string"},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "rational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {"pattern": "^[1-9][0-9]*$", "type": "string"},
        "numerator": {"$ref": "#/$defs/decimal"}
      },
      "required": ["denominator", "numerator"],
      "type": "object"
    },
    "opaqueReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"minLength": 1, "type": "string"},
        "replay_check": {"type": "boolean"}
      },
      "required": ["artifact_sha256", "kind", "replay_check"],
      "type": "object"
    }
  },
  "schemas": {
    "candidate": {
      "$id": "crypto.autoresearch.ectd_v6_candidate.v1",
      "additionalProperties": false,
      "properties": {
        "D_K": {"enum": [-7, -8, -11, -19]},
        "L": {"enum": [2, 6, 12, 32]},
        "amendment_ordinal": {"const": 6},
        "counter": {"maximum": 4999, "minimum": 0, "type": "integer"},
        "experiment_id": {"const": "EXP-ECTD-9e4248"},
        "f_pi": {"maximum": 62, "minimum": 1, "type": "integer"},
        "h": {"enum": [1, 3, 6, 8]},
        "horizontal_ell": {"enum": [2, 3, 5]},
        "map_domain": {"const": "ECTD-V6-ORDER-SEMANTIC-MAP-20260813"},
        "q": {"enum": [17, 19, 23, 29, 31]},
        "r": {"enum": [0, 1, 3, 6, 8]},
        "schema": {"const": "crypto.autoresearch.ectd_v6_candidate.v1"},
        "seed": {"maximum": 308, "minimum": 301, "type": "integer"},
        "slot": {"maximum": 7, "minimum": 0, "type": "integer"},
        "target_N_bits": {"enum": [40, 43, 46, 49, 52, 55, 58, 60]}
      },
      "required": ["D_K", "L", "amendment_ordinal", "counter", "experiment_id", "f_pi", "h", "horizontal_ell", "map_domain", "q", "r", "schema", "seed", "slot", "target_N_bits"],
      "type": "object"
    },
    "arithmetic_witness": {
      "$id": "crypto.autoresearch.ectd_v6_arithmetic_witness.v1",
      "additionalProperties": false,
      "properties": {
        "D_K": {"enum": [-7, -8, -11, -19]}, "L": {"enum": [2, 6, 12, 32]},
        "M": {"$ref": "#/$defs/nonnegativeDecimal"}, "N": {"$ref": "#/$defs/nonnegativeDecimal"},
        "counter": {"maximum": 4999, "minimum": 0, "type": "integer"},
        "f_pi": {"$ref": "#/$defs/nonnegativeDecimal"}, "h": {"enum": [1, 3, 6, 8]},
        "horizontal_ell": {"enum": [2, 3, 5]}, "input_sha256": {"$ref": "#/$defs/sha256"},
        "p": {"$ref": "#/$defs/nonnegativeDecimal"}, "q": {"enum": [17, 19, 23, 29, 31]},
        "r": {"enum": [0, 1, 3, 6, 8]}, "schema": {"const": "crypto.autoresearch.ectd_v6_arithmetic_witness.v1"},
        "seed": {"type": "integer"}, "shake256_32_hex": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "slot": {"maximum": 7, "minimum": 0, "type": "integer"}, "t": {"$ref": "#/$defs/nonnegativeDecimal"},
        "target_N_bits": {"enum": [40, 43, 46, 49, 52, 55, 58, 60]}
      },
      "required": ["D_K", "L", "M", "N", "counter", "f_pi", "h", "horizontal_ell", "input_sha256", "p", "q", "r", "schema", "seed", "shake256_32_hex", "slot", "t", "target_N_bits"],
      "type": "object"
    },
    "rejection": {
      "$id": "crypto.autoresearch.ectd_v6_rejection.v1",
      "additionalProperties": false,
      "properties": {
        "code": {"enum": ["INPUT_SERIALIZATION_MISMATCH", "EMPTY_TRACE_INTERVAL", "NONINTEGRAL_P", "NONINTEGRAL_N", "N_BIT_LENGTH_MISMATCH", "P_NOT_ODD", "N_NOT_ODD", "P_COMPOSITE", "N_COMPOSITE", "HASSE_BOUND_FAILURE", "ORDER_IDENTITY_FAILURE", "DISCRIMINANT_IDENTITY_FAILURE"]},
        "counter": {"maximum": 4999, "minimum": 0, "type": "integer"},
        "details": {"type": "object"}, "input_sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"const": "crypto.autoresearch.ectd_v6_rejection.v1"}, "seed": {"type": "integer"},
        "slot": {"maximum": 7, "minimum": 0, "type": "integer"},
        "stage": {"enum": ["SERIALIZATION", "INTERVAL", "ARITHMETIC", "PRIMALITY"]}
      },
      "required": ["code", "counter", "details", "input_sha256", "schema", "seed", "slot", "stage"],
      "type": "object"
    },
    "row_terminal": {
      "$id": "crypto.autoresearch.ectd_v6_row_terminal.v1",
      "additionalProperties": false,
      "properties": {
        "accepted_witness": {"anyOf": [{"$ref": "#/$defs/opaqueReceipt"}, {"type": "null"}]},
        "counters_evaluated": {"maximum": 5000, "minimum": 0, "type": "integer"},
        "details": {"type": "object"}, "last_counter": {"maximum": 4999, "minimum": 0, "type": ["integer", "null"]},
        "rejection_census": {"additionalProperties": {"minimum": 0, "type": "integer"}, "type": "object"},
        "schema": {"const": "crypto.autoresearch.ectd_v6_row_terminal.v1"},
        "slot": {"maximum": 7, "minimum": 0, "type": "integer"},
        "status": {"enum": ["first_accepted", "resource_incomplete", "failed_infrastructure", "invalid"]}
      },
      "required": ["accepted_witness", "counters_evaluated", "details", "last_counter", "rejection_census", "schema", "slot", "status"],
      "type": "object"
    },
    "construction_witness": {
      "$id": "crypto.autoresearch.ectd_v6_construction_witness.v1",
      "additionalProperties": false,
      "properties": {
        "D_K": {"enum": [-7, -8, -11, -19]}, "arithmetic_witness_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_kernels": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "type": "array"},
        "cm_models": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "minItems": 1, "type": "array"},
        "control_measurements": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "type": "array"},
        "cyclic_lines": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "type": "array"},
        "division_polynomials": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "minItems": 2, "type": "array"},
        "dual_checks": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "type": "array"},
        "end_ring_receipts": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "minItems": 4, "type": "array"},
        "field_receipts": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "minItems": 1, "type": "array"},
        "frobenius_stability": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "type": "array"},
        "horizontal_ell": {"$ref": "#/$defs/nonnegativeDecimal"},
        "horizontal_endpoints": {"items": {"additionalProperties": false, "properties": {"endpoint_key": {"type": "string"}, "q": {"$ref": "#/$defs/nonnegativeDecimal"}, "whole_conductor": {"$ref": "#/$defs/nonnegativeDecimal"}}, "required": ["endpoint_key", "q", "whole_conductor"], "type": "object"}, "maxItems": 2, "minItems": 2, "type": "array"},
        "order_N_point_certificates": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "type": "array"},
        "order_certificates": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "type": "array"},
        "q": {"$ref": "#/$defs/nonnegativeDecimal"}, "schema": {"const": "crypto.autoresearch.ectd_v6_construction_witness.v1"},
        "slot": {"maximum": 7, "minimum": 0, "type": "integer"}, "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "terminal": {"additionalProperties": false, "properties": {"class": {"enum": ["construction_rejection", "resource_incomplete", "failed_infrastructure", "invalid", "completed_static_construction"]}, "code": {"type": "string"}, "details": {"type": "object"}, "schema": {"const": "crypto.autoresearch.ectd_v6_construction_terminal.v1"}, "stage": {"type": "string"}}, "required": ["class", "code", "details", "schema", "stage"], "type": "object"},
        "twists": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "minItems": 2, "type": "array"},
        "velu_codomain_checks": {"items": {"$ref": "#/$defs/opaqueReceipt"}, "type": "array"},
        "vertical_endpoints": {"items": {"additionalProperties": false, "properties": {"endpoint_key": {"type": "string"}, "q_adic_certified": {"type": "boolean"}, "two_adic_certified": {"type": "boolean"}, "whole_conductor": {"$ref": "#/$defs/nonnegativeDecimal"}}, "required": ["endpoint_key", "q_adic_certified", "two_adic_certified", "whole_conductor"], "type": "object"}, "minItems": 2, "type": "array"}
      },
      "required": ["D_K", "arithmetic_witness_sha256", "canonical_kernels", "cm_models", "control_measurements", "cyclic_lines", "division_polynomials", "dual_checks", "end_ring_receipts", "field_receipts", "frobenius_stability", "horizontal_ell", "horizontal_endpoints", "order_N_point_certificates", "order_certificates", "q", "schema", "slot", "source_manifest_sha256", "terminal", "twists", "velu_codomain_checks", "vertical_endpoints"],
      "type": "object"
    }
  }
}
