{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EXP-CREP-001 representation package schema",
  "description": "Schema for typed representation packages (dependency graph, typed construction maps, declared exponent certificate) checked by experiments/EXP-CREP-001/verifier/check_representation.py. The verifier implements validation natively (the jsonschema library is not available in the execution environment); this document is the normative structure it enforces.",
  "type": "object",
  "required": ["package_id", "kind", "target", "dependency_graph", "exponent_certificate", "semantics", "provenance"],
  "additionalProperties": false,
  "properties": {
    "package_id": {"type": "string"},
    "kind": {"enum": ["route", "calibration"]},
    "route_id": {"type": "string"},
    "target": {"const": "z_R"},
    "dependency_graph": {
      "type": "object",
      "required": ["nodes", "edges", "roots", "sinks"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "phase", "produces", "retained", "declared"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "kind": {"type": "string"},
              "phase": {"enum": ["preprocessing", "online"]},
              "produces": {"type": "string"},
              "retained": {"type": "boolean"},
              "params": {"type": "object"},
              "declared": {
                "type": "object",
                "required": ["size_exponent_in_B"],
                "additionalProperties": false,
                "properties": {"size_exponent_in_B": {"type": "number", "minimum": 0}}
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "map"],
            "additionalProperties": false,
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "map": {
                "type": "object",
                "required": ["input_size_exponent_in_B", "output_size_exponent_in_B", "cost_exponent_in_B"],
                "additionalProperties": false,
                "properties": {
                  "input_size_exponent_in_B": {"type": "number", "minimum": 0},
                  "output_size_exponent_in_B": {"type": "number", "minimum": 0},
                  "cost_exponent_in_B": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        },
        "roots": {"type": "array", "items": {"type": "string"}},
        "sinks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exponent_certificate": {
      "type": "object",
      "required": ["preprocessing", "online", "replay_accounting", "aggregation_rule"],
      "additionalProperties": false,
      "properties": {
        "preprocessing": {
          "type": "object",
          "required": ["time_exponent_in_B", "retained_advice_exponent_in_B", "retained_state_exponent_in_B"],
          "additionalProperties": false,
          "properties": {
            "time_exponent_in_B": {"type": "number", "minimum": 0},
            "retained_advice_exponent_in_B": {"type": "number", "minimum": 0},
            "retained_state_exponent_in_B": {"type": "number", "minimum": 0}
          }
        },
        "online": {
          "type": "object",
          "required": ["time_exponent_in_B", "workspace_exponent_in_B", "materialized_target_dependent_coordinates_exponent_in_B"],
          "additionalProperties": false,
          "properties": {
            "time_exponent_in_B": {"type": "number", "minimum": 0},
            "workspace_exponent_in_B": {"type": "number", "minimum": 0},
            "materialized_target_dependent_coordinates_exponent_in_B": {"type": "number", "minimum": 0}
          }
        },
        "replay_accounting": {
          "type": "object",
          "required": ["dyadic_queries_per_tuple", "positive_and_negative_queries_included", "final_exact_source_verification_included"],
          "additionalProperties": false,
          "properties": {
            "dyadic_queries_per_tuple": {"type": "string"},
            "positive_and_negative_queries_included": {"type": "boolean"},
            "final_exact_source_verification_included": {"type": "boolean"}
          }
        },
        "aggregation_rule": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "semantics": {
      "type": "object",
      "required": ["engine"],
      "additionalProperties": false,
      "properties": {
        "engine": {"const": "crep-toy-v1"},
        "options": {"type": "object"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["built_by", "built_at_run"],
      "additionalProperties": false,
      "properties": {
        "built_by": {"type": "string"},
        "built_at_run": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
