{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Printed-only ECPP trace extraction",
  "type": "object",
  "required": [
    "schema",
    "raw_serial_sha256",
    "events",
    "unprinted_state",
    "inference_prohibited"
  ],
  "properties": {
    "schema": {
      "const": "trace_schema.json"
    },
    "raw_serial_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unprinted_state": {
      "const": "UNOBSERVED"
    },
    "inference_prohibited": {
      "const": "unprinted branches are not reconstructed as attempted"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "printed",
          "source_offset",
          "raw_utf8",
          "raw_hex"
        ],
        "properties": {
          "kind": {
            "enum": [
              "phase",
              "proving_job",
              "recursive_N",
              "recursive_status",
              "retry",
              "catalog_D",
              "stored_D",
              "proving_route",
              "factor_list",
              "unknown_marker"
            ]
          },
          "printed": {
            "const": true
          },
          "source_offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Byte offset in the original raw serial bytes; never an offset after CRLF normalization or replacement decoding."
          },
          "raw_utf8": {
            "type": "string",
            "description": "Lossy display only; raw_hex retains the exact source bytes."
          },
          "raw_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]*$"
          },
          "value": {},
          "index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "catalog_positions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "record",
                "byte_offset",
                "line",
                "factors",
                "class_number_sign_code"
              ]
            }
          },
          "special_route": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
