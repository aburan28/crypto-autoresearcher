      "known_reference_micro_hit_rate_sparse20": {"type": ["string", "null"]},
      "signed_paired_delta_sparse20_minus_boolean20": {"type": ["string", "null"], "description": "NA (null) if the common exact/uncontaminated/representable pair set is empty"},
      "null_weighted_hit_rates": {"type": "object", "additionalProperties": {"type": "string"}, "description": "per seed q_seed"},
      "exact_null_expectation": {"type": "string"},
      "margin_factor3_and_absolute_0_20": {"type": "object", "additionalProperties": {"type": "object", "properties": {"factor_three_ok": {"type": "boolean"}, "absolute_margin_ok": {"type": "boolean"}}}}
    }
  },
  "bootstrap_resample_row": {
    "description": "one row of bootstrap-resamples.jsonl (spec.bootstrap).",
