    "properties": {
      "resample_index": {"type": "integer", "minimum": 0, "maximum": 1999},
      "drawn_proposal_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
      "recomputed_micro_rate": {"type": ["string", "null"]},
      "recomputed_signed_delta": {"type": ["string", "null"]}
    },
    "denominator_check": "exactly 2000 rows (spec.bootstrap.resamples); NA for all rows if P<2 (spec.bootstrap.interpretation)."
  },
  "resource_sample_row": {
    "description": "one row of resource-samples.jsonl (spec.runtime.protection/.costs).",
    "type": "object",
    "required": ["timestamp_utc", "peak_rss_bytes", "cpu_seconds", "stage"],
    "properties": {
      "timestamp_utc": {"type": "string"},
      "peak_rss_bytes": {"type": ["integer", "null"], "description": "null/unknown if telemetry unavailable, never fabricated as zero"},
      "cpu_seconds": {"type": ["number", "null"]},
