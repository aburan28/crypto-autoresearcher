      "target_document_id": {"type": "string"},
      "recorded_term": {"type": "string"},
      "compiled_predicate": {"type": "object"},
      "term_level_match_counts": {"type": "object"},
      "target_level_match_flag": {"type": "boolean"},
      "boolean_composition": {"type": "string"},
      "failure_reason": {"type": ["string", "null"]},
      "rank_if_ranked": {"type": ["integer", "null"]}
    }
  },
  "metric_row": {
    "description": "metrics.json top-level primary/secondary metric fields (spec.metrics.primary/secondary).",
    "type": "object",
    "required": ["known_reference_micro_hit_rate_full_all", "known_reference_micro_hit_rate_boolean20", "known_reference_micro_hit_rate_sparse20", "signed_paired_delta_sparse20_minus_boolean20", "null_weighted_hit_rates", "exact_null_expectation", "margin_factor3_and_absolute_0_20"],
    "properties": {
