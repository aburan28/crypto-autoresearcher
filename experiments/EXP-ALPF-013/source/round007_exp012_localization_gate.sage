# ============================================================================
# PRIMITIVES (inline, matching the round-005 / task definitions exactly)
# ============================================================================
# For generators f_i of degree d_i with leading (top) forms h_i = top_form(f_i),
# at degree D the homogeneous Macaulay map phi_D has:
#   rows  = (monomial of degree D-d_i) * h_i   for each i and each such monomial,
#   cols  = all monomials of degree D in n variables.
# ker(phi_D) = #rows - rank(phi_D).
# trivial_koszul(D) = sum_{i<j} C(n-1 + D-d_i-d_j, D-d_i-d_j)   (Koszul syzygies).
# nontrivial(D) = ker(phi_D) - trivial_koszul(D).
# d_ff = smallest D with nontrivial(D) > 0.
# D_reg = smallest D where the Froberg series prod(1 - t^{d_i}) / (1-t)^n has a
#         coefficient <= 0.
# FIRES iff d_ff < D_reg.

def top_form_local(f):
    """Leading homogeneous form (highest total degree part) of polynomial f."""
    if f == 0:
        return f
    d = f.degree()
    R = f.parent()
    res = R(0)
    for mono, coeff in f.dict().items():
        if sum(mono) == d:
            res += coeff * R.monomial(*mono)
    return res

def _monomials_of_degree(R, D):
    """All monomials of total degree exactly D in ring R (as polynomials)."""
    n = R.ngens()
    if D < 0:
        return []
    mons = []
    # compositions of D into n nonnegative parts
    for comp in _weak_compositions(D, n):
        mons.append(R.monomial(*comp))
    return mons

def _weak_compositions(D, n):
    """Yield all n-tuples of nonneg ints summing to D."""
    if n == 1:
        yield (D,)
        return
    for first in range(D + 1):
        for rest in _weak_compositions(D - first, n - 1):
            yield (first,) + rest

def _num_monomials(n, D):
    """Number of monomials of degree D in n variables = C(n-1+D, D)."""
    if D < 0:
        return 0
    return binomial(n - 1 + D, D)

def macaulay_homog_rows(homog_forms, R, D):
    """
    Build the homogeneous Macaulay map at degree D for the given leading forms.
    Returns (matrix M over the base field, row_owner) where row_owner[k] = index i
    of the leading form that generated row k (so rows can be partitioned by owner).
    M has one row per (form_i, monomial m of degree D-deg(h_i)); the row is the
    coefficient vector of m*h_i in the degree-D monomial basis.
    """
    K = R.base_ring()
    cols = _monomials_of_degree(R, D)
    col_index = {}
    for j, m in enumerate(cols):
        col_index[m.exponents()[0]] = j
    rows = []
    row_owner = []
    for i, h in enumerate(homog_forms):
        if h == 0:
            continue
        di = h.degree()
        if D - di < 0:
            continue
        mults = _monomials_of_degree(R, D - di)
        for mm in mults:
            poly = mm * h
            vec = [K(0)] * len(cols)
            for mono, coeff in poly.dict().items():
                vec[col_index[mono]] = K(coeff)
            rows.append(vec)
            row_owner.append(i)
    if len(rows) == 0:
        M = matrix(K, 0, len(cols))
    else:
        M = matrix(K, rows)
    return M, row_owner, cols

def trivial_koszul_local(degs, n, D):
    """
    Trivial (Koszul) syzygy count at degree D:
      sum_{i<j} C(n-1 + (D - d_i - d_j), (D - d_i - d_j))  for D - d_i - d_j >= 0.
    """
    total = 0
    m = len(degs)
    for i in range(m):
        for j in range(i + 1, m):
            r = D - degs[i] - degs[j]
            if r >= 0:
                total += _num_monomials(n, r)
    return total

def froberg_Dreg_local(degs, n, Dmax=40):
    """
    Smallest D where the Froberg series  prod(1 - t^{d_i}) / (1-t)^n  has a
    coefficient <= 0. (Semi-regular degree of regularity.)

    NOTE: we read coefficients by EXPLICIT index series[D] up to a generous bound
    (NOT via series.list(), which strips trailing zero/negative coeffs and would
    cause us to miss the first non-positive coefficient -- the round-7 bug).
    """
    bound = max(Dmax, sum(int(d) for d in degs) + 4)
    Pt = PowerSeriesRing(QQ, 't', default_prec=bound + 4)
    t = Pt.gen()
    num = Pt(1)
    for d in degs:
        num = num * (1 - t**int(d))
    den = (1 - t)**int(n)
    series = num / den
    for D in range(bound + 1):
        if QQ(series[D]) <= 0:
            return D
    return None

def meter_local(polys, R, Dmax=14):
    """
    Base first-fall meter (inline replica of round-005 meter()).
    Returns dict with d_ff, D_reg, fires and per-degree nontrivial counts.
    """
    n = R.ngens()
    forms = [top_form_local(R(f)) for f in polys]
    degs = [h.degree() for h in forms]
    D_reg = froberg_Dreg_local(degs, n, Dmax=Dmax + 4)
    d_ff = None
    nontriv_profile = {}
    Dlimit = Dmax
    if D_reg is not None:
        Dlimit = max(Dmax, D_reg + 1)
    for D in range(1, Dlimit + 1):
        M, row_owner, cols = macaulay_homog_rows(forms, R, D)
        nrows = M.nrows()
        if nrows == 0:
            nontriv_profile[D] = 0
            continue
        rk = M.rank()
        ker = nrows - rk
        triv = trivial_koszul_local(degs, n, D)
        nontriv = ker - triv
        nontriv_profile[D] = int(nontriv)
        if d_ff is None and nontriv > 0:
            d_ff = D
        if d_ff is not None and D_reg is not None and D > D_reg:
            break
    fires = (d_ff is not None and D_reg is not None and d_ff < D_reg)
    return {
        "n": int(n),
        "degs": [int(d) for d in degs],
        "d_ff": (int(d_ff) if d_ff is not None else None),
        "D_reg": (int(D_reg) if D_reg is not None else None),
        "fires": bool(fires),
        "nontriv_profile": {int(k): int(v) for k, v in nontriv_profile.items()},
    }

# ============================================================================
# THE LOCALIZATION GATE
# ============================================================================
def _nontrivial_kernel_support_on_block(forms, R, D, sumpoly_indices):
    """
    At degree D, compute:
      - dim of the full (homogeneous) left-kernel of phi_D (= #rows - rank)
      - the dim of the part of that kernel supported ONLY on FB rows
        (obtained by removing the summation-poly row-block and recomputing).
    A nontrivial kernel vector involves a summation-poly leading form iff the
    full left-nullspace has support on the summation row block, which is detected
    by: rank(M) - rank(M_without_sum_block_rows) reflecting added relations, OR
    more directly by inspecting the left-kernel basis vectors' support on sum rows.

    We use the DIRECT definition required by the task:
      Build phi_D (rows = monomial-multiples of all leading forms, partitioned into
      SUM rows and FB rows). A LEFT-null vector v (v * M = 0) is a homogeneous syzygy
      (sum_k v_k * (mult_k * h_owner(k)) = 0). v "involves" the summation block iff
      v has a nonzero entry on a SUM row.

    GATE measurement: gate_passes iff there EXISTS a nontrivial (non-Koszul) syzygy
    whose left-null vector has nonzero support on the SUM rows. Operationally we
    compute it via the "block-zeroing shrink" criterion, which is equivalent and
    robust:
        full_nontriv  = (#rows - rank(M)) - koszul(D)
        fb_only_nontriv = nontriv computed on the FB-only subsystem (sum rows removed)
                          BUT measured as syzygies of the FULL column space that use
                          only FB rows = (#fb_rows - rank(M_fb)) - koszul_fb(D)
    Removing the sum rows can only remove syzygies that USE sum rows. If the total
    nontrivial syzygy module strictly shrinks when sum rows are deleted, then some
    nontrivial syzygy used a sum row => gate passes.

    Because Koszul (trivial) syzygies between a sum poly and an FB poly also "use" a
    sum row, we must be careful: the task's definition of "nontrivial" already
    subtracts ALL Koszul syzygies (including sum-FB Koszul pairs). So we compare the
    NONTRIVIAL counts directly.

    Returns dict with the diagnostic numbers and a boolean involves_sum.
    """
    n = R.ngens()
    degs = [h.degree() for h in forms]
    sum_set = set(int(i) for i in sumpoly_indices)
    fb_indices = [i for i in range(len(forms)) if i not in sum_set]

    # ---- FULL system nontrivial kernel ----
    M_full, owner_full, cols = macaulay_homog_rows(forms, R, D)
    nrows_full = M_full.nrows()
    rk_full = M_full.rank() if nrows_full > 0 else 0
    ker_full = nrows_full - rk_full
    koszul_full = trivial_koszul_local(degs, n, D)
    nontriv_full = ker_full - koszul_full

    # ---- FB-only system nontrivial kernel (sum rows removed) ----
    fb_forms = [forms[i] for i in fb_indices]
    fb_degs = [degs[i] for i in fb_indices]
    M_fb, owner_fb, cols_fb = macaulay_homog_rows(fb_forms, R, D)
    nrows_fb = M_fb.nrows()
    rk_fb = M_fb.rank() if nrows_fb > 0 else 0
    ker_fb = nrows_fb - rk_fb
    koszul_fb = trivial_koszul_local(fb_degs, n, D)
    nontriv_fb = ker_fb - koszul_fb

    # ---- Direct left-kernel support check (cross-validation of the shrink test) ----
    # Compute a basis of the left null space of M_full and test support on SUM rows.
    involves_sum_direct = None
    sum_row_positions = [k for k in range(nrows_full) if owner_full[k] in sum_set]
    fb_row_positions = [k for k in range(nrows_full) if owner_full[k] not in sum_set]
    try:
        if nrows_full > 0 and len(cols) > 0:
            LK = M_full.kernel()  # left kernel: vectors v with v*M = 0
            basisvecs = LK.basis()
            # Total left-kernel dimension:
            total_left_ker = len(basisvecs)
            # Sub-syzygies that use ONLY fb rows: left-null vectors supported on fb rows.
            # Build the submatrix of fb rows and compute its left-kernel dimension;
            # those are syzygies among fb rows alone (a subset of full syzygies).
            if len(fb_row_positions) > 0:
                M_fb_sub = M_full.matrix_from_rows(fb_row_positions)
                fb_only_left_ker = M_fb_sub.kernel().dimension()
            else:
                fb_only_left_ker = 0
            # If total left-kernel dim > fb-only left-kernel dim, some left-syzygy
            # genuinely involves a sum row.
            involves_sum_direct = (total_left_ker > fb_only_left_ker)
    except Exception as _e:
        involves_sum_direct = None

    # GATE criterion (shrink of nontrivial module). nontriv_full counts all
    # nontrivial syzygies; nontriv_fb counts those using only fb rows. If full > fb,
    # a nontrivial syzygy uses a sum row.
    involves_sum_shrink = (nontriv_full > nontriv_fb)

    return {
        "D": int(D),
        "nrows_full": int(nrows_full),
        "rank_full": int(rk_full),
        "ker_full": int(ker_full),
        "koszul_full": int(koszul_full),
        "nontriv_full": int(nontriv_full),
        "n_sum_rows": int(len(sum_row_positions)),
        "n_fb_rows": int(len(fb_row_positions)),
        "nrows_fb": int(nrows_fb),
        "rank_fb": int(rk_fb),
        "ker_fb": int(ker_fb),
        "koszul_fb": int(koszul_fb),
        "nontriv_fb": int(nontriv_fb),
        "involves_sum_shrink": bool(involves_sum_shrink),
        "involves_sum_direct": (None if involves_sum_direct is None else bool(involves_sum_direct)),
    }

def meter_gated(polys, R, sumpoly_indices, Dmax=14):
    """
    Gated first-fall meter.

    INPUTS
      polys           : list of polynomial generators (in ring R) of the system.
      R               : the (multivariate) polynomial ring; n = R.ngens().
      sumpoly_indices : iterable of integer indices into `polys` marking which
                        generators are SUMMATION-POLYNOMIAL relations (e.g. the
                        Semaev S_{m+1} relation). The rest are FB-membership
                        constraints. This is the partition the gate localizes on.
      Dmax            : max degree to probe.

    OUTPUT (dict)
      d_ff            : first-fall degree (smallest D with nontrivial(D) > 0), or None.
      D_reg           : Froberg degree of regularity, or None.
      fires           : bool, base meter fire (d_ff < D_reg).
      gate_passes     : bool, the LOCALIZATION GATE. True iff at d_ff at least one
                        nontrivial (non-Koszul) syzygy involves a summation-poly
                        leading form (i.e. zeroing the summation row-block strictly
                        shrinks the nontrivial kernel at d_ff).
      gate_meaningful : bool, fires AND gate_passes -- the only configuration that
                        represents an EXPLOITABLE index-calculus early fall.
      gate_detail     : the per-D diagnostic at d_ff.
      base            : the base-meter dict (d_ff, D_reg, fires, nontriv_profile).
    """
    n = R.ngens()
    forms = [top_form_local(R(f)) for f in polys]
    base = meter_local(polys, R, Dmax=Dmax)
    d_ff = base["d_ff"]

    gate_passes = False
    gate_detail = None
    if d_ff is not None:
        gate_detail = _nontrivial_kernel_support_on_block(forms, R, d_ff, sumpoly_indices)
        # Prefer the direct left-kernel test when available; fall back to shrink.
        if gate_detail["involves_sum_direct"] is not None:
            gate_passes = bool(gate_detail["involves_sum_direct"])
        else:
            gate_passes = bool(gate_detail["involves_sum_shrink"])

    fires = base["fires"]
    gate_meaningful = bool(fires and gate_passes)
    return {
        "d_ff": d_ff,
        "D_reg": base["D_reg"],
        "fires": fires,
        "gate_passes": gate_passes,
        "gate_meaningful": gate_meaningful,
        "gate_detail": gate_detail,
        "base": base,
    }

# ============================================================================
# SYSTEM BUILDERS for the validation cases
# ============================================================================

def build_POS_A():
    """
    POS-A control (base-meter self-validation, NO summation poly):
    3 cubics whose leading forms SHARE a common quadratic factor.
    Base meter MUST fire d_ff=4 < D_reg=7. Gate is N/A (no summation poly):
    we pass sumpoly_indices=[] so gate cannot pass (there is nothing to involve).
    """
    K = GF(10007)
    R = PolynomialRing(K, 4, 'x')
    x0, x1, x2, x3 = R.gens()
    q = x0**2 + x1*x2 + 7*x3**2  # shared quadratic factor (leading form)
    # 3 cubics = q * (linear) + lower order terms
    f0 = q * (x0 + 2*x1) + x0*x1 + 3
    f1 = q * (x1 + 5*x2) + x2*x3 + 1
    f2 = q * (x2 + 11*x3) + x0*x3 + 4
    return [f0, f1, f2], R, []  # no summation poly

def build_NEG_generic_quadrics():
    """NEG-1: 3 generic quadrics in 4 vars -- must stay quiet (no fire)."""
    set_random_seed(int(1))
    K = GF(10007)
    R = PolynomialRing(K, 4, 'x')
    polys = []
    for _ in range(3):
        f = R(0)
        for mono in _weak_compositions(2, 4):
            f += K.random_element() * R.monomial(*mono)
        for mono in _weak_compositions(1, 4):
            f += K.random_element() * R.monomial(*mono)
        f += K.random_element()
        polys.append(f)
    return polys, R, []

def build_NEG_generic_cubics():
    """NEG-2: 3 generic cubics in 4 vars -- must stay quiet (no fire)."""
    set_random_seed(int(2))
    K = GF(10007)
    R = PolynomialRing(K, 4, 'x')
    polys = []
    for _ in range(3):
        f = R(0)
        for d in range(3, -1, -1):
            for mono in _weak_compositions(d, 4):
                f += K.random_element() * R.monomial(*mono)
        polys.append(f)
    return polys, R, []

def build_ering_m3_semaev():
    """
    e-ring m=3 Semaev system (round-6 spurious fire).
    Leading-form degree profile [2, 2, 2, 4]: three FB-membership constraints of
    degree-2 leading forms that SHARE the elementary-symmetric factor e1, plus the
    S4 summation polynomial whose leading form has degree 4.

    Construction (matching the round-6 e-ring change of variables): the factor-base
    membership for a point x_i is encoded after substituting the elementary symmetric
    functions e1 = x0+x1+x2, e2 = x0x1+x0x2+x1x2, e3 = x0x1x2. The membership
    constraints (that each x_i lie in a chosen affine factor base, here modeled as a
    quadratic constraint) end up with leading forms that all contain the e1 linear
    factor (the POS-A mechanism) -> their products give a confined nontrivial syzygy
    at low degree. The summation relation S4 has a degree-4 leading form that does
    NOT enter the firing-degree Macaulay rows.

    We REPLICATE the leading-form profile faithfully (this is what the meter sees):
      vars: e1, e2, e3 (the symmetric coordinates) plus an auxiliary t.
      FB constraints: g_i = e1 * L_i(...) + (lower)  for i=0,1,2  (deg-2 lf sharing e1)
      Summation:      S = (deg-4 form) + (lower)
    The gate MUST FAIL: at d_ff the syzygy is among the g_i (sharing e1) and the S4
    rows do not appear at that degree.
    """
    K = GF(10007)
    R = PolynomialRing(K, 4, 'e')
    e1, e2, e3, t = R.gens()
    # three deg-2 FB constraints whose leading forms all carry the factor e1:
    g0 = e1 * (e1 + e2) + e3 + 1
    g1 = e1 * (e2 + 7*e3) + t + 2
    g2 = e1 * (3*e1 + t) + e2 + 5
    # S4 summation polynomial: leading form degree 4 (does not divide e1-cleanly,
    # generic quartic top form), plus lower-order terms.
    S4 = (e1**4 + e2**2*e3 + 11*e3*t**3 + e1*e2*e3*t) + e1*e2 + 3*t + 9
    polys = [g0, g1, g2, S4]
    sum_idx = [3]
    return polys, R, sum_idx

def build_powersum_m3_semaev():
    """
    power-sum m=3 Semaev system (round-6 spurious fire).
    Leading-form degree profile [2, 3, 4, 12]: FB constraints (lf deg 2,3,4) that
    share a common factor (power-sum Newton-identity structure), plus the S4
    summation poly with a degree-12 leading form. d_ff=3 < D_reg=7. Gate MUST FAIL:
    the deg-12 S4 leading form cannot appear in a degree-3 Macaulay row at all.
    """
    K = GF(10007)
    R = PolynomialRing(K, 4, 'p')
    p1, p2, p3, t = R.gens()
    # FB constraints sharing the linear factor p1 (Newton-identity / power-sum change):
    c0 = p1 * (p1 + p2) + t + 1            # lf degree 2, factor p1
    c1 = p1 * (p1**2 + p2*p3) + p2 + 2     # lf degree 3, factor p1
    c2 = p1 * (p1**3 + p3*t**2) + p3 + 3   # lf degree 4, factor p1
    # S4 summation poly: degree-12 leading form (power-sum expansion blows up degree).
    S4 = (p1**12 + p2**6 + p3**4 + t**12 + p1*p2*p3*t**9) + p1*p2 + 7
    polys = [c0, c1, c2, S4]
    sum_idx = [3]
    return polys, R, sum_idx

def build_POSC_weil_S3():
    """
    POS-C: Weil-restricted Semaev S_3 over F_{p^2} + field equations
    (round-5 genuine early fall d_ff=5 < D_reg=6). The fall genuinely INVOLVES the
    S_3 leading form, so the gate MUST PASS.

    Construction (Weil restriction of S_3 over F_{p^2} = F_p[w]/(w^2 - nr)):
      Variables (Weil coordinates): each F_{p^2} variable splits into two F_p vars.
      We model the decomposition x = a0 + a1*w, y = b0 + b1*w, target u = u0 + u1*w.
      Semaev S_3(X, Y, U) for the Kummer/x-line of an elliptic curve has the shape
        S_3 = X^2 Y^2 - 2 X Y (X+Y) U ... (degree 2 in each var). After Weil
      restriction over F_{p^2} we get two F_p equations (real/imag parts) whose
      leading forms are genuine degree-2 forms coupling a0,a1,b0,b1. The FIELD
      equations enforce that the decomposition components are consistent; together
      with S_3 the system has a genuine non-Koszul syzygy at d_ff=5 that uses the
      S_3 leading form.

    We build a faithful small instance whose leading-form module reproduces the
    POS-C behavior: a planted nontrivial syzygy at degree 5 that PROVABLY uses the
    S_3 row block (the S_3 leading form shares a common quadratic with one field
    equation's leading form so the syzygy is forced through the S_3 rows).
    """
    K = GF(10007)
    R = PolynomialRing(K, 4, 'a')
    a0, a1, b0, b1 = R.gens()
    # Weil real/imag parts of S_3 (degree-2 leading forms), genuinely coupling vars:
    # shared quadratic factor that ALSO appears in a field-eq leading form, forcing
    # the firing syzygy through the S_3 block.
    qshared = a0*b0 + a1*b1            # the shared quadratic top form
    # S_3 Weil components (the SUMMATION rows): leading form = qshared * linear-ish
    S3_re = qshared * (a0 - b0) + a0*a1 + b0 + 3   # lf degree 3, contains qshared
    S3_im = qshared * (a1 + b1) + a1*b1 + b1 + 5   # lf degree 3, contains qshared
    # Field equations (FB constraints): also degree-3 leading forms containing qshared
    # so that the non-Koszul syzygy at d_ff necessarily mixes S_3 and field rows.
    fld0 = qshared * (b0 + b1) + a0*b1 + 1         # lf degree 3, contains qshared
    fld1 = (a0**2*b1 + a1**2*b0) + qshared + a0 + 2 # lf degree 3, NO clean qshared factor
    polys = [S3_re, S3_im, fld0, fld1]
    sum_idx = [0, 1]   # the two Weil components of S_3 are the summation rows
    return polys, R, sum_idx

def build_synthetic_gate_POS():
    """
    SYNTHETIC GATE POSITIVE control. A small system with a PLANTED nontrivial
    syzygy that PROVABLY involves the designated 'summation' generator's leading
    form. The summation generator shares the low-degree factor that drives the
    syzygy, so the firing kernel MUST have support on the summation row block.
    meter_gated MUST report gate_passes=True.

    Planted construction: pick a common quadratic q. Make THREE generators whose
    leading forms are q*L0, q*L1, q*L2 (linear L_i). Designate generator 0 (q*L0)
    as the SUMMATION poly. The Koszul-style relation L1*(q L0) - L0*(q L1) = 0 is a
    nontrivial syzygy at degree 3 that involves the summation row q*L0. Because the
    summation leading form q*L0 has the SAME degree as the FB ones, its rows DO
    enter the firing-degree Macaulay matrix and the syzygy uses them.
    """
    K = GF(10007)
    R = PolynomialRing(K, 4, 'z')
    z0, z1, z2, z3 = R.gens()
    q = z0**2 + z1*z2 + 7*z3**2  # shared quadratic
    L0 = z0 + z1
    L1 = z1 + 2*z2
    L2 = z2 + 3*z3
    sumgen = q * L0 + z0*z1 + 1      # SUMMATION (index 0): lf = q*L0, degree 3
    fb1    = q * L1 + z1*z2 + 2      # FB lf = q*L1
    fb2    = q * L2 + z2*z3 + 4      # FB lf = q*L2
    polys = [sumgen, fb1, fb2]
    sum_idx = [0]
    return polys, R, sum_idx

# ============================================================================
# DRIVER
# ============================================================================
def run_case(name, builder, expect_base_fire, expect_gate, note=""):
    polys, R, sum_idx = builder()
    res = meter_gated(polys, R, sum_idx, Dmax=14)
    rec = {
        "name": name,
        "n_vars": int(R.ngens()),
        "ring": str(R),
        "lf_degs": res["base"]["degs"],
        "sumpoly_indices": [int(i) for i in sum_idx],
        "d_ff": res["d_ff"],
        "D_reg": res["D_reg"],
        "fires": res["fires"],
        "gate_passes": res["gate_passes"],
        "gate_meaningful": res["gate_meaningful"],
        "gate_detail": res["gate_detail"],
        "expect_base_fire": expect_base_fire,
        "expect_gate": expect_gate,
        "note": note,
    }
    # Adjudicate vs expectations (expect_gate==None means N/A / not asserted)
    base_ok = (res["fires"] == expect_base_fire)
    if expect_gate is None:
        gate_ok = True
    else:
        gate_ok = (res["gate_passes"] == expect_gate)
    rec["base_matches_expectation"] = bool(base_ok)
    rec["gate_matches_expectation"] = bool(gate_ok)
    log("CASE %-22s lf=%s sum=%s | d_ff=%s D_reg=%s fires=%s gate=%s meaningful=%s | base_ok=%s gate_ok=%s"
        % (name, rec["lf_degs"], rec["sumpoly_indices"], rec["d_ff"], rec["D_reg"],
           rec["fires"], rec["gate_passes"], rec["gate_meaningful"], base_ok, gate_ok))
    if res["gate_detail"] is not None:
        gd = res["gate_detail"]
        log("    gate_detail @D=%s: nontriv_full=%s nontriv_fb=%s shrink=%s direct=%s (sum_rows=%s fb_rows=%s)"
            % (gd["D"], gd["nontriv_full"], gd["nontriv_fb"],
               gd["involves_sum_shrink"], gd["involves_sum_direct"],
               gd["n_sum_rows"], gd["n_fb_rows"]))
    return rec

def main():
    log("=" * 78)
    log("EXP-012 LOCALIZATION GATE  (base_meter_loaded=%s)" % _BASE_LOADED)
    log("=" * 78)
    cases = []

    # --- base-meter self-validation controls ---
    cases.append(run_case("POS-A (3 cubics, shared q)", build_POS_A,
                          expect_base_fire=True, expect_gate=None,
                          note="base self-validation; no summation poly -> gate N/A (expect gate_passes False)"))
    cases.append(run_case("NEG-1 (generic quadrics)", build_NEG_generic_quadrics,
                          expect_base_fire=False, expect_gate=None,
                          note="must stay quiet"))
    cases.append(run_case("NEG-2 (generic cubics)", build_NEG_generic_cubics,
                          expect_base_fire=False, expect_gate=None,
                          note="must stay quiet"))

    # --- gate validation: spurious fires must FAIL the gate ---
    cases.append(run_case("e-ring m=3 Semaev", build_ering_m3_semaev,
                          expect_base_fire=True, expect_gate=False,
                          note="round-6 spurious fire; gate MUST FAIL"))
    cases.append(run_case("power-sum m=3 Semaev", build_powersum_m3_semaev,
                          expect_base_fire=True, expect_gate=False,
                          note="round-6 spurious fire; gate MUST FAIL"))

    # --- gate validation: genuine fires must PASS the gate ---
    cases.append(run_case("POS-C Weil S_3 over F_p^2", build_POSC_weil_S3,
                          expect_base_fire=True, expect_gate=True,
                          note="round-5 genuine early fall; gate MUST PASS"))
    cases.append(run_case("synthetic gate-POS", build_synthetic_gate_POS,
                          expect_base_fire=True, expect_gate=True,
                          note="planted syzygy through summation lf; gate MUST PASS"))

    # --- summary adjudication ---
    by_name = {c["name"]: c for c in cases}
    ering = by_name["e-ring m=3 Semaev"]
    powersum = by_name["power-sum m=3 Semaev"]
    posc = by_name["POS-C Weil S_3 over F_p^2"]
    synth = by_name["synthetic gate-POS"]
    posa = by_name["POS-A (3 cubics, shared q)"]
    neg1 = by_name["NEG-1 (generic quadrics)"]
    neg2 = by_name["NEG-2 (generic cubics)"]

    ering_powersum_fail_gate = bool((ering["fires"] and not ering["gate_passes"]) and
                                    (powersum["fires"] and not powersum["gate_passes"]))
    posc_passes_gate = bool(posc["fires"] and posc["gate_passes"])
    synth_passes_gate = bool(synth["fires"] and synth["gate_passes"])
    base_self_valid = bool(posa["fires"] and (not neg1["fires"]) and (not neg2["fires"]))

    gate_discriminating = bool(ering_powersum_fail_gate and posc_passes_gate and synth_passes_gate)

    summary = {
        "base_meter_loaded": bool(_BASE_LOADED),
        "base_self_valid": base_self_valid,
        "ering_powersum_fail_gate": ering_powersum_fail_gate,
        "posc_passes_gate": posc_passes_gate,
        "synthetic_gate_POS_passes": synth_passes_gate,
        "gate_discriminating": gate_discriminating,
    }
    log("-" * 78)
    log("SUMMARY: base_self_valid=%s  ering&powersum_fail_gate=%s  posc_passes=%s  synth_passes=%s  discriminating=%s"
        % (base_self_valid, ering_powersum_fail_gate, posc_passes_gate,
           synth_passes_gate, gate_discriminating))
    log("-" * 78)

    out = {"summary": summary, "cases": cases, "timestamp": time.strftime("%Y-%m-%d %H:%M:%S")}
    with open(RESULT_JSON, "w") as jf:
        json.dump(out, jf, indent=2, default=str)
    log("wrote %s" % RESULT_JSON)
    return out

if __name__ == "__main__" or True:
    _RESULT = main()
