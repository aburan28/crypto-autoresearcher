_LOGF = None
def _open_log():
    global _LOGF
    if _LOGF is None or getattr(_LOGF, "closed", True):
        _LOGF = open(LOGPATH, "a")
    return _LOGF

def log(msg):
    f = _open_log()
    line = "[%s] %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg)
    f.write(line + "\n")
    f.flush()
    print(line)

