digraph review {
  graph [rankdir=TB, fontname="Helvetica", labelloc=t, label="Prime63 m=2 output bridge: review procedure", bgcolor="white", pad="0.2", nodesep="0.4", ranksep="0.55"];
  node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#edf3f8", color="#4e6272"];
  edge [fontname="Helvetica", color="#60798b"];
  source [label="Hash-bound v2 source + canned fixtures\n10 paths; source snapshot TASK-fa096d", fillcolor="#e9f5eb"];
  old [label="First Validator review\nTASK-b2e2cd; O1/O2/O3 reported holds\nblind seal before candidate reads", fillcolor="#fff3db"];
  fail1 [label="Procedure failure 1\nbroad lift lacks rationale", fillcolor="#fde8e7", color="#ba4d45"];
  fail2 [label="Procedure failure 2\n6 protected paths in final sources_read\nread after blind seal", fillcolor="#fde8e7", color="#ba4d45"];
  stop [label="Source acceptance withheld\nDEC-20261025-5b84e8", fillcolor="#f8d7d3", color="#ba4d45"];
  b1 [label="Fresh blind B1 Reviewer\nTASK-0cc64e; no candidate/prior-review reads", fillcolor="#e7f0ff"];
  full [label="Fresh full O1/O2/O3 Reviewer\nTASK-cbcdc5; separate session", fillcolor="#e7f0ff"];
  gate [label="Snapshot + pinned checker + Coordinator assessment\nTASK-ab627a", fillcolor="#edf3f8"];
  source -> old; old -> fail1; old -> fail2; fail1 -> stop; fail2 -> stop;
  source -> full [style=dashed, label="future source read"];
  stop -> b1 [style=dashed, label="new plan, no reuse of old verdict"];
  b1 -> full [label="sealed release first; no sibling report read"];
  full -> gate; b1 -> gate;
}
