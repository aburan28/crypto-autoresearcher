digraph P192CMRelationPayoff {
  graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.30", ranksep="0.34", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", color="#24445f", fillcolor="#edf5fb", fontname="DejaVu Sans", fontsize=10, margin="0.12,0.08"];
  edge [color="#52697a", fontname="DejaVu Sans", fontsize=9, arrowsize=0.75];

  tuple [label="Pinned P-192 tuple\np, n, G, t"];
  order [label="Order / CM certificate\nD fundamental; conductor 1"];
  generators [label="13 frozen ideal classes\n3 ramified + 10 split"];
  census [label="Exact L <= 2^48 census\n4,974,348 canonical states"];
  replay [label="Independent form + HNF replay\n103 accepted; 0 rejected"];
  classify [label="103 scalar-ramified\n0 non-scalar", fillcolor="#e8f6ec", color="#2f6f44"];
  map [label="Explicit oriented map / chain\nnot applicable: no non-scalar hit", fillcolor="#fff5dc", color="#936c16"];
  costs [label="HOT/COLD map costs\nunsupported / open", fillcolor="#fff0e8", color="#a35326"];
  payoff [label="Payoff gate\nNOT PASSED", fillcolor="#fdeaea", color="#a33d3d"];
  verdict [label="Achieved status: INCOMPLETE\nExact bounded algebra result only", fillcolor="#f3eefb", color="#674b91"];

  tuple -> order [label="native checks"];
  order -> generators [label="roots + forms"];
  generators -> census [label="no empirical pruning"];
  census -> replay [label="forward / reverse"];
  replay -> classify [label="classification"];
  classify -> map [label="non-scalar candidates = 0"];
  map -> costs;
  costs -> payoff;
  payoff -> verdict;
}
