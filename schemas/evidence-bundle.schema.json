{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "A compact, source-preserving citation suitable for every host transport.",
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{7,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Commit"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceClass"
        }
      },
      "required": [
        "id",
        "source_id",
        "source_type",
        "locator"
      ],
      "title": "Citation",
      "type": "object"
    },
    "EvidenceCoverage": {
      "additionalProperties": false,
      "description": "Deterministic/calibrated coverage by required evidence class, not confidence.",
      "properties": {
        "canonical_prior_art": {
          "maximum": 1,
          "minimum": 0,
          "title": "Canonical Prior Art",
          "type": "number"
        },
        "contradictory_evidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Contradictory Evidence",
          "type": "number"
        },
        "negative_results": {
          "maximum": 1,
          "minimum": 0,
          "title": "Negative Results",
          "type": "number"
        },
        "overall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Overall",
          "type": "number"
        },
        "project_history": {
          "maximum": 1,
          "minimum": 0,
          "title": "Project History",
          "type": "number"
        }
      },
      "required": [
        "overall",
        "canonical_prior_art",
        "project_history",
        "negative_results",
        "contradictory_evidence"
      ],
      "title": "EvidenceCoverage",
      "type": "object"
    },
    "EvidencePassage": {
      "additionalProperties": false,
      "description": "A bounded retrieved passage whose citations are resolved by the bundle.",
      "properties": {
        "citation_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Citation Ids",
          "type": "array"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "text",
        "citation_ids"
      ],
      "title": "EvidencePassage",
      "type": "object"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "description": "How an evidence bundle was obtained, without granting source authority.",
      "properties": {
        "index_manifest_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Manifest Hash"
        },
        "retrieval_adapter": {
          "$ref": "#/$defs/RetrievalAdapter"
        },
        "retrieval_policy_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Retrieval Policy Version",
          "type": "string"
        },
        "source_repository": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Source Repository",
          "type": "string"
        }
      },
      "required": [
        "retrieval_adapter",
        "source_repository",
        "retrieval_policy_version"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "EvidenceStatement": {
      "additionalProperties": false,
      "description": "A compact structured fact, negative result, or unresolved question.",
      "properties": {
        "citation_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Citation Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "EvidenceStatement",
      "type": "object"
    },
    "IndexFreshness": {
      "additionalProperties": false,
      "description": "The source/index freshness decision and any direct-record recovery.",
      "properties": {
        "direct_record_fallback_used": {
          "title": "Direct Record Fallback Used",
          "type": "boolean"
        },
        "direct_record_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Direct Record Ids",
          "type": "array"
        },
        "freshness_note": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness Note"
        },
        "index_at_or_after_source_commit": {
          "title": "Index At Or After Source Commit",
          "type": "boolean"
        }
      },
      "required": [
        "index_at_or_after_source_commit",
        "direct_record_fallback_used"
      ],
      "title": "IndexFreshness",
      "type": "object"
    },
    "RetrievalAdapter": {
      "enum": [
        "local",
        "mcp",
        "direct_record",
        "mixed"
      ],
      "title": "RetrievalAdapter",
      "type": "string"
    },
    "SourceClass": {
      "enum": [
        "ledger",
        "experiment",
        "internal-note",
        "literature",
        "code",
        "other"
      ],
      "title": "SourceClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The immutable, bounded evidence context for planning and shadow routing.",
  "properties": {
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "maxItems": 32,
      "title": "Citations",
      "type": "array"
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "maxItems": 32,
      "title": "Contradictions",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/EvidenceCoverage"
    },
    "freshness": {
      "$ref": "#/$defs/IndexFreshness"
    },
    "frontier_node_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frontier Node Id"
    },
    "goal_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Goal Id",
      "type": "string"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Id",
      "type": "string"
    },
    "index_generation": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Index Generation",
      "type": "string"
    },
    "known_facts": {
      "items": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "maxItems": 32,
      "title": "Known Facts",
      "type": "array"
    },
    "negative_results": {
      "items": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "maxItems": 32,
      "title": "Negative Results",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "maxItems": 32,
      "title": "Open Questions",
      "type": "array"
    },
    "passages": {
      "items": {
        "$ref": "#/$defs/EvidencePassage"
      },
      "maxItems": 8,
      "title": "Passages",
      "type": "array"
    },
    "prior_experiments": {
      "items": {
        "$ref": "#/$defs/EvidenceStatement"
      },
      "maxItems": 32,
      "title": "Prior Experiments",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/EvidenceProvenance"
    },
    "query_plan_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Query Plan Id",
      "type": "string"
    },
    "retrieval_warnings": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Retrieval Warnings",
      "type": "array"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema": {
      "const": "crypto.autoresearch.evidence_bundle.v1",
      "default": "crypto.autoresearch.evidence_bundle.v1",
      "title": "Schema",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{7,64}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "id",
    "goal_id",
    "query_plan_id",
    "source_commit",
    "index_generation",
    "retrieved_at",
    "provenance",
    "coverage",
    "freshness"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
