{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crypto-autoresearch:finite-yaml-execution-plan:v1",
  "type": "object",
  "required": [
    "execution_plan"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_plan": {
      "type": "object",
      "required": [
        "format_version",
        "experiment_id",
        "specification",
        "metric_interpretation_ref",
        "source_snapshot",
        "source_closure",
        "dependency_closure",
        "environment_policy",
        "resource_policy",
        "runs",
        "scientific_execution_authorized",
        "fixture_authorization"
      ],
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 1
        },
        "experiment_id": {
          "type": "string",
          "pattern": "^EXP-[A-Z0-9-]+-(?:[0-9]{3,}|[0-9a-f]{6})$"
        },
        "specification": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "metric_interpretation_ref": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_closure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "dependency_closure": {
          "type": "object"
        },
        "environment_policy": {
          "type": "object",
          "required": [
            "outer",
            "inner",
            "absent_test_keys"
          ],
          "additionalProperties": false,
          "properties": {
            "outer": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "inner": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "absent_test_keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "resource_policy": {
          "type": "object",
          "required": [
            "maximum_workers",
            "descendant_slots",
            "memory_bytes",
            "timeout_seconds",
            "cpu_seconds",
            "effective_uid",
            "descendant_policy"
          ],
          "additionalProperties": false,
          "properties": {
            "maximum_workers": {
              "type": "integer",
              "const": 1
            },
            "descendant_slots": {
              "type": "integer",
              "const": 0
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cpu_seconds": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "effective_uid": {
              "type": "integer",
              "minimum": 1
            },
            "descendant_policy": {
              "type": "string",
              "const": "forbidden-via-rlimit-nproc-zero"
            }
          }
        },
        "runs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "run_id",
              "configuration",
              "run_directory",
              "argv",
              "output_allowlist",
              "role",
              "seed",
              "curve_id"
            ],
            "additionalProperties": false,
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^RUN-ECDLP-[0-9a-f]{6}$"
              },
              "configuration": {
                "type": "object"
              },
              "run_directory": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "minItems": 7,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "output_allowlist": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "role": {
                "type": "string",
                "const": "generator"
              },
              "seed": {
                "type": "integer",
                "const": 0
              },
              "curve_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "scientific_execution_authorized": {
          "type": "boolean",
          "const": false
        },
        "fixture_authorization": {
          "type": "object"
        }
      }
    }
  }
}
