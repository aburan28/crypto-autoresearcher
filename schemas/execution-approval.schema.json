{
  "type": "object",
  "required": ["execution_approval"],
  "additionalProperties": false,
  "properties": {
    "execution_approval": {
      "type": "object",
      "required": ["format_version", "experiment_id", "approved_base_commit", "specification_sha256", "execution_plan_sha256", "protocol_hashes", "python", "resource_policy", "allowed_verifier_transitions"],
      "additionalProperties": false,
      "properties": {
        "format_version": {"const": 1},
        "experiment_id": {"type": "string", "pattern": "EXP-[A-Z0-9-]+-[0-9]{3,}"},
        "approved_base_commit": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "specification_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "execution_plan_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "protocol_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "pattern": ".+"},
              "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
            }
          }
        },
        "python": {
          "type": "object",
          "required": ["executable", "version", "sha256"],
          "additionalProperties": false,
          "properties": {
            "executable": {"type": "string", "pattern": ".+"},
            "version": {"type": "string", "pattern": ".+"},
            "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
          }
        },
        "resource_policy": {
          "type": "object",
          "required": ["descendant_policy", "effective_uid"],
          "additionalProperties": false,
          "properties": {
            "descendant_policy": {"const": "forbidden-via-rlimit-nproc-zero"},
            "effective_uid": {"type": "integer", "minimum": 1}
          }
        },
        "allowed_verifier_transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["verifier_run_id", "predecessor_run_id", "artifact", "commit_policy"],
            "additionalProperties": false,
            "properties": {
              "verifier_run_id": {"type": "string", "pattern": "RUN-[A-Z0-9-]+-[0-9]{3,}"},
              "predecessor_run_id": {"type": "string", "pattern": "RUN-[A-Z0-9-]+-[0-9]{3,}"},
              "artifact": {"const": "raw-result.json"},
              "commit_policy": {"const": "base-plus-committed-predecessor-run-only"}
            }
          }
        }
      }
    }
  }
}
