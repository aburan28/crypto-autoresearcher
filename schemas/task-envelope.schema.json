{
  "$defs": {
    "AgentRole": {
      "enum": [
        "coordinator",
        "idea-generator",
        "executor",
        "reviewer",
        "validator",
        "red-team",
        "theory-agent",
        "benchmark-agent"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "HandoffReference": {
      "additionalProperties": false,
      "description": "Immutable reference to an existing handoff rather than a replacement.",
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{7,64}$",
          "title": "Source Commit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_commit",
        "content_hash"
      ],
      "title": "HandoffReference",
      "type": "object"
    },
    "KnowledgeContract": {
      "additionalProperties": false,
      "description": "The required evidence binding for a single bounded task attempt.",
      "properties": {
        "evidence_bundle_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Bundle Hash",
          "type": "string"
        },
        "evidence_bundle_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Evidence Bundle Id",
          "type": "string"
        },
        "minimum_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Coverage",
          "type": "number"
        },
        "query_plan_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Query Plan Id",
          "type": "string"
        },
        "required_source_classes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Required Source Classes",
          "type": "array"
        }
      },
      "required": [
        "query_plan_id",
        "evidence_bundle_id",
        "evidence_bundle_hash",
        "minimum_coverage",
        "required_source_classes"
      ],
      "title": "KnowledgeContract",
      "type": "object"
    },
    "RoutingContract": {
      "additionalProperties": false,
      "description": "The shadow/advisory route binding carried by a task envelope.",
      "properties": {
        "cheap_first_allowed": {
          "title": "Cheap First Allowed",
          "type": "boolean"
        },
        "minimum_policy": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Minimum Policy",
          "type": "string"
        },
        "route_decision_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Route Decision Hash",
          "type": "string"
        },
        "route_decision_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Route Decision Id",
          "type": "string"
        },
        "route_is_advisory": {
          "const": true,
          "default": true,
          "title": "Route Is Advisory",
          "type": "boolean"
        }
      },
      "required": [
        "route_decision_id",
        "route_decision_hash",
        "minimum_policy",
        "cheap_first_allowed"
      ],
      "title": "RoutingContract",
      "type": "object"
    },
    "SuccessorContract": {
      "additionalProperties": false,
      "description": "Requested follow-up proposals; it grants no ability to admit or dispatch them.",
      "properties": {
        "campaign_terminal_authority": {
          "const": false,
          "default": false,
          "title": "Campaign Terminal Authority",
          "type": "boolean"
        },
        "minimum_distinct_proposals": {
          "maximum": 64,
          "minimum": 0,
          "title": "Minimum Distinct Proposals",
          "type": "integer"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "required_classes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Required Classes",
          "type": "array"
        }
      },
      "required": [
        "required",
        "minimum_distinct_proposals"
      ],
      "title": "SuccessorContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A hash-bound extension around a legacy handoff for one task, not a campaign.",
  "properties": {
    "campaign_state": {
      "const": "unchanged",
      "default": "unchanged",
      "title": "Campaign State",
      "type": "string"
    },
    "campaign_transition_authority": {
      "const": "none",
      "default": "none",
      "title": "Campaign Transition Authority",
      "type": "string"
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "frontier_node_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Frontier Node Id",
      "type": "string"
    },
    "goal_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Goal Id",
      "type": "string"
    },
    "handoff": {
      "$ref": "#/$defs/HandoffReference"
    },
    "knowledge_contract": {
      "$ref": "#/$defs/KnowledgeContract"
    },
    "role": {
      "$ref": "#/$defs/AgentRole"
    },
    "routing_contract": {
      "$ref": "#/$defs/RoutingContract"
    },
    "schema": {
      "const": "crypto.autoresearch.task_envelope.v1",
      "default": "crypto.autoresearch.task_envelope.v1",
      "title": "Schema",
      "type": "string"
    },
    "successor_contract": {
      "$ref": "#/$defs/SuccessorContract"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "task_type": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "frontier_node_id",
    "goal_id",
    "role",
    "task_type",
    "handoff",
    "knowledge_contract",
    "routing_contract",
    "successor_contract"
  ],
  "title": "TaskEnvelope",
  "type": "object"
}
