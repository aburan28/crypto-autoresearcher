{
  "type": "object",
  "required": ["research_question"],
  "additionalProperties": false,
  "properties": {
    "research_question": {
      "type": "object",
      "required": ["id", "title", "scope", "motivation", "decision_target", "constraints", "status", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "RQ-[A-Z0-9-]+-[0-9]{3,}"},
        "title": {"type": "string"},
        "scope": {
          "type": "object",
          "required": ["curve_families", "field_types", "bit_sizes", "methods"],
          "additionalProperties": false,
          "properties": {
            "curve_families": {"type": "array", "items": {"type": "string"}},
            "field_types": {"type": "array", "items": {"type": "string"}},
            "bit_sizes": {"type": "array", "items": {"type": "integer", "minimum": 2}},
            "methods": {"type": "array", "items": {"type": "string"}}
          }
        },
        "motivation": {"type": "string"},
        "decision_target": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["active", "paused", "closed"]},
        "owner": {"type": "string"}
      }
    }
  }
}
