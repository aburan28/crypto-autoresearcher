{
  "type": "object",
  "required": ["run"],
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "object",
      "required": ["id", "experiment_id", "status", "code", "environment", "inputs", "timing", "resources", "result", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "RUN-[A-Z0-9-]+-[0-9]{3,}"},
        "experiment_id": {"type": "string", "pattern": "EXP-[A-Z0-9-]+-[0-9]{3,}"},
        "status": {"type": "string", "enum": ["completed_valid", "completed_invalid", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget"]},
        "code": {
          "type": "object",
          "required": ["commit", "dirty", "command"],
          "additionalProperties": false,
          "properties": {
            "commit": {"type": "string", "pattern": "[0-9a-f]{40}"},
            "dirty": {"type": "boolean"},
            "command": {"type": "string"}
          }
        },
        "environment": {"type": "object"},
        "inputs": {
          "type": "object",
          "required": ["curve_id", "seed", "parameters"],
          "additionalProperties": false,
          "properties": {
            "curve_id": {"type": ["string", "null"]},
            "seed": {"type": "integer"},
            "parameters": {"type": "object"}
          }
        },
        "timing": {
          "type": "object",
          "required": ["started_at", "finished_at", "wall_seconds"],
          "additionalProperties": false,
          "properties": {
            "started_at": {"type": "string"},
            "finished_at": {"type": "string"},
            "wall_seconds": {"type": "number", "minimum": 0}
          }
        },
        "resources": {
          "type": "object",
          "required": ["peak_rss_bytes", "cpu_seconds"],
          "additionalProperties": false,
          "properties": {
            "peak_rss_bytes": {"type": "integer", "minimum": 0},
            "cpu_seconds": {"type": "number", "minimum": 0}
          }
        },
        "result": {
          "type": "object",
          "required": ["metrics", "valid", "invalid_reason"],
          "additionalProperties": false,
          "properties": {
            "metrics": {"type": "object"},
            "valid": {"type": "boolean"},
            "invalid_reason": {"type": ["string", "null"]}
          }
        },
        "artifacts": {"type": "object"}
      }
    }
  }
}
