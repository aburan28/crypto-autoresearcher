{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "A bounded immutable artifact reference produced or reviewed by an attempt.",
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "AttemptStopReason": {
      "enum": [
        "completed",
        "wall_clock_budget_exhausted",
        "maximum_runs_exhausted",
        "tool_denied",
        "model_error",
        "invalid_output",
        "cancelled"
      ],
      "title": "AttemptStopReason",
      "type": "string"
    },
    "AttemptTerminalStatus": {
      "enum": [
        "completed",
        "budget_exhausted",
        "tool_denied",
        "model_error",
        "invalid_output",
        "cancelled"
      ],
      "title": "AttemptTerminalStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Observations from one terminal worker attempt, never a campaign result.",
  "properties": {
    "anomalies": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Anomalies",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 64,
      "title": "Artifacts",
      "type": "array"
    },
    "attempt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_terminal": {
      "const": true,
      "default": true,
      "title": "Attempt Terminal",
      "type": "boolean"
    },
    "campaign_state": {
      "const": "unchanged",
      "default": "unchanged",
      "title": "Campaign State",
      "type": "string"
    },
    "campaign_terminal": {
      "const": false,
      "default": false,
      "title": "Campaign Terminal",
      "type": "boolean"
    },
    "campaign_transition_authority": {
      "const": "none",
      "default": "none",
      "title": "Campaign Transition Authority",
      "type": "string"
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "inference_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limitations": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Limitations",
      "type": "array"
    },
    "observations": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Observations",
      "type": "array"
    },
    "schema": {
      "const": "crypto.autoresearch.task_result.v1",
      "default": "crypto.autoresearch.task_result.v1",
      "title": "Schema",
      "type": "string"
    },
    "stop_reason": {
      "$ref": "#/$defs/AttemptStopReason"
    },
    "suggested_followups": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Suggested Followups",
      "type": "array"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "worker_status": {
      "$ref": "#/$defs/AttemptTerminalStatus"
    }
  },
  "required": [
    "task_id",
    "attempt_id",
    "worker_status",
    "stop_reason"
  ],
  "title": "TaskResult",
  "type": "object"
}
