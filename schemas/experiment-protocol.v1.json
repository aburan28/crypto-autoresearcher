{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment.protocol/v1",
  "title": "Experiment protocol v1",
  "description": "One preregistered, frozen protocol per experiment, the same shape in every repository of the owner (crypto, crypto-autoresearcher, cryptanalysis, ml-cryptanalysis, cryptanalysis-rl). docs/experiment-protocol.md states the rules; tools/experiment_protocol.py validates, freezes, derives seeds and checks the export against it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_id",
    "version",
    "created",
    "repository",
    "question",
    "claims",
    "arms",
    "controls",
    "variable_ledger",
    "randomization",
    "sample_size",
    "metrics",
    "measurement",
    "execution",
    "stopping_rules",
    "decision_rule",
    "analysis_plan",
    "inadmissible",
    "amendments",
    "freeze"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "enum": [
        "recalled",
        "retrieved",
        "kb",
        "internal"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "unit",
        "kind",
        "definition",
        "source",
        "aggregation",
        "uncertainty"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "unit": {
          "$ref": "#/$defs/nonempty"
        },
        "kind": {
          "enum": [
            "counted",
            "timed",
            "derived",
            "exact",
            "rate"
          ],
          "description": "counted: an operation or event count the instrument emits (survives hardware). timed: a clock. derived: computed from other metrics by a stated formula. exact: a deterministic value with no sampling noise. rate: successes over a stated denominator."
        },
        "definition": {
          "$ref": "#/$defs/nonempty",
          "description": "What is counted or timed, from which event to which event, and what is excluded."
        },
        "source": {
          "$ref": "#/$defs/nonempty",
          "description": "The counter, file field or JSON pointer the value is read from."
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "aggregation": {
          "enum": [
            "per_row",
            "median",
            "mean",
            "min",
            "max",
            "sum",
            "rank",
            "distribution",
            "paired_ratio"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ],
          "description": "The smallest difference the instrument can resolve, in the metric's unit."
        },
        "uncertainty": {
          "enum": [
            "paired_bootstrap_ci95",
            "bootstrap_ci95",
            "clopper_pearson_ci95",
            "stdev",
            "range",
            "none_exact"
          ]
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "arms",
        "differs_in",
        "design"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "arms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "differs_in": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "design": {
          "enum": [
            "one_factor",
            "factorial",
            "absolute",
            "aa",
            "confounded"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "threshold": {
          "type": [
            "string",
            "null"
          ],
          "description": "For absolute: the stated threshold the arm is read against."
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "experiment.protocol/v1"
    },
    "protocol_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created": {
      "$ref": "#/$defs/date"
    },
    "repository": {
      "enum": [
        "crypto",
        "crypto-autoresearcher",
        "cryptanalysis",
        "ml-cryptanalysis",
        "cryptanalysis-rl",
        "other"
      ]
    },
    "study_dir": {
      "type": [
        "string",
        "null"
      ],
      "description": "Repository-relative directory the protocol, export and reviews live in."
    },
    "authors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      },
      "description": "Roles, lanes or people; never email addresses."
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "array",
          "null"
        ]
      },
      "description": "experiment_id, hypothesis_ids, goal_id, backlog_card, prs, spec paths: pointers into the owning repository's records."
    },
    "question": {
      "type": "string",
      "minLength": 10
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "class",
          "decided_by"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/nonempty"
          },
          "class": {
            "enum": [
              "theorem",
              "exact_computation",
              "comparative",
              "heuristic_estimate",
              "out_of_scope"
            ]
          },
          "decided_by": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Comparison ids whose outcome licenses or refutes the claim. Required non-empty for class comparative."
          },
          "if_supported": {
            "type": [
              "string",
              "null"
            ]
          },
          "if_not_supported": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "predictions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "statement": {
            "$ref": "#/$defs/nonempty"
          },
          "mechanism": {
            "type": [
              "string",
              "null"
            ]
          },
          "predictions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "metric",
                "direction",
                "minimum_effect",
                "provenance"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "metric": {
                  "$ref": "#/$defs/id"
                },
                "direction": {
                  "enum": [
                    "higher",
                    "lower",
                    "different",
                    "equal_within"
                  ]
                },
                "minimum_effect": {
                  "$ref": "#/$defs/nonempty"
                },
                "provenance": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "written_at",
                    "data_seen",
                    "sample_status"
                  ],
                  "properties": {
                    "written_at": {
                      "$ref": "#/$defs/date"
                    },
                    "first_recorded_in": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "data_seen": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "measured"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "measured": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "sample_status": {
                      "enum": [
                        "out_of_sample",
                        "partially_in_sample",
                        "in_sample"
                      ]
                    },
                    "decisive_scope": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "role": {
                  "enum": [
                    "decisive",
                    "calibration"
                  ],
                  "description": "decisive: may carry a criterion (out-of-sample only). calibration: reported, may invalidate the instrument, never supports the hypothesis (every in-sample prediction)."
                }
              }
            }
          }
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "description",
          "instrument"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "enum": [
              "reference",
              "baseline",
              "candidate",
              "control_aa",
              "control_positive",
              "control_negative"
            ]
          },
          "description": {
            "$ref": "#/$defs/nonempty"
          },
          "instrument": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "commit",
              "build",
              "binary_sha256",
              "threads"
            ],
            "properties": {
              "repo": {
                "$ref": "#/$defs/nonempty"
              },
              "commit": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/commit"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "build": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/argv"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "binary_sha256": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "flags": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "threads": {
                "type": "integer",
                "minimum": 1
              },
              "image_digest": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "parameters": {
            "type": "object"
          },
          "same_instrument_as": {
            "type": [
              "string",
              "null"
            ],
            "description": "Arm id this arm must share code, build and budgets with (the same-instrument rule)."
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aa",
        "positive",
        "negative"
      ],
      "properties": {
        "aa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "comparison",
            "not_applicable_reason"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "comparison": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "not_applicable_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "positive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "arm",
            "expected_detection",
            "not_applicable_reason"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "arm": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expected_detection": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the instrument must report on the planted input, stated so that a miss is unambiguous."
            },
            "not_applicable_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "negative": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "arm",
            "null_population",
            "not_applicable_reason"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "arm": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "null_population": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "description",
                    "generator",
                    "n",
                    "why_n",
                    "matched_on"
                  ],
                  "properties": {
                    "description": {
                      "$ref": "#/$defs/nonempty"
                    },
                    "generator": {
                      "$ref": "#/$defs/nonempty"
                    },
                    "n": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "why_n": {
                      "$ref": "#/$defs/nonempty"
                    },
                    "matched_on": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/nonempty"
                      },
                      "description": "Every property matched between target and null except the one under test."
                    }
                  }
                }
              ]
            },
            "not_applicable_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "variable_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent",
        "factors",
        "comparisons",
        "crosses_map"
      ],
      "properties": {
        "independent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "levels"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/nonempty"
              },
              "levels": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "treatment",
              "how"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/nonempty"
              },
              "treatment": {
                "enum": [
                  "fixed",
                  "randomized",
                  "crossed",
                  "measured"
                ]
              },
              "value": {},
              "how": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "aa_not_applicable": {
          "type": [
            "string",
            "null"
          ]
        },
        "crosses_map": {
          "type": "boolean"
        },
        "transfer_obligations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_order",
        "seed_derivation",
        "instance_sampling",
        "blinding"
      ],
      "properties": {
        "arm_order": {
          "enum": [
            "interleaved",
            "randomized",
            "fixed"
          ]
        },
        "arm_order_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed_derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "protocol_hash_sha256",
                "explicit_list",
                "external_nonce",
                "harness_drawn"
              ],
              "description": "protocol_hash_sha256: seed = first 8 bytes of sha256(protocol_sha256 \\n arm \\n instance \\n replicate), big-endian. explicit_list: the seeds below, chosen before any data. external_nonce: a nonce drawn after the freeze and recorded in the export. harness_drawn: the backend derives every seed by its own frozen rule from a seed in the frozen spec (ecbench measurement.seed, csd.lab plan seed); 'note' names the rule and the export records each row's seed."
            },
            "seeds": {
              "type": "array",
              "items": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "nonce": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "instance_sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "independent_of_arm"
          ],
          "properties": {
            "rule": {
              "$ref": "#/$defs/nonempty"
            },
            "independent_of_arm": {
              "const": true
            }
          }
        },
        "blinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_labels_masked",
            "how"
          ],
          "properties": {
            "analysis_labels_masked": {
              "type": "boolean"
            },
            "how": {
              "$ref": "#/$defs/nonempty"
            },
            "unmasked_at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "sample_size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances",
        "replicates",
        "power",
        "preflight_runtime"
      ],
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1,
          "description": "Independent instances (workloads, targets, curves) per arm."
        },
        "replicates": {
          "type": "integer",
          "minimum": 1,
          "description": "Measured repeats per instance per arm, warmups excluded."
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "alpha",
            "tests_in_family",
            "correction",
            "passes",
            "note"
          ],
          "properties": {
            "method": {
              "enum": [
                "rank_test",
                "paired_bootstrap",
                "exact",
                "other"
              ]
            },
            "alpha": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "tests_in_family": {
              "type": "integer",
              "minimum": 1
            },
            "correction": {
              "enum": [
                "bonferroni",
                "holm",
                "none",
                "other"
              ]
            },
            "rank_test_n": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Null-population size N of the empirical rank test; the smallest attainable two-sided p is 2/(N+1)."
            },
            "min_attainable_two_sided_p": {
              "type": [
                "number",
                "null"
              ]
            },
            "passes": {
              "type": "boolean"
            },
            "note": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "preflight_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixed_seconds",
            "per_sample_seconds",
            "threads",
            "estimated_total_seconds",
            "measured_on"
          ],
          "properties": {
            "fixed_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "per_sample_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "threads": {
              "type": "integer",
              "minimum": 1
            },
            "estimated_total_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "measured_on": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolation_required",
        "warmups",
        "order",
        "record",
        "timed_primary_justification"
      ],
      "properties": {
        "isolation_required": {
          "enum": [
            "none",
            "L0",
            "L1",
            "L2",
            "L3",
            "tierA",
            "tierB",
            "tierC",
            "tierD"
          ],
          "description": "ecbench levels L0-L3 or isolab tiers A-D; none when no clock is a metric."
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "order": {
          "enum": [
            "alternate",
            "randomized",
            "sequential"
          ]
        },
        "clock": {
          "enum": [
            "monotonic",
            "cputime",
            "counted",
            "perf",
            "none"
          ]
        },
        "counters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "record": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "description": "Host and run facts every row must carry (cpu model, kernel, governor, threads, binary sha256, isolation tier, steal, PSI, ...)."
        },
        "timed_primary_justification": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required when a primary metric is timed: why a count will not do, and the isolation that makes the clock evidence."
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "timeout_seconds",
        "checkpoint",
        "retries"
      ],
      "properties": {
        "backend": {
          "enum": [
            "local",
            "taskq",
            "isolab",
            "isolab-k8s",
            "spotlab",
            "spot-system",
            "ephemeral",
            "modal",
            "runpod",
            "cairn",
            "slurm",
            "manual",
            "mixed"
          ]
        },
        "queue": {
          "type": [
            "string",
            "null"
          ]
        },
        "placement": {
          "type": "object"
        },
        "measurement_class": {
          "enum": [
            "measurement",
            "throughput",
            "search",
            "training"
          ],
          "description": "measurement: a clock or counter is a metric, so the job needs an isolated host. throughput/search/training: finish cheaply, any host, checkpointed."
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "interval_seconds",
            "grace_seconds",
            "restore_validation",
            "after_restore"
          ],
          "properties": {
            "policy": {
              "enum": [
                "none",
                "application",
                "criu"
              ]
            },
            "interval_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "grace_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "restore_validation": {
              "enum": [
                "none",
                "manifest_sha256",
                "application_managed",
                "criu_selfcheck"
              ]
            },
            "after_restore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "wall_time",
                "counted_units"
              ],
              "properties": {
                "wall_time": {
                  "const": "invalid"
                },
                "counted_units": {
                  "const": "valid"
                }
              }
            }
          }
        },
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "infrastructure_only",
            "max_attempts"
          ],
          "properties": {
            "infrastructure_only": {
              "const": true
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      }
    },
    "stopping_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "kind",
          "preregistered"
        ],
        "properties": {
          "rule": {
            "$ref": "#/$defs/nonempty"
          },
          "kind": {
            "enum": [
              "fixed_n",
              "preregistered_sequential",
              "budget",
              "invalidation"
            ]
          },
          "preregistered": {
            "const": true
          }
        }
      }
    },
    "invalidation_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "decision_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "comparison_ids",
        "statistic",
        "interval",
        "multiple_comparison_correction",
        "effect_size_measure",
        "verdict_vocabulary"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/nonempty"
        },
        "comparison_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "threshold": {
          "type": [
            "string",
            "null"
          ]
        },
        "statistic": {
          "$ref": "#/$defs/nonempty"
        },
        "interval": {
          "$ref": "#/$defs/nonempty"
        },
        "multiple_comparison_correction": {
          "enum": [
            "bonferroni",
            "holm",
            "none",
            "other"
          ]
        },
        "effect_size_measure": {
          "$ref": "#/$defs/nonempty"
        },
        "verdict_vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "blinded",
        "frozen_before_data"
      ],
      "properties": {
        "script": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/nonempty"
                },
                "sha256": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/sha256"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blinded": {
          "type": "boolean"
        },
        "frozen_before_data": {
          "type": "boolean"
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export_schema": {
          "const": "experiment.export/v1"
        },
        "review_schema": {
          "const": "experiment.review/v1"
        },
        "graphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "report_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inadmissible": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "literature": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "provenance",
          "claim"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/nonempty"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "claim": {
            "$ref": "#/$defs/nonempty"
          },
          "verified_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "filed",
          "filed_before_affected_data",
          "reason",
          "changes"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "filed": {
            "$ref": "#/$defs/date"
          },
          "filed_before_affected_data": {
            "type": "boolean"
          },
          "reason": {
            "$ref": "#/$defs/nonempty"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/nonempty"
            }
          },
          "supersedes_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "protocol_sha256",
        "commit",
        "frozen_at",
        "filed_before_affected_data"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "frozen"
          ]
        },
        "protocol_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "sha256 of the canonical JSON (sorted keys, no whitespace) of this document without the freeze block."
        },
        "commit": {
          "oneOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "frozen_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "filed_before_affected_data": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Repository-specific fields (an ecbench spec path, a csd.lab config, a Verifiers taskset). Never a place for a field this schema already has."
    }
  }
}
