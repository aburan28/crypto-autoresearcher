{
  "type": "object",
  "required": ["coordinator_decision"],
  "additionalProperties": false,
  "properties": {
    "coordinator_decision": {
      "type": "object",
      "required": ["id", "context", "decision", "target_ids", "rationale", "evidence_refs", "limitations", "next_actions", "decided_by", "decided_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "DEC-[A-Z0-9-]+-[0-9]{3,}"},
        "context": {"type": "string"},
        "decision": {"type": "string", "enum": ["approve", "revise", "replicate", "expand", "support", "weaken", "reject_scoped", "pause", "supersede", "inconclusive"]},
        "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rationale": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "decided_by": {"type": "string"},
        "decided_at": {"type": "string"}
      }
    }
  }
}
