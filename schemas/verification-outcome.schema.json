{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "A bounded immutable artifact reference produced or reviewed by an attempt.",
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "BaselineComparison": {
      "enum": [
        "no_improvement",
        "improvement_observed",
        "regression_observed",
        "not_applicable",
        "unavailable"
      ],
      "title": "BaselineComparison",
      "type": "string"
    },
    "ClaimInterpretation": {
      "description": "A verifier's limited interpretation, never a ledger state transition.",
      "enum": [
        "inconclusive",
        "observation_only",
        "baseline_not_improved",
        "contradiction_requires_review"
      ],
      "title": "ClaimInterpretation",
      "type": "string"
    },
    "VerificationFailureClass": {
      "enum": [
        "receipt_invalid",
        "schema_failure",
        "verifier_failure",
        "control_failure",
        "infrastructure_failure",
        "evidence_insufficient"
      ],
      "title": "VerificationFailureClass",
      "type": "string"
    },
    "VerificationVerdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "invalid"
      ],
      "title": "VerificationVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Verifier output for one task attempt; Coordinator review remains separate.",
  "properties": {
    "attempt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Attempt Id",
      "type": "string"
    },
    "baseline_comparison": {
      "$ref": "#/$defs/BaselineComparison"
    },
    "campaign_state": {
      "const": "unchanged",
      "default": "unchanged",
      "title": "Campaign State",
      "type": "string"
    },
    "campaign_terminal": {
      "const": false,
      "default": false,
      "title": "Campaign Terminal",
      "type": "boolean"
    },
    "campaign_transition_authority": {
      "const": "none",
      "default": "none",
      "title": "Campaign Transition Authority",
      "type": "string"
    },
    "claim_interpretation": {
      "$ref": "#/$defs/ClaimInterpretation"
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationFailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "receipt_valid": {
      "title": "Receipt Valid",
      "type": "boolean"
    },
    "required_escalation": {
      "title": "Required Escalation",
      "type": "boolean"
    },
    "review_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 32,
      "title": "Review Artifacts",
      "type": "array"
    },
    "schema": {
      "const": "crypto.autoresearch.verification_outcome.v1",
      "default": "crypto.autoresearch.verification_outcome.v1",
      "title": "Schema",
      "type": "string"
    },
    "successor_constraints": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Successor Constraints",
      "type": "array"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "task_result_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Task Result Hash",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/VerificationVerdict"
    }
  },
  "required": [
    "task_id",
    "attempt_id",
    "task_result_hash",
    "verdict",
    "receipt_valid",
    "claim_interpretation",
    "baseline_comparison",
    "required_escalation"
  ],
  "title": "VerificationOutcome",
  "type": "object"
}
