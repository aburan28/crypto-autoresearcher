{
  "type": "object",
  "required": ["finite_yaml_lock"],
  "additionalProperties": false,
  "properties": {
    "finite_yaml_lock": {
      "type": "object",
      "required": [
        "format_version",
        "experiment_id",
        "run_id",
        "specification",
        "metric_interpretation_ref",
        "run_directory",
        "argv",
        "output_allowlist",
        "source_closure",
        "executable",
        "environment_allowlist",
        "resource_policy",
        "launch_authority_ref",
        "native_launch_receipt",
        "scientific_execution_authorized",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "format_version": {"const": 1},
        "experiment_id": {
          "type": "string",
          "pattern": "^EXP-[A-Z0-9]+-([0-9]{3,}|[0-9a-f]{6})$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^RUN-[A-Z0-9]+-([0-9]{3,}|[0-9a-f]{6})$"
        },
        "specification": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "pattern": ".+"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "metric_interpretation_ref": {
          "type": ["object", "null"],
          "required": ["decision_id", "path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "decision_id": {"type": "string", "pattern": "^DEC-[0-9]{8}-[0-9a-f]{6}$"},
            "path": {"type": "string", "pattern": ".+"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "run_directory": {"type": "string", "pattern": ".+"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": ".+"}
        },
        "output_allowlist": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": ".+"}
        },
        "source_closure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "pattern": ".+"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "executable": {
          "type": "object",
          "required": ["path", "sha256", "version"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "pattern": ".+"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "version": {"type": "string", "pattern": ".+"}
          }
        },
        "environment_allowlist": {
          "type": "array",
          "items": {"type": "string", "pattern": ".+"}
        },
        "resource_policy": {
          "type": "object",
          "required": ["descendant_policy", "effective_uid", "memory_bytes", "timeout_seconds", "maximum_workers"],
          "additionalProperties": false,
          "properties": {
            "descendant_policy": {"const": "forbidden-via-rlimit-nproc-zero"},
            "effective_uid": {"type": "integer", "minimum": 1},
            "memory_bytes": {"type": "integer", "minimum": 1},
            "timeout_seconds": {"type": "number", "minimum": 0},
            "maximum_workers": {"const": 1}
          }
        },
        "launch_authority_ref": {
          "type": "object",
          "required": ["task_id", "owner", "epoch", "branch", "session", "acquired_at", "expires_at"],
          "additionalProperties": false,
          "properties": {
            "task_id": {"type": "string", "pattern": "^TASK-[0-9]{8}-[0-9a-f]{6}$"},
            "owner": {"type": "string", "pattern": ".+"},
            "epoch": {"type": "integer", "minimum": 1},
            "branch": {"type": ["string", "null"]},
            "session": {"type": ["string", "null"]},
            "acquired_at": {"type": "string", "pattern": ".+"},
            "expires_at": {"type": "string", "pattern": ".+"}
          }
        },
        "native_launch_receipt": {
          "type": "object",
          "required": [
            "requested_policy",
            "resolved_model_id",
            "provider",
            "reasoning_effort",
            "session_id",
            "model_verified",
            "adapter_probe_performed",
            "fallback_used",
            "degraded_allowed"
          ],
          "additionalProperties": false,
          "properties": {
            "requested_policy": {"type": ["string", "null"]},
            "resolved_model_id": {"type": ["string", "null"]},
            "provider": {"type": ["string", "null"]},
            "reasoning_effort": {"type": ["string", "null"]},
            "session_id": {"type": ["string", "null"]},
            "model_verified": {"type": "boolean"},
            "adapter_probe_performed": {"type": "boolean"},
            "fallback_used": {"type": "boolean"},
            "degraded_allowed": {"type": "boolean"}
          }
        },
        "scientific_execution_authorized": {"const": false},
        "created_at": {"type": "string", "pattern": ".+"}
      }
    }
  }
}
