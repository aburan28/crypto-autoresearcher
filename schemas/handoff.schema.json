{
  "type": "object",
  "required": ["handoff"],
  "additionalProperties": false,
  "properties": {
    "handoff": {
      "type": "object",
      "required": ["id", "from", "to", "objective", "uncertainty_reduced", "inputs", "constraints", "deliverables", "budget", "completion_gate", "return_format"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "TASK-[A-Z0-9-]+-[0-9]{3,}"},
        "from": {"type": "string"},
        "to": {"type": "string", "enum": ["idea-generator", "executor", "coordinator", "red-team", "theory-agent", "benchmark-agent"]},
        "objective": {"type": "string"},
        "uncertainty_reduced": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "budget": {
          "type": "object",
          "required": ["wall_clock_seconds", "memory_gb", "maximum_runs"],
          "additionalProperties": false,
          "properties": {
            "wall_clock_seconds": {"type": "number", "minimum": 0},
            "memory_gb": {"type": "number", "minimum": 0},
            "maximum_runs": {"type": "integer", "minimum": 1}
          }
        },
        "completion_gate": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "return_format": {"type": "string"}
      }
    }
  }
}
