{
  "type": "object",
  "required": ["experiment"],
  "additionalProperties": false,
  "properties": {
    "experiment": {
      "type": "object",
      "required": ["id", "hypothesis_id", "version", "title", "status", "objective", "inputs", "controls", "independent_variables", "metrics", "replication", "budget", "stopping_rules", "invalidation_rules", "success_criterion", "falsification_criterion", "required_artifacts", "assigned_to", "approved_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "EXP-[A-Z0-9-]+-[0-9]{3,}"},
        "hypothesis_id": {"type": "string", "pattern": "H-[A-Z0-9-]+-[0-9]{3,}"},
        "version": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "review_required", "approved", "running", "completed", "amended", "cancelled"]},
        "objective": {"type": "string"},
        "inputs": {"type": "object"},
        "controls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "independent_variables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "metrics": {
          "type": "object",
          "required": ["primary", "secondary"],
          "additionalProperties": false,
          "properties": {
            "primary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "secondary": {"type": "array", "items": {"type": "string"}}
          }
        },
        "replication": {
          "type": "object",
          "required": ["seeds", "independent_instances"],
          "additionalProperties": false,
          "properties": {
            "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
            "independent_instances": {"type": "integer", "minimum": 1}
          }
        },
        "budget": {
          "type": "object",
          "required": ["wall_clock_seconds_per_run", "total_cpu_hours", "maximum_memory_gb", "maximum_runs"],
          "additionalProperties": false,
          "properties": {
            "wall_clock_seconds_per_run": {"type": "number", "minimum": 0},
            "total_cpu_hours": {"type": "number", "minimum": 0},
            "maximum_memory_gb": {"type": "number", "minimum": 0},
            "maximum_runs": {"type": "integer", "minimum": 0}
          }
        },
        "execution_plan": {
          "type": "object",
          "required": ["allow_dirty", "protocol_hashes", "runs"],
          "additionalProperties": false,
          "properties": {
            "allow_dirty": {"const": false},
            "protocol_hashes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path", "sha256"],
                "additionalProperties": false,
                "properties": {
                  "path": {"type": "string", "pattern": ".+"},
                  "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
                }
              }
            },
            "runs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["run_id", "role", "argv", "seed", "curve_id", "parameters", "timeout_seconds", "predecessor"],
                "additionalProperties": false,
                "properties": {
                  "run_id": {"type": "string", "pattern": "RUN-[A-Z0-9-]+-[0-9]{3,}"},
                  "role": {"type": "string", "enum": ["generator", "verifier"]},
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string"}
                  },
                  "seed": {"type": "integer"},
                  "curve_id": {"type": ["string", "null"]},
                  "parameters": {"type": "object"},
                  "timeout_seconds": {"type": "number", "minimum": 0},
                  "predecessor": {
                    "type": ["object", "null"],
                    "required": ["run_id", "artifact"],
                    "additionalProperties": false,
                    "properties": {
                      "run_id": {"type": "string", "pattern": "RUN-[A-Z0-9-]+-[0-9]{3,}"},
                      "artifact": {"type": "string", "enum": ["raw-result.json"]}
                    }
                  }
                }
              }
            }
          }
        },
        "stopping_rules": {"type": "array", "items": {"type": "string"}},
        "invalidation_rules": {"type": "array", "items": {"type": "string"}},
        "success_criterion": {"type": "string"},
        "falsification_criterion": {"type": "string"},
        "required_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "assigned_to": {"type": "string"},
        "approved_by": {"type": ["string", "null"]}
      }
    }
  }
}
