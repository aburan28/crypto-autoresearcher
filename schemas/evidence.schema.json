{
  "type": "object",
  "required": ["evidence"],
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "type": "object",
      "required": ["id", "hypothesis_id", "experiment_ids", "run_ids", "type", "direction", "strength", "observations", "inference", "boundaries", "unresolved_confounds", "reviewed_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "EV-[A-Z0-9-]+-[0-9]{3,}"},
        "hypothesis_id": {"type": "string", "pattern": "H-[A-Z0-9-]+-[0-9]{3,}"},
        "experiment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "EXP-[A-Z0-9-]+-[0-9]{3,}"}},
        "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "RUN-[A-Z0-9-]+-[0-9]{3,}"}},
        "type": {"type": "string", "enum": ["empirical", "theoretical", "literature"]},
        "direction": {"type": "string", "enum": ["supports", "weakens", "contradicts", "neutral"]},
        "strength": {"type": "string", "enum": ["anecdotal", "preliminary", "replicated", "strong", "inconclusive", "contradictory"]},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "inference": {"type": "string"},
        "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "unresolved_confounds": {"type": "array", "items": {"type": "string"}},
        "reviewed_by": {"type": "string"}
      }
    }
  }
}
