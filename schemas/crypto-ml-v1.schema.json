{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crypto-ml-v1 experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "primitive",
    "sampling",
    "features",
    "labels",
    "splits",
    "evaluation",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "crypto-ml-v1"
    },
    "experiment": {
      "type": "object",
      "required": [
        "id",
        "task"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "enum": [
            "binary_distinguisher",
            "multiclass_distinguisher",
            "regression",
            "anomaly_detection"
          ]
        }
      },
      "additionalProperties": true
    },
    "primitive": {
      "type": "object",
      "required": [
        "family",
        "name",
        "variant",
        "parameters"
      ],
      "properties": {
        "family": {
          "enum": [
            "block_cipher",
            "stream_cipher",
            "hash",
            "kem",
            "signature",
            "elliptic_curve",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "sampling": {
      "type": "object",
      "required": [
        "positive",
        "negative",
        "independent_units",
        "samples_per_unit"
      ],
      "properties": {
        "positive": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        },
        "independent_units": {
          "type": "integer",
          "minimum": 2
        },
        "samples_per_unit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "labels": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "splits": {
      "type": "object",
      "required": [
        "grouping",
        "train",
        "validation",
        "test"
      ],
      "properties": {
        "grouping": {
          "type": "string"
        },
        "train": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "validation": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "test": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": [
        "metrics",
        "controls"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "implementation_commit",
        "generator_version",
        "seed_manifest"
      ],
      "properties": {
        "implementation_commit": {
          "type": "string",
          "minLength": 1
        },
        "generator_version": {
          "type": "string",
          "minLength": 1
        },
        "seed_manifest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
