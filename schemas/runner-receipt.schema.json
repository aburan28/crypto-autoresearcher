{
  "type": "object",
  "required": ["runner_receipt"],
  "additionalProperties": false,
  "properties": {
    "runner_receipt": {
      "type": "object",
      "required": ["format_version", "experiment_id", "run_id", "role", "status", "argv", "command", "inputs", "timeout_seconds", "approval_lock_sha256", "specification_sha256", "execution_plan_sha256", "run_object_sha256", "protocol_hashes_sha256", "approved_base_commit", "launch_commit", "python_sha256", "process_group", "wrapper_postprocessing", "post_run_checks", "predecessor", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "format_version": {"const": 1},
        "experiment_id": {"type": "string", "pattern": "EXP-[A-Z0-9-]+-[0-9]{3,}"},
        "run_id": {"type": "string", "pattern": "RUN-[A-Z0-9-]+-[0-9]{3,}"},
        "role": {"type": "string", "enum": ["generator", "verifier"]},
        "status": {"type": "string", "enum": ["completed_valid", "completed_invalid", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget"]},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": ".+"}
        },
        "command": {"type": "string"},
        "inputs": {
          "type": "object",
          "required": ["curve_id", "seed", "parameters"],
          "additionalProperties": false,
          "properties": {
            "curve_id": {"type": ["string", "null"]},
            "seed": {"type": "integer"},
            "parameters": {"type": "object"}
          }
        },
        "timeout_seconds": {"type": "number", "minimum": 0},
        "approval_lock_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "specification_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "execution_plan_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "run_object_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "protocol_hashes_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "approved_base_commit": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "launch_commit": {"type": "string", "pattern": "[0-9a-f]{40}"},
        "python_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "process_group": {
          "type": "object",
          "required": ["wall_seconds", "cpu_seconds", "peak_rss_bytes", "quiescent", "direct_parent_return_code", "descendant_policy", "effective_uid"],
          "additionalProperties": false,
          "properties": {
            "wall_seconds": {"type": "number", "minimum": 0},
            "cpu_seconds": {"type": "number", "minimum": 0},
            "peak_rss_bytes": {"type": "integer", "minimum": 0},
            "quiescent": {"type": "boolean"},
            "direct_parent_return_code": {"type": ["integer", "null"]},
            "descendant_policy": {"const": "forbidden-via-rlimit-nproc-zero"},
            "effective_uid": {"type": "integer", "minimum": 1}
          }
        },
        "wrapper_postprocessing": {
          "type": "object",
          "required": ["wall_seconds", "cpu_seconds", "peak_rss_bytes", "boundary"],
          "additionalProperties": false,
          "properties": {
            "wall_seconds": {"type": "number", "minimum": 0},
            "cpu_seconds": {"type": "number", "minimum": 0},
            "peak_rss_bytes": {"type": "integer", "minimum": 0},
            "boundary": {"const": "through-core-artifact-hashing-before-receipt-and-manifest-write"}
          }
        },
        "post_run_checks": {
          "type": "object",
          "required": ["process_group_quiescent", "commit_unchanged", "tree_unchanged", "approval_lock_unchanged", "specification_unchanged", "execution_plan_unchanged", "protocol_hashes_unchanged"],
          "additionalProperties": false,
          "properties": {
            "process_group_quiescent": {"type": "boolean"},
            "commit_unchanged": {"type": "boolean"},
            "tree_unchanged": {"type": "boolean"},
            "approval_lock_unchanged": {"type": "boolean"},
            "specification_unchanged": {"type": "boolean"},
            "execution_plan_unchanged": {"type": "boolean"},
            "protocol_hashes_unchanged": {"type": "boolean"}
          }
        },
        "predecessor": {
          "type": ["object", "null"],
          "required": ["run_id", "launch_commit", "manifest_sha256", "receipt_sha256", "raw_result_sha256"],
          "additionalProperties": false,
          "properties": {
            "run_id": {"type": "string", "pattern": "RUN-[A-Z0-9-]+-[0-9]{3,}"},
            "launch_commit": {"type": "string", "pattern": "[0-9a-f]{40}"},
            "manifest_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
            "receipt_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
            "raw_result_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
          }
        },
        "artifacts": {
          "type": "object",
          "required": ["command.txt", "environment.json", "raw-result.json", "stderr.log", "stdout.log"],
          "additionalProperties": false,
          "properties": {
            "command.txt": {"type": "object", "required": ["sha256", "bytes"], "additionalProperties": false, "properties": {"sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}, "bytes": {"type": "integer", "minimum": 0}}},
            "environment.json": {"type": "object", "required": ["sha256", "bytes"], "additionalProperties": false, "properties": {"sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}, "bytes": {"type": "integer", "minimum": 0}}},
            "raw-result.json": {"type": "object", "required": ["sha256", "bytes"], "additionalProperties": false, "properties": {"sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}, "bytes": {"type": "integer", "minimum": 0}}},
            "stderr.log": {"type": "object", "required": ["sha256", "bytes"], "additionalProperties": false, "properties": {"sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}, "bytes": {"type": "integer", "minimum": 0}}},
            "stdout.log": {"type": "object", "required": ["sha256", "bytes"], "additionalProperties": false, "properties": {"sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}, "bytes": {"type": "integer", "minimum": 0}}}
          }
        }
      }
    }
  }
}
