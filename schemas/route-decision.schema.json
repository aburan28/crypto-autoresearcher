{
  "$defs": {
    "EscalationPolicy": {
      "additionalProperties": false,
      "description": "A proposed future escalation rule, not a scheduling command.",
      "properties": {
        "contradiction_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Contradiction Threshold",
          "type": "number"
        },
        "repeated_failure_count": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Repeated Failure Count",
          "type": "integer"
        },
        "verifier_failure_policy": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Verifier Failure Policy",
          "type": "string"
        }
      },
      "required": [
        "verifier_failure_policy",
        "repeated_failure_count",
        "contradiction_threshold"
      ],
      "title": "EscalationPolicy",
      "type": "object"
    },
    "HardPolicyFloor": {
      "additionalProperties": false,
      "description": "Non-negotiable capability requirements before any cost comparison.",
      "properties": {
        "independent_session": {
          "title": "Independent Session",
          "type": "boolean"
        },
        "minimum_policy": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Minimum Policy",
          "type": "string"
        },
        "no_degradation": {
          "default": true,
          "title": "No Degradation",
          "type": "boolean"
        },
        "required_runtime_capabilities": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Required Runtime Capabilities",
          "type": "array"
        }
      },
      "required": [
        "minimum_policy",
        "independent_session"
      ],
      "title": "HardPolicyFloor",
      "type": "object"
    },
    "RouteCandidate": {
      "additionalProperties": false,
      "description": "A policy/backend/model binding that survived the declared hard gates.",
      "properties": {
        "backend": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Backend",
          "type": "string"
        },
        "capability_fit": {
          "const": "eligible",
          "default": "eligible",
          "title": "Capability Fit",
          "type": "string"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "estimated_latency_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Latency Seconds"
        },
        "policy": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Policy",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "reasoning_effort": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Reasoning Effort",
          "type": "string"
        },
        "resolved_model_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Resolved Model Id",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "backend",
        "resolved_model_id",
        "reasoning_effort"
      ],
      "title": "RouteCandidate",
      "type": "object"
    },
    "RouteFeatures": {
      "additionalProperties": false,
      "description": "Deterministic/classified inputs recorded for an auditable route.",
      "properties": {
        "ambiguity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ambiguity",
          "type": "number"
        },
        "contradiction_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Contradiction Score",
          "type": "number"
        },
        "kb_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Kb Coverage",
          "type": "number"
        },
        "mathematical_depth": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mathematical Depth",
          "type": "number"
        },
        "novelty": {
          "maximum": 1,
          "minimum": 0,
          "title": "Novelty",
          "type": "number"
        },
        "output_verifiability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Output Verifiability",
          "type": "number"
        },
        "previous_failed_attempts": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Previous Failed Attempts",
          "type": "integer"
        },
        "task_type": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Task Type",
          "type": "string"
        },
        "tool_dominance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Tool Dominance",
          "type": "number"
        }
      },
      "required": [
        "task_type",
        "novelty",
        "mathematical_depth",
        "ambiguity",
        "tool_dominance",
        "output_verifiability",
        "kb_coverage",
        "contradiction_score",
        "previous_failed_attempts"
      ],
      "title": "RouteFeatures",
      "type": "object"
    },
    "RouteMode": {
      "description": "The only Phase-0 route modes: neither changes current execution.",
      "enum": [
        "shadow",
        "advisory"
      ],
      "title": "RouteMode",
      "type": "string"
    },
    "RouteRejection": {
      "additionalProperties": false,
      "description": "A binding excluded before selection, with a machine-reviewable reason.",
      "properties": {
        "backend": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Backend",
          "type": "string"
        },
        "hard_gate": {
          "title": "Hard Gate",
          "type": "boolean"
        },
        "policy": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Policy",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "resolved_model_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
          "title": "Resolved Model Id",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "backend",
        "resolved_model_id",
        "reason_code",
        "hard_gate"
      ],
      "title": "RouteRejection",
      "type": "object"
    },
    "RouteSelectionStatus": {
      "enum": [
        "recommended",
        "no_eligible_candidate"
      ],
      "title": "RouteSelectionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An immutable shadow/advisory recommendation with no execution authority.",
  "properties": {
    "advisory_only": {
      "const": true,
      "default": true,
      "title": "Advisory Only",
      "type": "boolean"
    },
    "campaign_transition_authority": {
      "const": "none",
      "default": "none",
      "title": "Campaign Transition Authority",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/RouteCandidate"
      },
      "maxItems": 32,
      "title": "Candidates",
      "type": "array"
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "escalation_policy": {
      "$ref": "#/$defs/EscalationPolicy"
    },
    "evidence_bundle_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Bundle Hash",
      "type": "string"
    },
    "evidence_bundle_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "features": {
      "$ref": "#/$defs/RouteFeatures"
    },
    "hard_requirements": {
      "$ref": "#/$defs/HardPolicyFloor"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/RouteMode",
      "default": "shadow"
    },
    "reason_codes": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Reason Codes",
      "type": "array"
    },
    "rejections": {
      "items": {
        "$ref": "#/$defs/RouteRejection"
      },
      "maxItems": 32,
      "title": "Rejections",
      "type": "array"
    },
    "router_version": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Router Version",
      "type": "string"
    },
    "routing_changed": {
      "const": false,
      "default": false,
      "title": "Routing Changed",
      "type": "boolean"
    },
    "schema": {
      "const": "crypto.autoresearch.route_decision.v1",
      "default": "crypto.autoresearch.route_decision.v1",
      "title": "Schema",
      "type": "string"
    },
    "selected": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouteCandidate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selection_status": {
      "$ref": "#/$defs/RouteSelectionStatus"
    },
    "task_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "task_id",
    "evidence_bundle_id",
    "evidence_bundle_hash",
    "features",
    "hard_requirements",
    "selection_status",
    "escalation_policy",
    "router_version"
  ],
  "title": "RouteDecision",
  "type": "object"
}
