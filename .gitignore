__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
dist/
build/
*.egg-info/
._*

*.sage.py

# large binary run checkpoints (kept on disk, not in git)
*.pkl

# api_direct runtime checkpoints (resumable state, not research evidence)
.agent-state/

# Regenerable solver chunk state — block-Wiedemann/M4RI carries.
# NOT run receipts: the mirror-log.json in each experiment indexes every
# carry by filename -> git blob -> payload sha256, and the instrument
# regenerates them from the recorded seed + system_hash.
# *.raw was the single missing rule: 32 untracked carry_*.raw files exceed
# GitHub's 100 MB limit (largest 238,912,804 B) and nothing was stopping
# them from being staged.
*.raw
carry_*.raw
carry_*.pkl

# Compiled extensions built from the .pyx/.sage sources kept in-tree
*.so
*.dylib

# Scratch/precursor trees that hold no run record.
# NOTE: deliberately NOT ignoring experiments/**/work/ wholesale — 41 tracked
# state.json/result.json receipts live under work/ and must stay stageable.
experiments/**/smoke_work/
experiments/**/runtime/sage/

# Eval results are regenerated per run; baselines under
# evals/baselines/ ARE committed.
evals/results/

# local credentials (copy from .env.example)
.env


# Compiled producer binaries under coordination/. Excluded from snapshot
# archives on purpose: they are rebuildable from the declared source (cnt.c,
# sq_null.c, probe.c, all archived), they are not reproducible across machines,
# and an archive that declares them would fail verification whenever a rebuild
# changed a byte. The SOURCE is the artifact; the binary is not.
coordination/goals/*/batches/*/tasks/*/cnt
coordination/goals/*/batches/*/tasks/*/sq_null
coordination/goals/*/batches/*/tasks/*/probe
coordination/goals/*/batches/*/tasks/*/mini
coordination/goals/*/batches/*/tasks/*/mini2
coordination/goals/*/batches/*/tasks/*/count5
coordination/goals/*/batches/*/tasks/*/pin

# In-flight producer working directory for GOAL-ECDLP-001 BATCH-028.
# REMOVED BY THE SNAPSHOT ARCHIVE TASK-20260802-d34ac4, IN A COMMIT THAT PRECEDES IT.
# Rationale, learned the hard way in GOAL-AES-003 and recorded as CORR-20260802-009:
# a dispatcher-verified archive must INTRODUCE every path it declares. Producer
# artifacts swept into an earlier commit by `git add -A` can never afterwards be
# bound by the archive that is supposed to bind them, and BATCH-001's ledger archive
# is permanently "published but not official" for exactly that reason.
coordination/goals/GOAL-ECDLP-001/batches/BATCH-028/tasks/

# experiments/EXP-SMTH-4403c4/ ignore REMOVED: PR #144 landed the frozen
# contract + measurement package; run manifests must be trackable for
# validate_ledger (EV-DS-84d006 cites RUN-SMTH-4403c4-*).

# ---------------------------------------------------------------------------
# GENERATED ARTIFACTS — never committed.
#
# Each of these is derived, byte-for-byte, from files that ARE committed. While
# they were tracked they sat in the top five conflict paths of the repository:
# every branch that added a knowledge entry rewrote the whole of INDEX.md, and
# every branch that touched a queue rewrote its whole plan. Two agents doing
# unrelated work therefore conflicted on files that carry no information of
# their own.
#
# Rebuild locally with:
#   python3 tools/build_knowledge_index.py
#   python3 tools/research_dispatch.py <queue> --output <dir>/dispatch_plan.json \
#                                              --report <dir>/dispatch_plan.md
# CI regenerates both and fails if the corpus or a queue does not build.
#
# MIGRATION NOTE for open branches: main DELETES these paths, so a branch that
# still modifies them will hit a delete/modify conflict on its next merge. That
# is a one-time mechanical conflict whose only correct resolution is `git rm`,
# and tools/sync_open_branches.py resolves it automatically for exactly these
# paths. It is deliberately preferred over the recurring content conflict it
# replaces.
knowledge/INDEX.md
coordination/goals/*/batches/*/dispatch_plan.json
coordination/goals/*/batches/*/dispatch_plan.md
coordination/goals/*/batches/*/plan/dispatch_plan.json
coordination/goals/*/batches/*/plan/dispatch_plan.md

# Derived retrieval index (kb/). Object storage and the records in this
# repository are the source of truth; the staged corpus, the manifests, and
# the query log are all rebuildable with `make -C kb slice`.
kb/.kb-corpus/
kb/.kb-queries.jsonl
kb/.env

