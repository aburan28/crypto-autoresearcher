__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
dist/
build/
*.egg-info/
._*

*.sage.py

# large binary run checkpoints (kept on disk, not in git)
*.pkl

# api_direct runtime checkpoints (resumable state, not research evidence)
.agent-state/

# Regenerable solver chunk state — block-Wiedemann/M4RI carries.
# NOT run receipts: the mirror-log.json in each experiment indexes every
# carry by filename -> git blob -> payload sha256, and the instrument
# regenerates them from the recorded seed + system_hash.
# *.raw was the single missing rule: 32 untracked carry_*.raw files exceed
# GitHub's 100 MB limit (largest 238,912,804 B) and nothing was stopping
# them from being staged.
*.raw
carry_*.raw
carry_*.pkl

# Compiled extensions built from the .pyx/.sage sources kept in-tree
*.so
*.dylib

# Scratch/precursor trees that hold no run record.
# NOTE: deliberately NOT ignoring experiments/**/work/ wholesale — 41 tracked
# state.json/result.json receipts live under work/ and must stay stageable.
experiments/**/smoke_work/
experiments/**/runtime/sage/

# Eval results are regenerated per run; baselines under
# evals/baselines/ ARE committed.
evals/results/

# local credentials (copy from .env.example)
.env
