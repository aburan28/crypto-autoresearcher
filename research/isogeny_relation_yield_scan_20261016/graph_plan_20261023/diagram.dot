digraph G {
  graph [rankdir=TB, bgcolor="white", label="Candidate readiness is separate from approved execution", labelloc=t, fontsize=17];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fa", color="#365a7c", fontname="Helvetica"];
  approved [label="Coordinator decision\napproved stage-0 study admission"];
  compiler [label="Stage-0 discovery compiler\n8,206 fixed trials"];
  candidate [label="Unapproved frozen candidate\ncandidate-trial-plan.json\nexplicit readiness query only", fillcolor="#fff7d6", color="#94772a"];
  schedule [label="Full fixed schedule\n8,206 arms; P29 and P37"];
  roots [label="Two graph commitments\nshared independent roots"];
  sources [label="Frozen source commit\nsource and binary digests"];
  output [label="Bound experiment run tree"];
  perarm [label="Per-arm replay\nschedule row + prepared binding\ncheckpoint hashes when transported"];
  launch [label="Phased relation collector\nonly after all checks pass", fillcolor="#e6f4e9", color="#3c7b53"];
  stop [label="First invalid arm certificate\nstops later arms; retain receipt", fillcolor="#fce8e6", color="#a33a32"];
  controls [label="Controls\nplan accepted by execution loader\ncandidate/non-Coordinator refused\nstage-1 approval refused here\nchanged checkpoint refused", fillcolor="#fff1e6", color="#a6642b"];
  stages [label="Still to implement and bind\nstage-1 fresh confirmation roots\nstage-2 finalist solve roots", fillcolor="#fff1e6", color="#a6642b"];
  compiler -> candidate [style=dashed];
  candidate -> controls [style=dashed, label="execution refused"];
  compiler -> schedule;
  compiler -> output;
  approved -> perarm;
  schedule -> perarm;
  roots -> perarm;
  sources -> perarm;
  output -> perarm;
  perarm -> launch;
  launch -> stop [style=dashed, label="invalid output"];
  controls -> perarm [style=dashed];
  stages -> approved [style=dashed, label="separate launch gates"];
}
