digraph G {
  graph [rankdir=TB, bgcolor="white", label="P37 vertex 0: full-quota preparation control (public roots)", labelloc=t, fontsize=17];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fa", color="#365a7c", fontname="Helvetica"];
  schedule [label="Verified candidate schedule\n8,206 arms; select 3 fixed rows"];
  roots [label="Public control roots\nbase / target / verifier"];
  materializer [label="Schedule-bound materializer\n2,048 targets per arm"];
  native [label="P37-v0000-low_x\n3,200 signed base points"];
  u2 [label="P37-v0000-u2_transport\nexact (4x, 8y) map"];
  graphbase [label="P37-v0000-graph_transport\nindex-zero source identity"];
  replay [label="Group-law and binding replay\n3 arms passed; 3 mutations rejected", fillcolor="#e6f4e9", color="#3c7b53"];
  admission [label="Coordinator admission and relation collection\nnot part of this control", fillcolor="#f5f5f5", color="#888888"];
  schedule -> materializer;
  roots -> materializer;
  materializer -> native;
  materializer -> u2;
  materializer -> graphbase;
  native -> replay;
  u2 -> replay;
  graphbase -> replay;
  replay -> admission [style=dashed, label="next gate"];
}
