digraph Followup {
 graph [rankdir=TB,bgcolor="white",fontname="Helvetica",pad="0.1"];
 node [shape=box,style="rounded,filled",fontname="Helvetica",fontsize=11];
 api [label="Default API route
credential unavailable",fillcolor="#fff0df",color="#99613c"];
 alias [label="Direct alias: GPT-6.1 Sol
launch failed before verified thread",fillcolor="#fff0df",color="#99613c"];
 mismatch [label="Requested Sol / bound Terra
policy mismatch rejected before launch",fillcolor="#fff0df",color="#99613c"];
 direct [label="Exact direct Terra session
model, effort, provider, session + sandbox verified",fillcolor="#e5f1e8",color="#457a4e"];
 design [label="Coordinator design task
committed handoff; scientific admission still required",fillcolor="#fff0df",color="#99613c"];
 cohort [label="11 omitted + 10 published orders
zero named cases executed in this record",style="rounded,dashed",fillcolor="white",color="#99613c"];
 api -> alias -> mismatch -> direct -> design;
 design -> cohort [style=dashed];
}
