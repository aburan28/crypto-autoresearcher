digraph Admission {
  graph [rankdir=LR,bgcolor="white",fontname="Helvetica",pad="0.15"];
  node [shape=box,style="rounded,filled",fillcolor="#e5f1e8",color="#457a4e",fontname="Helvetica",fontsize=11];
  build [label="32-bit C build\nsource and binaries bound"];
  arithmetic [label="69 fixed vectors\n345 exact comparisons"];
  small [label="4 normal small cases\nCM-only 101 + affine check"];
  checker [label="QEMU checker: all 9 fixtures\n16 root/grammar controls\n26 framing controls pass",fillcolor="#e5f1e8",color="#457a4e"];
  coordinator [label="Exact direct Coordinator session\nmodel/effort/provider/sandbox verified"];
  cohort [label="21 exact orders pinned\nreplay not approved / not executed",style="rounded,dashed",fillcolor="white",color="#99613c"];
  history [label="Original caller and selection trace\nstill missing",style="rounded,dashed",fillcolor="white",color="#99613c"];
  build -> arithmetic; arithmetic -> small; small -> checker;
  checker -> coordinator; coordinator -> cohort [style=dashed];cohort -> history [style=dashed];
}
