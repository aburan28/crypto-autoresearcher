digraph Status {
 graph [rankdir=TB,bgcolor="white",fontname="Helvetica",pad="0.12",nodesep="0.2",ranksep="0.25"];
 node [shape=box,style="rounded,filled",fontname="Helvetica",fontsize=12,color="#3e7450",fillcolor="#e8f4eb"];
 controls [label="Fixed runtime controls and exact cohort inputs
already recorded"];
 lane [label="Scoped goal, lane and zero-run claim
published"];
 implementation [label="Three implementation drafts tested
all three suites report failures",color="#ac683b",fillcolor="#fff0e1"];
 cohort [label="Future 21-order measurement
not approved or executed",style="rounded,dashed",color="#8c7460",fillcolor="white"];
 controls -> lane -> implementation;
 implementation -> cohort [style=dashed,label="requires complete runner/checker + approval",fontsize=10];
}