digraph Status {
  graph [rankdir=LR,bgcolor="white",fontname="Helvetica",pad="0.15"];
  node [shape=box,style="rounded,filled",fillcolor="#e5f1e8",color="#457a4e",fontname="Helvetica",fontsize=11];
  fixture [label="Exact source + prior certificates\n21 curve identities / 18 bindings"];
  mock [label="V9 guarded fake-boundary tests\n9 methods pass\n0 legacy calls / 0 cohort orders"];
  archive [label="Implementation snapshot\nCoordinator archive pending",fillcolor="#fff0e1",color="#ac683b"];
  measurement [label="Actual 21-order comparison\nseparate frozen protocol required",style="rounded,dashed",fillcolor="white",color="#99613c"];
  history [label="Historical keep/skip explanation\noriginal caller / logs absent",style="rounded,dashed",fillcolor="white",color="#99613c"];
  fixture -> mock -> archive; archive -> measurement [style=dashed]; measurement -> history [style=dashed];
}
