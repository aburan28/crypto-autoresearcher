// Isogeny volcano of y^2 + xy = x^3 + 1 over F_2^41 = F_2[x]/(x^41+x^3+1), a2 = 0 class (#E = 4 * 549756390943).
// Curves: E_b : y^2 + xy = x^3 + b, b written as the integer of its polynomial-basis bits.
// Solid edge  = isogeny computed here and its endpoint verified (#E = N by ellcard; 23- and 11-cycle lengths match).
// Dashed edge = isogeny implied by volcano theory (rational, exists), NOT computed in this study.
// Render: dot -Tsvg volcano_diagram.dot -o volcano_diagram.svg
digraph volcano41 {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=0.9, bgcolor="white",
         label="Isogeny volcano, m = 41 (solid: computed + verified; dashed: implied by theory, not computed)", labelloc=t];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#52514e"];
  edge  [fontname="Helvetica", fontsize=9, color="#52514e"];

  crater [fillcolor="#fbe0d3", label="CRATER  f = 1,  End = O_K = Z[(1+sqrt(-7))/2]\nE_1 : y^2+xy = x^3+1   (b = 1, j = 1)\nh = 1 curve; Frobenius tau (deg 2) in End\n23-cycle 1, 11-cycle 1 (measured)"];

  s409  [fillcolor="#d2f0e4", label="409-floor seed  f = 409\nE_b, b = 5031829425\n#E = N (ellcard); 23-cycle 205, 11-cycle 82 (measured)"];
  f409  [fillcolor="#e8f7f0", label="409-FLOOR: 410 curves = 10 Galois orbits\nall 410 enumerated, all #E = N (floor409.txt)\n30 sampled for rho (ids 1-30)"];

  s1721 [fillcolor="#dcd8f2", label="1721-floor seed  f = 1721\nE_b, b = 14893930241\n#E = N (ellcard); 23-cycle 574, 11-cycle 861 (measured)"];
  f1721 [fillcolor="#eeecf9", label="1721-FLOOR: 1,722 curves = 42 Galois orbits\nall 1,722 enumerated, all #E = N (floor1721.txt)\n30 orbits sampled for rho (ids 101-130)"];

  bottom [fillcolor="#ecebe8", label="BOTTOM  f = 409 * 1721 = 703889\n706,020 curves = 17,220 Galois orbits\n82 scan hits (all bottom by exclusion); 30 orbits sampled (ids 201-230)\ne.g. b = 5997019219, 37744445183, ... (sample.csv); 23-cycle 2870, 11-cycle 1722 on all 30 (measured)"];

  crater -> s409  [label="409, descending\nkernel x-coords in F_2^8364 (twist; c^204 = -1)\nchar-2 Velu, b' = 1+v+v^2", penwidth=1.8, color="#1baf7a"];
  crater -> s1721 [label="1721, descending\nkernel x-coords in F_2^8815 (E; c^215 = 1)\nchar-2 Velu, b' = 1+v+v^2", penwidth=1.8, color="#4a3aa7"];
  crater -> f409  [label="409 other descending\n(410 in total)", style=dashed];
  crater -> f1721 [label="1721 other descending\n(1722 in total)", style=dashed];

  s409  -> f409  [label="29, horizontal cycle\nlength 410 = h (measured)", penwidth=1.8, color="#1baf7a"];
  s1721 -> f1721 [label="29, horizontal cycle\nlength 1722 = h (measured)", penwidth=1.8, color="#4a3aa7"];

  f409  -> bottom [label="1721, descending\n(each floor curve: 1722)", style=dashed];
  f1721 -> bottom [label="409, descending\n(each floor curve: 410)", style=dashed];

  {rank=same; s409; s1721;}
  {rank=same; f409; f1721;}
}
