+fn mod_mul(left: u64, right: u64, modulus: u64) -> u64 {
+    ((left as u128 * right as u128) % modulus as u128) as u64
+}
+
+fn mod_sub(left: u64, right: u64, modulus: u64) -> u64 {
+    if left >= right { left - right } else { modulus - (right - left) }
+}
