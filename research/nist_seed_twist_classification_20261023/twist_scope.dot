digraph twist_scope {
  graph [rankdir=TB, bgcolor="white", label="Exact scope: rational twists of each archived curve", labelloc=t, fontsize=17, fontname="Helvetica", nodesep=0.25, ranksep=0.35];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#b6c3cc", fillcolor="#f3f7f9"];
  edge [fontname="Helvetica", fontsize=10, color="#435d70"];
  E [label="21 exact E/Fp\na = -3, b != 0\n11 omitted + 10 published"];
  J [label="j != 0, 1728\nAut(E_bar) = {+1, -1}"];
  R [label="Two Fp-isomorphism classes\nE and one quadratic twist E^d"];
  F [label="Existing complete twist-order\nfactorization, bound to each UID"];
  X [label="Other invalid-input curves\nnot in this twist class", style="rounded,dashed", fillcolor="white", color="#9a6946"];
  E -> J [label="21 exact checks"];
  J -> R [label="twist theorem"];
  R -> F [label="21 order bindings"];
  E -> X [style=dashed, color="#9a6946", label="separate analysis"];
}
