@CryptoResearch.Semaev.inDeclaredSpan_iff.{u_1,
    u_2} : ∀ {k : Type u_1} {K : Type u_2} [inst : Field.{u_1} k] [inst_1 : Field.{u_2} K]
  [inst_2 : Algebra.{u_1, u_2} k K] {n : ℕ} (basis : Fin n → K) (x : K),
  CryptoResearch.Semaev.InDeclaredSpan.{u_1, u_2} basis x ↔
    Membership.mem.{u_2, u_2} (Submodule.span.{u_1, u_2} k (Set.range.{u_2, 1} basis)) x
@CryptoResearch.Semaev.checkDecomposition_iff.{u_1,
    u_2} : ∀ {k : Type u_1} {K : Type u_2} [inst : Field.{u_1} k] [inst_1 : Fintype.{u_1} k] [inst_2 : Field.{u_2} K]
  [inst_3 : DecidableEq.{u_2 + 1} K] [inst_4 : Algebra.{u_1, u_2} k K] {n m : ℕ} (E : WeierstrassCurve.Affine.{u_2} K)
  (basis : Fin n → K) (P : Fin m → CryptoResearch.Semaev.AffineSummand.{u_2} E)
  (R : WeierstrassCurve.Affine.Point.{u_2} E),
  Eq.{1} (CryptoResearch.Semaev.checkDecomposition.{u_1, u_2} E basis P R) true ↔
    (∀ (i : Fin m),
        WeierstrassCurve.Affine.Equation.{u_2} E (CryptoResearch.Semaev.AffineSummand.x.{u_2} (P i))
          (CryptoResearch.Semaev.AffineSummand.y.{u_2} (P i))) ∧
      (∀ (i : Fin m),
          Membership.mem.{u_2, u_2} (Submodule.span.{u_1, u_2} k (Set.range.{u_2, 1} basis))
            (CryptoResearch.Semaev.AffineSummand.x.{u_2} (P i))) ∧
        Eq.{u_2 + 1} (∑ i, CryptoResearch.Semaev.AffineSummand.point.{u_2} (P i)) R
@CryptoResearch.Semaev.decidable_validDecomposition.{u_1,
    u_2} : ∀ {k : Type u_1} {K : Type u_2} [inst : Field.{u_1} k] [Fintype.{u_1} k] [inst_2 : Field.{u_2} K]
  [inst_3 : DecidableEq.{u_2 + 1} K] [inst_4 : Algebra.{u_1, u_2} k K] {n m : ℕ} (E : WeierstrassCurve.Affine.{u_2} K)
  (basis : Fin n → K) (P : Fin m → CryptoResearch.Semaev.AffineSummand.{u_2} E)
  (R : WeierstrassCurve.Affine.Point.{u_2} E),
  ∃ checked, Eq.{1} checked true ↔ CryptoResearch.Semaev.ValidDecomposition.{u_1, u_2} E basis P R
@CryptoResearch.NCP.wordSign_eq_negOne_pow : ∀ {B : ℕ} (w : List.{0} (CryptoResearch.NCP.Letter B)),
  Eq.{1} (CryptoResearch.NCP.wordSign w) (HPow.hPow.{0, 0, 0} (-1) (List.count.{0} CryptoResearch.NCP.Letter.negate w))
@CryptoResearch.NCP.word_action_affine_normal_form.{u_1} : ∀ {B : ℕ} {R : Type u_1} [inst : CommRing.{u_1} R]
  (s : Fin B → R) (w : List.{0} (CryptoResearch.NCP.Letter B)) (x : R),
  Eq.{u_1 + 1} (CryptoResearch.NCP.wordAction.{u_1} s w x)
    (HAdd.hAdd.{u_1, u_1, u_1} (HMul.hMul.{u_1, u_1, u_1} (↑(CryptoResearch.NCP.wordSign w)) x)
      (∑ i, HMul.hMul.{u_1, u_1, u_1} (↑(CryptoResearch.NCP.signedCounts w i)) (s i)))
@CryptoResearch.NCP.same_shadow_same_action.{u_1} : ∀ {B : ℕ} {R : Type u_1} [inst : CommRing.{u_1} R] (s : Fin B → R)
  (w w' : List.{0} (CryptoResearch.NCP.Letter B)),
  Eq.{1} (CryptoResearch.NCP.wordSign w) (CryptoResearch.NCP.wordSign w') →
    Eq.{1} (CryptoResearch.NCP.signedCounts w) (CryptoResearch.NCP.signedCounts w') →
      Eq.{u_1 + 1} (CryptoResearch.NCP.wordAction.{u_1} s w) (CryptoResearch.NCP.wordAction.{u_1} s w')
@CryptoResearch.NCP.orbit_value : ∀ {B n : ℕ} (s : Fin B → ZMod n) (w : List.{0} (CryptoResearch.NCP.Letter B)),
  Eq.{1} (CryptoResearch.NCP.wordAction.{0} s w 1)
    (HAdd.hAdd.{0, 0, 0} (↑(CryptoResearch.NCP.wordSign w))
      (∑ i, HMul.hMul.{0, 0, 0} (↑(CryptoResearch.NCP.signedCounts w i)) (s i)))
CryptoResearch.NCP.neg_square_not_in_commutators : ∀ (B : ℕ),
  HSub.hSub.{0, 0, 0} (HPow.hPow.{0, 0, 0} (CryptoResearch.NCP.negLetter B) 2) 1 ∉ CryptoResearch.NCP.commutatorIdeal B
@CryptoResearch.NCP.neg_square_in_action_kernel : ∀ {B n : ℕ} (s : Fin B → ZMod n),
  Membership.mem.{0, 0}
    (TwoSidedIdeal.ker.{0, 0, 0} (AlgHom.toRingHom.{0, 0, 0} (CryptoResearch.NCP.actionEvaluation s)))
    (HSub.hSub.{0, 0, 0} (HPow.hPow.{0, 0, 0} (CryptoResearch.NCP.negLetter B) 2) 1)
@CryptoResearch.NCP.kernel_not_generated_by_commutators : ∀ {B n : ℕ} (s : Fin B → ZMod n),
  Ne.{1} (TwoSidedIdeal.ker.{0, 0, 0} (AlgHom.toRingHom.{0, 0, 0} (CryptoResearch.NCP.actionEvaluation s)))
    (CryptoResearch.NCP.commutatorIdeal B)
@CryptoResearch.Semaev.instDecidableValidDecomposition.{u_1,
    u_2} : {k : Type u_1} →
  {K : Type u_2} →
    [inst : Field.{u_1} k] →
      [Fintype.{u_1} k] →
        [inst_2 : Field.{u_2} K] →
          [inst_3 : DecidableEq.{u_2 + 1} K] →
            [inst_4 : Algebra.{u_1, u_2} k K] →
              {n m : ℕ} →
                (E : WeierstrassCurve.Affine.{u_2} K) →
                  (basis : Fin n → K) →
                    (P : Fin m → CryptoResearch.Semaev.AffineSummand.{u_2} E) →
                      (R : WeierstrassCurve.Affine.Point.{u_2} E) →
                        Decidable (CryptoResearch.Semaev.ValidDecomposition.{u_1, u_2} E basis P R)
def CryptoResearch.Semaev.checkDecomposition.{u_1, u_2} : {k : Type u_1} →
  {K : Type u_2} →
    [inst : Field.{u_1} k] →
      [Fintype.{u_1} k] →
        [inst_2 : Field.{u_2} K] →
          [DecidableEq.{u_2 + 1} K] →
            [Algebra.{u_1, u_2} k K] →
              {n m : ℕ} →
                (E : WeierstrassCurve.Affine.{u_2} K) →
                  (Fin n → K) →
                    (Fin m → CryptoResearch.Semaev.AffineSummand.{u_2} E) →
                      WeierstrassCurve.Affine.Point.{u_2} E → Bool :=
fun {k} {K} [Field.{u_1} k] [Fintype.{u_1} k] [Field.{u_2} K] [DecidableEq.{u_2 + 1} K] [Algebra.{u_1, u_2} k K] {n m} E
    basis P R =>
  decide (CryptoResearch.Semaev.ValidDecomposition.{u_1, u_2} E basis P R)
