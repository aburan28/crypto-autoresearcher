{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/p192-wcm-role1-dispatch-decision.schema.json",
  "title": "P-192 weighted-CM Role-1 preflight dispatch decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinator_decision"],
  "properties": {
    "coordinator_decision": {"$ref": "#/$defs/decision"}
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "boundProtocolFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "supervisorBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "source_commit", "repository_path", "package_path",
        "binary_path", "byte_length", "binary_sha256", "build_profile",
        "worktree_clean", "contains_curve_arithmetic",
        "embedded_protocol_commit", "embedded_supervisor_commit",
        "embedded_verifier_commit", "embedded_build_profile",
        "embedded_supervisor_dirty", "embedded_git_metadata_present"
      ],
      "properties": {
        "repository": {"const": "https://github.com/aburan28/crypto"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "repository_path": {"$ref": "#/$defs/nonempty"},
        "package_path": {"$ref": "#/$defs/nonempty"},
        "binary_path": {"$ref": "#/$defs/nonempty"},
        "byte_length": {"type": "integer", "minimum": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "build_profile": {"const": "release"},
        "worktree_clean": {"const": true},
        "contains_curve_arithmetic": {"const": false},
        "embedded_protocol_commit": {"$ref": "#/$defs/commit"},
        "embedded_supervisor_commit": {"$ref": "#/$defs/commit"},
        "embedded_verifier_commit": {"$ref": "#/$defs/commit"},
        "embedded_build_profile": {"const": "release"},
        "embedded_supervisor_dirty": {"const": false},
        "embedded_git_metadata_present": {"const": true}
      }
    },
    "producerBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "source_commit", "embedded_protocol_commit",
        "embedded_source_commit", "repository_path", "package_path",
        "binary_path", "byte_length", "binary_sha256", "build_profile",
        "worktree_clean"
      ],
      "properties": {
        "repository": {"const": "https://github.com/aburan28/crypto"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "embedded_protocol_commit": {"$ref": "#/$defs/commit"},
        "embedded_source_commit": {"$ref": "#/$defs/commit"},
        "repository_path": {"$ref": "#/$defs/nonempty"},
        "package_path": {"$ref": "#/$defs/nonempty"},
        "binary_path": {"$ref": "#/$defs/nonempty"},
        "byte_length": {"type": "integer", "minimum": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "build_profile": {"const": "release"},
        "worktree_clean": {"const": true}
      }
    },
    "verifierBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "verifier_commit", "embedded_verifier_commit",
        "repository_path", "package_path", "binary_path", "byte_length",
        "binary_sha256", "build_profile", "worktree_clean", "crypto_lib_found",
        "shared_implementation_components"
      ],
      "properties": {
        "repository": {"const": "https://github.com/aburan28/crypto"},
        "verifier_commit": {"$ref": "#/$defs/commit"},
        "embedded_verifier_commit": {"$ref": "#/$defs/commit"},
        "repository_path": {"$ref": "#/$defs/nonempty"},
        "package_path": {"$ref": "#/$defs/nonempty"},
        "binary_path": {"$ref": "#/$defs/nonempty"},
        "byte_length": {"type": "integer", "minimum": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "build_profile": {"const": "release"},
        "worktree_clean": {"const": true},
        "crypto_lib_found": {"const": false},
        "shared_implementation_components": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "execution_authorized", "scientific_execution_authorized",
        "scientific_result_recording_authorized", "experiment_id",
        "protocol_version", "stage", "run", "protocol", "executables",
        "decision_path", "dependency_audit", "supervisor_argv", "producer_argv",
        "verifier_argv", "launch"
      ],
      "properties": {
        "schema": {"const": "p192-wcm-role1-preflight-authorization-v1"},
        "execution_authorized": {"const": true},
        "scientific_execution_authorized": {"const": false},
        "scientific_result_recording_authorized": {"const": false},
        "experiment_id": {"const": "EXP-SCURVE-1a8daf"},
        "protocol_version": {"const": 2},
        "decision_path": {"$ref": "#/$defs/nonempty"},
        "stage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label", "ordinal", "role", "composite_invocations",
            "retry_authorized", "resume_authorized",
            "advance_to_later_role_authorized", "unauthorized_stage_labels",
            "custody_outputs"
          ],
          "properties": {
            "label": {"const": "P192-WCM-PREFLIGHT"},
            "ordinal": {"const": 1},
            "role": {"const": "composite_producer_and_isolated_verifier"},
            "composite_invocations": {"const": 1},
            "retry_authorized": {"const": false},
            "resume_authorized": {"const": false},
            "advance_to_later_role_authorized": {"const": false},
            "unauthorized_stage_labels": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "prefixItems": [
                {"const": "P192-WCM-BOX0"},
                {"const": "P192-WCM-BOX1-SHELL"},
                {"const": "P192-WCM-BOX2-SHELL"},
                {"const": "P192-WCM-RELATIONS"},
                {"const": "P192-WCM-MAPS"},
                {"const": "P192-WCM-HOLDOUT"},
                {"const": "P192-WCM-REPLICATION"}
              ],
              "items": false
            },
            "custody_outputs": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "prefixItems": [
                {"const": "manifest.yaml"},
                {"const": "command.txt"},
                {"const": "environment.json"},
                {"const": "stdout.log"},
                {"const": "stderr.log"},
                {"const": "raw-result.json"}
              ],
              "items": false
            }
          }
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id", "run_dir", "must_be_fresh", "existing_path_refused"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^RUN-SCURVE-[0-9a-f]{6}$"
            },
            "run_dir": {"$ref": "#/$defs/nonempty"},
            "must_be_fresh": {"const": true},
            "existing_path_refused": {"const": true}
          }
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository", "repository_path", "commit", "must_be_ancestor_of_decision_commit",
            "protected_paths_unchanged_through_decision_commit",
            "protected_paths", "addendum", "interface_manifest"
          ],
          "properties": {
            "repository": {
              "const": "https://github.com/aburan28/crypto-autoresearcher"
            },
            "repository_path": {"$ref": "#/$defs/nonempty"},
            "commit": {"$ref": "#/$defs/commit"},
            "must_be_ancestor_of_decision_commit": {"const": true},
            "protected_paths_unchanged_through_decision_commit": {
              "const": true
            },
            "protected_paths": {
              "type": "array",
              "minItems": 11,
              "maxItems": 11,
              "items": {"type": "string", "minLength": 1}
            },
            "addendum": {
              "allOf": [
                {"$ref": "#/$defs/boundProtocolFile"},
                {
                  "properties": {
                    "path": {
                      "const": "experiments/EXP-SCURVE-1a8daf/amendments/v2_addendum_role1_interface.yaml"
                    }
                  }
                }
              ]
            },
            "interface_manifest": {
              "allOf": [
                {"$ref": "#/$defs/boundProtocolFile"},
                {
                  "properties": {
                    "path": {
                      "const": "research/p192-weighted-cm-20261007-v2-role1-interface/SHA256SUMS"
                    }
                  }
                }
              ]
            }
          }
        },
        "executables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supervisor", "producer", "verifier"],
          "properties": {
            "supervisor": {"$ref": "#/$defs/supervisorBinary"},
            "producer": {"$ref": "#/$defs/producerBinary"},
            "verifier": {"$ref": "#/$defs/verifierBinary"}
          }
        },
        "dependency_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path", "schema", "must_be_fresh", "receipt_hash_field",
            "hash_scope"
          ],
          "properties": {
            "path": {"$ref": "#/$defs/nonempty"},
            "schema": {"const": "p192-wcm-dependency-audit-v1"},
            "must_be_fresh": {"const": true},
            "receipt_hash_field": {
              "const": "dependency_audit.audit_output_sha256"
            },
            "hash_scope": {"const": "exact_raw_file_bytes"}
          }
        },
        "supervisor_argv": {
          "type": "array",
          "minItems": 23,
          "maxItems": 23,
          "prefixItems": [
            {"type": "string", "minLength": 1},
            {"const": "--producer"},
            {"type": "string", "minLength": 1},
            {"const": "--verifier"},
            {"type": "string", "minLength": 1},
            {"const": "--producer-source"},
            {"type": "string", "minLength": 1},
            {"const": "--verifier-source"},
            {"type": "string", "minLength": 1},
            {"const": "--protocol-repository"},
            {"type": "string", "minLength": 1},
            {"const": "--decision"},
            {"type": "string", "minLength": 1},
            {"const": "--run-dir"},
            {"type": "string", "minLength": 1},
            {"const": "--protocol-commit"},
            {"$ref": "#/$defs/commit"},
            {"const": "--source-commit"},
            {"$ref": "#/$defs/commit"},
            {"const": "--verifier-commit"},
            {"$ref": "#/$defs/commit"},
            {"const": "--audit-out"},
            {"type": "string", "minLength": 1}
          ],
          "items": false
        },
        "producer_argv": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "prefixItems": [
            {"const": "p192_weighted_cm"},
            {"const": "preflight"},
            {"const": "--curve"},
            {"const": "p192"},
            {"const": "--sieve-bound"},
            {"const": "65521"},
            {"const": "--map-bound"},
            {"const": "113"},
            {"const": "--large-prime-bound"},
            {"const": "2147483647"},
            {"const": "--positive-control"},
            {"const": "D=-23"},
            {"const": "--reference-shell"},
            {"const": "REF-0"},
            {"const": "--reference-v-max"},
            {"const": "2"},
            {"const": "--reference-x-max-inclusive"},
            {"const": "1024"},
            {"const": "--out"},
            {"type": "string", "minLength": 1}
          ],
          "items": false
        },
        "verifier_argv": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {"const": "p192_weighted_cm_verify"},
            {"const": "preflight"},
            {"const": "--source"},
            {"type": "string", "minLength": 1},
            {"const": "--out"},
            {"type": "string", "minLength": 1}
          ],
          "items": false
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "no_path_search_for_any_executable",
            "runtime_commit_override_forbidden", "producer_before_verifier",
            "close_and_rehash_producer_outputs_before_verifier",
            "supervisor_writes_only_run_directory_artifacts",
            "verify_protocol_checkout_before_run_directory",
            "derive_and_retain_decision_binding"
          ],
          "properties": {
            "no_path_search_for_any_executable": {"const": true},
            "runtime_commit_override_forbidden": {"const": true},
            "producer_before_verifier": {"const": true},
            "close_and_rehash_producer_outputs_before_verifier": {
              "const": true
            },
            "supervisor_writes_only_run_directory_artifacts": {
              "const": true
            },
            "verify_protocol_checkout_before_run_directory": {
              "const": true
            },
            "derive_and_retain_decision_binding": {
              "const": true
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "context", "decision", "target_ids", "rationale",
        "evidence_refs", "limitations", "next_actions", "authorization",
        "knowledge_promotion", "decided_by", "decided_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEC-[0-9]{8}-[0-9a-f]{6}$"
        },
        "context": {"$ref": "#/$defs/nonempty"},
        "decision": {"const": "approve"},
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{"const": "EXP-SCURVE-1a8daf"}],
          "items": false
        },
        "rationale": {"$ref": "#/$defs/nonemptyStringArray"},
        "evidence_refs": {"$ref": "#/$defs/nonemptyStringArray"},
        "limitations": {"$ref": "#/$defs/nonemptyStringArray"},
        "next_actions": {"$ref": "#/$defs/nonemptyStringArray"},
        "authorization": {"$ref": "#/$defs/authorization"},
        "knowledge_promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promoted", "not_warranted"],
          "properties": {
            "promoted": {"type": "array", "maxItems": 0},
            "not_warranted": {"$ref": "#/$defs/nonempty"}
          }
        },
        "decided_by": {"const": "coordinator"},
        "decided_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
