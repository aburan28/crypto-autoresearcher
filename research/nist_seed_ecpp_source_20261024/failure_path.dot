digraph Ecpp {
  graph [rankdir=TB,bgcolor="white",fontname="Helvetica",pad="0.15",nodesep="0.25",ranksep="0.3"];
  node [shape=box,style="rounded,filled",fillcolor="#e7f0fa",color="#325d83",fontname="Helvetica",fontsize=11];
  input [label="Input integer passes probable-prime precheck"];
  search [label="Build recursive certificate chain\nfinite catalog + factoring tactics"];
  found [label="Chain found → proveall\ncertificate checking remains required",fillcolor="#e5f1e8",color="#457a4e"];
  exhausted [label="Catalog exhausted → findm returns 0\nretry with gasp = 1",fillcolor="#fff0df",color="#99613c"];
  failure [label="Second failure at this depth\nbuildchain returns 0 → ecpp returns 0",fillcolor="#fff0df",color="#99613c"];
  label [label="CLI labels returned zero: composite\nNo compositeness witness on this path",fillcolor="#fff0df",color="#99613c"];
  missing [label="Do any of the 21 exact prime orders reach this path?\nWas this version/caller used historically?\nBoth unanswered",style="rounded,dashed",fillcolor="white",color="#99613c"];
  input -> search;
  search -> found [label="search succeeds"];
  search -> exhausted [label="search fails"];
  exhausted -> failure [label="retry also fails"];
  failure -> label;
  label -> missing [style=dashed];
}
