digraph G {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", label="Exact embedding degree: tested route and open historical step", labelloc=t, fontsize=16];
  node [shape=box, style="rounded,filled", fillcolor="#eef3f8", color="#526578", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#526578"];
  archive [label="19 exact curve UIDs\nprime subgroup orders n"];
  factor [label="Complete, Sage-checked\nfactorization of n−1"];
  k [label="k = ord_n(p)\nminimality certified"];
  bounds [label="All 19: k > 1,000,000\nsmallest k has 189 bits", fillcolor="#d7ecdf"];
  mov [label="No small-k pairing target\nin this named set", fillcolor="#d7ecdf"];
  hidden [label="Other hidden criterion or\n1997 selection behavior?", fillcolor="#fff1ce"];
  archive -> k [label="p,n"];
  factor -> k [label="prime divisors"];
  k -> bounds [label="exact comparison"];
  bounds -> mov [label="bounded inference"];
  mov -> hidden [style=dashed, label="does not resolve"];
}
