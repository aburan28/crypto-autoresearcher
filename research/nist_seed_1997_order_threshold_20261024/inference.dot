digraph Selection {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", pad="0.25"];
  node [shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#365c87", fontname="Helvetica"];
  draft [label="17 Nov 1997 X9.62\nchoose r_min; accept n ≥ r_min"];
  records [label="19 prior exact-order records\n8 published; 11 omitted"];
  bound [label="7 omissions have n ≥\nminimum published n in their field", fillcolor="#fff0dc", color="#b56a29"];
  history [label="Which positions the original\nprogram evaluated or rejected?", style="rounded,dashed", fillcolor="white", color="#9b6341"];
  draft -> bound [label="threshold theorem"];
  records -> bound [label="independent integer replay"];
  bound -> history [style=dashed, label="does not reveal", color="#9b6341"];
}
