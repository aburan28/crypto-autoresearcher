digraph selection_gap {
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="white", pad="0.2", nodesep="0.5", ranksep="0.65"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#e8f0fb", color="#345b89"];
  edge [fontname="Helvetica", color="#345b89"];
  seed [label="clock-derived candidate seed\n(reconstructed 2026)"];
  draft [label="X9.62 §F.3.2\n17 Nov 1997 draft", fillcolor="#daeecf", color="#477a40"];
  pass [label="all 11 omissions pass\nvisible draft gates", fillcolor="#daeecf", color="#477a40"];
  table [label="§H.5 prints 7 selected curves\nincluding P-256", fillcolor="#daeecf", color="#477a40"];
  missing [label="actual keep/skip rule\nor program state: unknown", fillcolor="#f8e7c2", color="#ac7625"];
  seed -> draft [style=dashed, label="hypothesized use"];
  draft -> pass [label="exact prior checks"];
  draft -> table [label="dated artifact"];
  pass -> missing [style=dashed, label="cannot explain omissions"];
  table -> missing [style=dashed, label="no decision trace"];
}
