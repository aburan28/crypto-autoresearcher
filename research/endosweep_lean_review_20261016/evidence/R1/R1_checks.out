isFundamental_of_primes : ∀ (os : List Nat),
  os.Nodup →
    (∀ (p : Nat), p ∈ os → IsPrimeNat p) →
      ∀ (D : Int),
        D = -↑os.prod ∧ D % 4 = 1 ∨ D = -4 * ↑os.prod ∧ (-↑os.prod % 4 = 2 ∨ -↑os.prod % 4 = 3) → IsFundamental D
@minNonscalarDegree_isLeast : ∀ {D : Int},
  IsDisc D → (∀ (a b : Int), b ≠ 0 → minNonscalarDegree D ≤ norm D a b) ∧ norm D 0 1 = minNonscalarDegree D
prod_mul_bound_le_of_eq_mul_sq : ∀ (P C B : Nat) (os : List Nat),
  P.Coprime C →
    1 < C →
      (∀ (r : Nat), r * r ≠ C) →
        (∀ (d : Nat), 1 < d → d < B → ¬d ∣ C) →
          os.Nodup →
            (∀ (p : Nat), p ∈ os → IsPrimeNat p) →
              (∀ (p : Nat), p ∈ os → ∃ e M, P = p ^ e * M ∧ ¬p ∣ M ∧ e % 2 = 1) →
                ∀ (s k : Nat), P * C = s * (k * k) → os.prod * B ≤ s
NistCertificates.B571.abs_DK_lower_bound : (∀ (p : Nat), p ∈ [5608493523058319, 3563521804312876303] → IsPrimeNat p) →
  (∀ (d : Nat), 1 < d → d < NistCertificates.B571.B → ¬d ∣ NistCertificates.B571.C) →
    ∀ (D f : Int),
      NistCertificates.B571.t ^ 2 - 4 * NistCertificates.B571.q = D * f ^ 2 →
        NistCertificates.B571.absDKAtLeast ≤ D.natAbs ∧
          (IsDisc D → ↑NistCertificates.B571.degAtLeast ≤ minNonscalarDegree D)
NistCertificates.exact_discriminants : ∀ (c : NistCertificates.FactoredCert),
  c ∈ NistCertificates.factoredCerts →
    c.t ^ 2 - 4 * c.q = c.DK * c.f ^ 2 ∧
      4 * c.q - c.t ^ 2 = ↑(List.map (fun pe => pe.fst ^ pe.snd) c.factors).prod ∧
        IsDisc c.DK ∧
          minNonscalarDegree c.DK = c.deg ∧ ((∀ (p : Nat), p ∈ c.largePrimes → IsPrimeNat p) → IsFundamental c.DK)
NistCertificates.finding3_bounds : (∀ (c : NistCertificates.FactoredCert),
    c ∈ NistCertificates.factoredCerts →
      2 ^ 162 ≤ c.DK.natAbs ∧ c.DK.natAbs < 2 ^ 523 ∧ 2 ^ 160 ≤ c.deg ∧ (2 ^ 223 ≤ c.q → 2 ^ 220 ≤ c.deg)) ∧
  [NistCertificates.P192.f, NistCertificates.P256.f, NistCertificates.P384.f, NistCertificates.P521.f,
        NistCertificates.B163.f, NistCertificates.B233.f, NistCertificates.B283.f, NistCertificates.B409.f] =
      [1, 1, 1, 1, 1, 1, 1, 1] ∧
    NistCertificates.P224.f = 3 ∧ NistCertificates.Curve25519.f = 2 ∧ NistCertificates.Curve448.f = 2
NistCertificates.koblitz_discriminants : ∀ (c : NistCertificates.ScanCert),
  c ∈ NistCertificates.scanCerts → c.t ^ 2 - 4 * c.q = c.DK * c.f ^ 2 ∧ IsFundamental c.DK ∧ minNonscalarDegree c.DK = 2
Koblitz.koblitz_certificates : ∀ (c : Koblitz.KCert),
  c ∈ Koblitz.koblitzCerts →
    c.Holds ∧
      Koblitz.Zt.norm c.μ (Koblitz.Zt.one.sub (Koblitz.Zt.pow c.μ Koblitz.Zt.tau c.m)) = c.h * c.n ∧
        Koblitz.Zt.norm c.μ c.δ * Koblitz.Zt.norm c.μ (Koblitz.Zt.tau.sub Koblitz.Zt.one) = c.h * c.n
Koblitz.norm_delta : ∀ (μ : Int) (m : Nat) (δ : Koblitz.Zt),
  Koblitz.Zt.mul μ δ (Koblitz.Zt.tau.sub Koblitz.Zt.one) = (Koblitz.Zt.pow μ Koblitz.Zt.tau m).sub Koblitz.Zt.one →
    Koblitz.Zt.norm μ δ * (3 - μ) = 2 ^ m + 1 - Koblitz.lucasV μ m
Koblitz.norm_one_sub_tau_pow : ∀ (μ : Int) (m : Nat),
  Koblitz.Zt.norm μ (Koblitz.Zt.one.sub (Koblitz.Zt.pow μ Koblitz.Zt.tau m)) = 2 ^ m + 1 - Koblitz.lucasV μ m
Koblitz.min_norm_nonscalar : ∀ (μ : Int),
  μ = 1 ∨ μ = -1 →
    (∀ (x : Koblitz.Zt), x.b ≠ 0 → 2 ≤ Koblitz.Zt.norm μ x) ∧
      Koblitz.Zt.norm μ Koblitz.Zt.tau = 2 ∧ minNonscalarDegree (-7) = 2
Koblitz.ztau_iso_order_neg_seven : ∀ (μ : Int),
  μ = 1 ∨ μ = -1 →
    (∀ (x y : Koblitz.Zt),
        Koblitz.toOmega μ (Koblitz.Zt.mul μ x y) = Koblitz.mulOmega7 (Koblitz.toOmega μ x) (Koblitz.toOmega μ y)) ∧
      (∀ (y : Koblitz.Zt), ∃ x, Koblitz.toOmega μ x = y) ∧
        (∀ (x y : Koblitz.Zt), Koblitz.toOmega μ x = Koblitz.toOmega μ y → x = y) ∧
          ∀ (x : Koblitz.Zt), Koblitz.Zt.norm μ x = norm (-7) (Koblitz.toOmega μ x).a (Koblitz.toOmega μ x).b
