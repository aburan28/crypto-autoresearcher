digraph p192_weighted_cm {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.32", ranksep="0.42",
         fontname="DejaVu Sans", label="P-192 weighted-CM protocol — all scientific stages pending",
         labelloc="t", fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#315a9b",
        fontname="DejaVu Sans", fontsize=10, margin="0.11,0.07"];
  edge [color="#526275", fontname="DejaVu Sans", fontsize=9];

  identity [label="Identity/order gate\nP-192 tuple · ICV1 · EC1 · UID\nD fundamental · conductor 1"];
  boxes [label="Centered primitive boxes\n4N=x²+|D|v²\n3 exact disjoint shells"];
  sieve [label="Norm sieve\ncomplete / 1-LP / 2-LP\nB_sieve=65,521"];
  recombine [label="Exact cancellation\nLP kernel + high-column kernel\nB_map=113; admitted map manifest empty"];
  solve [label="Cost-blind structural panel\nproved LLL · bounded BKZ · ILP\nhash frozen before costs"];
  maps [label="Map every frozen panel member\nraw HOT/COLD_TOTAL Pareto · Q32 display rank\nterminal F_p-isomorphism"];
  subgroup [label="Pre-holdout transfer certificate\norder-n subgroup · λ=u+v mod n\ngeneric proof + G replay"];
  payoff [label="BLOCKED payoff/target gate\nconsumer amendment · planted Q replay\ntwo independent replications",
          fillcolor="#ffe8e8", color="#9b3b3b"];
  claim [label="Claim ladder\nrelation ≠ weakness\n≥1-bit conservative loss required",
         fillcolor="#fff2cc", color="#9a6b00"];

  controls [shape=note, label="Controls at every gate\nD=-23 positive · sqrt(D) partial\nramified squares · mutations · A/A",
            fillcolor="#e8f7e8", color="#39733d"];
  archive [shape=folder, label="Immutable archive\nraw rows · maps · costs · receipts\nSHA-256 manifest + report",
           fillcolor="#f3eafa", color="#744c8a"];

  identity -> boxes -> sieve -> recombine -> solve -> maps -> subgroup -> payoff -> claim;
  controls -> identity [style=dashed];
  controls -> sieve [style=dashed];
  controls -> recombine [style=dashed];
  controls -> maps [style=dashed];
  controls -> payoff [style=dashed];
  boxes -> archive [style=dotted];
  recombine -> archive [style=dotted];
  maps -> archive [style=dotted];
  payoff -> archive [style=dotted];
}
