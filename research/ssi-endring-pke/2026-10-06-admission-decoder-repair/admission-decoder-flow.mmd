flowchart LR
  BG["PROPOSED / inherited<br/>BaseGen: p,E, evaluable End(E)"]
  KG["DERIVED<br/>KeyGen sampling<br/>ord(P)=N; ordered D-basis"]
  PRE["DERIVED<br/>PUBLIC PreAdmit<br/>canonical tags + exact orders<br/>+ full-order Weil pairing"]
  ENC["DERIVED<br/>Honest Encrypt<br/>K=U+sV; a normalized 2-isogenies"]
  CT["DERIVED<br/>Exact ciphertext<br/>(C, full signed X)"]
  EV["OPEN / not constructed<br/>exact map or uniform Eval2"]
  OUT["CONDITIONAL INPUT<br/>A0=f(U), B0=f(V)"]
  POST["DERIVED<br/>POST-evaluation admission<br/>ord(B0)=D; ord(H)=2^k"]
  DEC["DERIVED<br/>checked 2-power decoder<br/>G=[m]H; final recheck"]
  MSG["DERIVED conditionally<br/>selected message m"]
  CTRL["SYMBOLIC CONTROLS<br/>P=0, V=0, nonbasis,<br/>x-only, retagged, supplied f"]

  BG --> KG --> PRE
  KG --> ENC --> CT --> PRE
  PRE -. "separate obligation" .-> EV
  EV -. "if semantically correct" .-> OUT
  OUT --> POST --> DEC --> MSG
  CTRL --> PRE
  CTRL --> POST

  classDef derived fill:#dbeafe,stroke:#1d4ed8,color:#102a56,stroke-width:2px;
  classDef proposed fill:#fef3c7,stroke:#b45309,color:#5b2c06,stroke-width:2px,stroke-dasharray:6 4;
  classDef open fill:#fee2e2,stroke:#b91c1c,color:#5f1010,stroke-width:3px,stroke-dasharray:8 5;
  classDef conditional fill:#ede9fe,stroke:#6d28d9,color:#301060,stroke-width:2px;
  classDef control fill:#f3f4f6,stroke:#4b5563,color:#1f2937,stroke-width:2px;

  class KG,PRE,ENC,CT,POST,DEC derived;
  class BG proposed;
  class EV open;
  class OUT,MSG conditional;
  class CTRL control;
