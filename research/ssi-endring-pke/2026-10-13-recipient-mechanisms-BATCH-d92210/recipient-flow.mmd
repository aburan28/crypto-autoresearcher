flowchart TB
  G["Goal: novel EndRing PKE<br/>QPT/QROM secure; NIST Category 5 target"]

  subgraph M1["M1 — LABELLED-NORM-HOM-LIFT"]
    M1S["Public sender<br/>a=m+Mr; K_a=&lt;P+[a]Q&gt;"] --> M1C["Ciphertext<br/>c=j(E/K_a)"]
    M1B["Secret complete evaluable<br/>End(E) basis B"] -. "MISSING: construct complete Hom(E,C)" .-> M1H["Enumerate complete norm-L fiber"]
    M1C -. "MISSING: exact polynomial lift" .-> M1H
    M1H -. "MISSING: singleton residue bound" .-> M1M["Actual selected message m"]
    M1P["Public O(L) reference enumeration"] --> M1M
  end

  subgraph M2["M2 — simultaneous full-module conjugation"]
    M2S["Public sender<br/>X=SUS^-1; Y=SVS^-1"] --> M2C["Ciphertext (X,Y,v)"]
    M2C --> M2L["PUBLIC solve<br/>XT=TU; YT=TV"]
    M2L --> M2N["Recover N(S)"]
    M2N --> M2M["Recover actual message<br/>one H query; zero Dec queries"]
    M2B["Secret ring basis W"] -. "BYPASSED" .-> M2L
  end

  G --> M1S
  G --> M2S

  subgraph RED["Required security direction — not established"]
    ERCH["Complete-EndRing challenge<br/>exact real key law"] -. "MISSING exact-law simulator" .-> CH["Challenge transcript"]
    CH --> ADV["Successful QPT PKE attacker"]
    ADV -. "MISSING extractor + loss" .-> ER["Complete evaluable saturated End(E)"]
  end

  M1M -. "no reduction" .-> ADV
  M2M --> FAIL["Passive confidentiality break"]
  ER -. "attack direction only;<br/>not a security proof" .-> M1H
  ER -. "irrelevant to public break" .-> M2L
  M1H -. "no eligible parameter set" .-> C5["NIST Category 5<br/>UNESTABLISHED"]
  FAIL --> C5

