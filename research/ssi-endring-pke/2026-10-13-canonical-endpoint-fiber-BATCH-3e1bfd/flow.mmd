flowchart LR
  subgraph Honest["Conditional CEFC-PKE data flow"]
    S["Public sender\nE, m, coins rho"] -->|"WalkSample (abstract)"| W["walk w"]
    W --> F["endpoint C = F_E(w)"]
    W --> I["x = sum EdgeLabel(e)\nEdgeLabel missing"]
    F --> CT["ciphertext (C, m xor H(ctx,x))"]
    I --> CT
    SK["secret W_E:\ncomplete evaluable End(E)"] -.->|"RingPotential missing"| XR["recipient x"]
    F --> XR
    XR --> D["decrypt"]
    CT --> D
  end

  I -.->|"fiber theorem missing"| XR
  SMALL["public / path / EvalLine /\nfinite action / cache / opaque decoder"] -.->|"not excluded"| XR

  A["successful PKE attacker"] -.->|"extractor missing"| ER["complete evaluable\nsaturated End(E) basis"]
  ER -->|"reverse direction only"| SK

  CT --> CCA["query (C, v xor Delta)"]
  CCA --> OUT["Dec returns m_b xor Delta"]
  OUT --> BREAK["recover m_b\nIND-CCA2 advantage 1/2"]

  classDef defined fill:#e8f1fb,stroke:#245b8f,color:#17324d,stroke-width:2px;
  classDef missing fill:#fff1f1,stroke:#bd2c2c,color:#671515,stroke-width:2px,stroke-dasharray: 7 5;
  classDef attack fill:#fff3df,stroke:#c66a00,color:#6e3b00,stroke-width:2px;
  class S,W,F,CT,SK,D defined;
  class I,XR,SMALL,A,ER missing;
