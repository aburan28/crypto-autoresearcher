flowchart LR
    I["Exact input<br/>O=End(E), E,C/F_(p^2)<br/>P in E[N], X in C[N]<br/>D=2^a, N&gt;4D, U,V,k"]
    UQ["[DERIVED] uniqueness only<br/>full signed X + N&gt;4D<br/>identifies at most one f"]
    A["[DERIVED] Route A<br/>2D orbit equations<br/>Padé reconstruct dense f"]
    AC["[DERIVED] cost<br/>Theta(D) samples/output<br/>exponential in a"]
    B["[DERIVED] Route B<br/>forward/backward 2-isogenies<br/>labelled midpoint join"]
    BC["[DERIVED] cost<br/>Theta(2^(a/2)) states<br/>time and memory"]
    C["[PROPOSED] Route C<br/>primitive cyclic norm-D ideal<br/>exact C,X calibration"]
    CM["UNRESOLVED INTERFACE<br/>CALIBRATED_IDEAL_REALIZE"]
    T["[PROPOSED] evaluator-only<br/>return f(U),f(V), not dense f"]
    TM["UNRESOLVED INTERFACE<br/>MISSING_SUBLINEAR_ORBIT_EVALUATOR"]
    F["[DERIVED, conditional]<br/>certified evaluated f<br/>or exact f(U),f(V)"]
    D["[DERIVED] decoder<br/>H=[2^(a-k)]f(V)<br/>G=-[2^(a-k)]f(U)=[m]H"]
    M["Actual message<br/>m=s mod 2^k"]
    Z["Round outcome<br/>0 finalists<br/>0 measured scientific results"]

    I -->|"[DERIVED] degree bound"| UQ
    I -->|"[DERIVED] orbit samples"| A
    A -->|"[DERIVED] dense accounting"| AC
    A -->|"[DERIVED] executable but exponential"| F
    I -->|"[DERIVED] chain enumeration"| B
    B -->|"[DERIVED] branch accounting"| BC
    B -.->|"[PROPOSED] only after exponential join"| F
    I -.->|"[PROPOSED] algebraic selection"| C
    C -.->|"[PROPOSED] required realization"| CM
    CM -.->|"[PROPOSED] if instantiated"| F
    I -.->|"[PROPOSED] transposed challenge"| T
    T -.->|"[PROPOSED] required theorem"| TM
    TM -.->|"[PROPOSED] if instantiated"| F
    F -->|"[DERIVED] two evaluations"| D
    D -->|"[DERIVED] checked binary slope"| M
    AC --> Z
    BC --> Z
    CM --> Z
    TM --> Z

    classDef input fill:#eef4ff,stroke:#315b8a,color:#10243b,stroke-width:2px;
    classDef derived fill:#d9ecff,stroke:#2166ac,color:#0b2e4f,stroke-width:2px;
    classDef proposed fill:#fff0c2,stroke:#ad6b00,color:#513300,stroke-width:2px,stroke-dasharray: 5 4;
    classDef missing fill:#ffe0e0,stroke:#b42318,color:#64110d,stroke-width:2px;
    classDef output fill:#dcf4e4,stroke:#237a45,color:#123d25,stroke-width:2px;
    class I input;
    class UQ,A,AC,B,BC,F,D derived;
    class C,T proposed;
    class CM,TM missing;
    class M,Z output;
