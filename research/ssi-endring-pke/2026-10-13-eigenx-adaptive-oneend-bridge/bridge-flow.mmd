%% EigenX/CEST adaptive-OneEnd bridge and reduction boundary.
%% Status language is copied from BATCH-44a1ce final composition.
%%{init: {
  "theme": "base",
  "flowchart": {"curve": "basis", "htmlLabels": true, "nodeSpacing": 28, "rankSpacing": 38, "wrappingWidth": 270},
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "16px",
    "lineColor": "#64748b",
    "primaryTextColor": "#172033",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#94a3b8",
    "background": "#ffffff"
