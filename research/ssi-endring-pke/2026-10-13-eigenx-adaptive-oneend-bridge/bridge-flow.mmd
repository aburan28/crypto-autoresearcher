}}%%
flowchart TB
  E["Bare EndRing challenge<br/><b>E without W</b>"]
  PK["Exact real EigenX public key<br/><b>pk includes A = psi_E(P)</b>"]
  ADV["Successful IND-CPA attacker<br/><b>exact single-user classical-ROM view</b>"]
  KI["CEST-XFER-KI distinguisher<br/><b>separate intermediate assumption</b>"]
  XFER["Scalar-transfer point<br/><b>T = [r]A</b>"]
  LINE["Reachable-line evaluator<br/><b>[x]P maps to [x]A</b>"]
  PSI["Global endomorphism evaluator<br/><b>psi_E : E to E</b>"]
  ONE["OneEnd on initial E<br/><b>one bounded non-scalar map</b>"]
  ADAPT["Adaptive bounded-OneEnd oracle<br/><b>all reachable PW24 query curves</b>"]
  RING["Complete EndRing output<br/><b>evaluable rank-four Z-basis</b>"]

  E -. "OPEN RB-01: exact real-key embedding needs W or equivalent evaluator" .-> PK
  PK --> ADV
  ADV -->|"reviewed conditional hybrid; exact-law classical ROM only"| KI
  KI -. "candidate transfer is uniquely recognizable; complete extraction not promoted" .-> XFER
  XFER -. "OPEN RB-05: one-shot output is not reusable code" .-> LINE
  LINE -. "OPEN RB-06: strict evaluator quotient" .-> PSI
  PSI -->|"conditional type conversion"| ONE
  ONE -. "OPEN RB-08: no every-prefix adaptive coverage" .-> ADAPT
  ADAPT -->|"source-supported conditional: PW24 Algorithm 3"| RING

  subgraph B["Submitted public bridge portfolio"]
    direction TB
    I1["I1 pointwise-total direct<br/><b>INCONCLUSIVE</b><br/>constructor and total bounds absent"]
    I2["I2 conditional-law compiler<br/><b>INCONCLUSIVE</b><br/>every-prefix law and stopping tail absent"]
    I3["I3 path pushforward<br/><b>BREAKS in scope</b><br/>path-correlated; pullback = [deg(phi)^2] alpha<br/>singleton support keeps rank at most 2"]
    I1 ~~~ I2
    I2 ~~~ I3
  end
  I1 -. "not admitted" .-> ADAPT
  I2 -. "not admitted" .-> ADAPT
  I3 -. "not a source-compatible oracle" .-> ADAPT

  RING -. "REVERSE ATTACK ROUTE ONLY: complete EndRing solver can decrypt" .-> DEC["EigenX decryption<br/><b>not a security reduction</b>"]
  DEC --> GATES["INDEPENDENT OWNER VERDICTS<br/><b>J1 HOLDS</b> — exact adaptive source-oracle contract only<br/><b>J2 BREAKS</b> — portfolio-wide construction proposition<br/><b>J3 BREAKS</b> — portfolio-wide whole-transcript bound<br/><b>J4 BREAKS</b> — attacker-to-complete-ring reduction absent<br/><b>J5 BREAKS</b> — only O3 has reviewed discharge"]
  GATES --> OUT["ROUND OUTCOME<br/><b>0 bridge survivors</b><br/>EigenX construction not established<br/>no universal impossibility"]
  OUT --> NEXT["ONE NONAUTOMATIC NEXT ACTION<br/>rerank one materially different EndRing recipient mechanism<br/>with ring-identifying behavior beyond EvalLine(P,A)"]

  classDef source fill:#e7f5ec,stroke:#237a3b,color:#153d23,stroke-width:2px;
  classDef open fill:#fff4d6,stroke:#ad7200,color:#5b3b00,stroke-width:2px;
  classDef breaks fill:#fde8e7,stroke:#b8322a,color:#5c1713,stroke-width:2px;
  classDef neutral fill:#eef2f7,stroke:#64748b,color:#172033,stroke-width:1.5px;
  classDef decision fill:#f2eafd,stroke:#7048a8,color:#372055,stroke-width:2px;
  classDef next fill:#e6f6f5,stroke:#18726d,color:#0f4441,stroke-width:2px;

  class ADAPT,RING source;
  class E,PK,KI,XFER,LINE,PSI,ONE,I1,I2 open;
  class I3,DEC,GATES breaks;
  class ADV neutral;
  class OUT decision;
  class NEXT next;
