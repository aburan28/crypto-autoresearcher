+    fn exact_basis_products_squares_edges_and_inverse_corpus() {
+        let curve = KoblitzCurve::new(0, 53).unwrap();
+        assert!(arm_n53_fused_enabled(&curve));
+        for i in 0..53 {
+            let left = 1u64 << i;
+            assert_eq!(square_raw(&curve, left), oracle_mul(left, left));
+            for j in 0..53 {
+                let right = 1u64 << j;
+                assert_eq!(mul_raw(&curve, left, right), oracle_mul(left, right));
+            }
+        }
+        let even = (0..53).step_by(2).fold(0u64, |v, i| v | (1u64 << i));
+        let odd = (1..53).step_by(2).fold(0u64, |v, i| v | (1u64 << i));
+        let edges = [0, 1, (1u64 << 53) - 1, even, odd];
+        for left in edges { for right in edges {
+            assert_eq!(mul_raw(&curve, left, right), oracle_mul(left, right));
+            assert_eq!(square_raw(&curve, left), oracle_mul(left, left));
+        }}
+        for value in corpus() {
+            let inverse = inverse_raw(&curve, value);
+            assert_eq!(inverse, oracle_inverse(value));
+            assert_eq!(oracle_mul(value, inverse), 1);
+        }
+    }
