+#[cfg(all(test, target_arch = "aarch64"))]
+mod p4_field_controls {
+    use super::*;
+    use crypto_lib::hash::sha256::sha256;
+
+    fn oracle_product(left: u64, right: u64) -> u128 {
+        let mut product = 0u128;
+        for bit in 0..53 { if (right >> bit) & 1 != 0 { product ^= (left as u128) << bit; } }
+        product
+    }
+    fn oracle_reduce(mut product: u128) -> u64 {
+        let polynomial = (1u128 << 53) | (1u128 << 6) | (1u128 << 2) | (1u128 << 1) | 1;
+        for degree in (53..=104).rev() {
+            if product & (1u128 << degree) != 0 { product ^= polynomial << (degree - 53); }
+        }
+        product as u64
+    }
+    fn oracle_mul(left: u64, right: u64) -> u64 { oracle_reduce(oracle_product(left, right)) }
+    fn oracle_inverse(value: u64) -> u64 {
+        assert_ne!(value, 0);
+        let mut result = 1u64; let mut base = value;
+        const EXPONENT: u64 = (1u64 << 53) - 2;
+        for bit in 0..53 {
+            if EXPONENT >> bit & 1 != 0 { result = oracle_mul(result, base); }
+            base = oracle_mul(base, base);
+        }
+        result
+    }
+    fn corpus() -> Vec<u64> {
+        use num_bigint::BigUint;
+        let modulus = BigUint::from((1u64 << 53) - 1);
+        (0..256).map(|index| {
+            let label = format!("CSIC53-ARMCOMPOSE-v1-field-{index:03}");
+            let value = BigUint::from_bytes_le(&sha256(label.as_bytes()));
+            1 + (value % &modulus).to_u64().unwrap()
+        }).collect()
+    }
