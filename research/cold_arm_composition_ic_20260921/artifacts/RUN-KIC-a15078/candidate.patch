+#[cfg(all(test, target_arch = "aarch64"))]
+mod p4_field_controls {
+    use super::*;
+    use crypto_lib::hash::sha256::sha256;
+    use num_traits::ToPrimitive;
+    fn product(left: u64, right: u64) -> u128 {
+        let mut p = 0u128;
+        for bit in 0..53 { if right >> bit & 1 != 0 { p ^= (left as u128) << bit; } }
+        p
+    }
+    fn reduce(mut p: u128) -> u64 {
+        let polynomial = (1u128 << 53) | (1u128 << 6) | (1u128 << 2) | (1u128 << 1) | 1;
+        for degree in (53..=104).rev() {
+            if p & (1u128 << degree) != 0 { p ^= polynomial << (degree - 53); }
+        }
+        p as u64
+    }
+    fn mul(a: u64, b: u64) -> u64 { reduce(product(a,b)) }
+    fn inverse(value: u64) -> u64 {
+        let mut result=1u64; let mut base=value;
+        for bit in 0..53 {
+            if (((1u64<<53)-2)>>bit)&1 != 0 {result=mul(result,base);}
+            base=mul(base,base);
+        }
+        result
+    }
+    #[test]
+    fn basis_edges_sha256_inverse_oracle() {
+        assert!(arm_pmull_enabled());
+        let curve=KoblitzCurve::new(0,53).unwrap();
+        assert!(arm_n53_fused_enabled(&curve));
+        for i in 0..53 {
+            let a=1u64<<i;
+            assert_eq!(raw_square(&curve,a),mul(a,a));
+            for j in 0..53 { let b=1u64<<j; assert_eq!(raw_mul_field(&curve,a,b),mul(a,b)); }
+        }
+        let even=(0..53).step_by(2).fold(0u64,|v,i|v|(1u64<<i));
+        let odd=(1..53).step_by(2).fold(0u64,|v,i|v|(1u64<<i));
+        for a in [0,1,(1u64<<53)-1,even,odd] {
+            for b in [0,1,(1u64<<53)-1,even,odd] {assert_eq!(raw_mul_field(&curve,a,b),mul(a,b));}
+            assert_eq!(raw_square(&curve,a),mul(a,a));
+        }
+        let modulus=BigUint::from((1u64<<53)-1);
+        for index in 0..256 {
+            let label=format!("CSIC53-ARMCOMPOSE-v1-field-{index:03}");
+            let value=1+(BigUint::from_bytes_le(&sha256(label.as_bytes()))%&modulus).to_u64().unwrap();
+            let candidate=raw_inverse(&curve,value);
