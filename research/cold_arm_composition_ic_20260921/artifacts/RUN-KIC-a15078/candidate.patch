+        let denominator = if key_x == 0 { 0 } else { target_x ^ (key_x - 1) };
+        scratch.denominators[index] = denominator;
+        if denominator != 0 {
+            scratch.prefixes_and_inverses[index] = product;
+            product = unsafe { arm_pmull_reduce_n53(product, denominator) };
+        }
+    }
+    let mut inverse_product = unsafe { arm_inverse_n53_itoh(product) };
+    for index in (0..points.len()).rev() {
+        let denominator = scratch.denominators[index];
+        if denominator == 0 { continue; }
+        let inverse = unsafe { arm_pmull_reduce_n53(inverse_product, scratch.prefixes_and_inverses[index]) };
+        inverse_product = unsafe { arm_pmull_reduce_n53(inverse_product, denominator) };
+        scratch.prefixes_and_inverses[index] = inverse;
+    }
