{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aburan28/crypto-autoresearcher/research/p192-weighted-cm-20261007-v2-role2-box0-interface/schemas/role2-dispatch-decision.schema.json",
  "title": "P-192 weighted-CM Role-2 BOX-0 dispatch authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "decision_id", "approved_by", "created_at_utc",
    "execution_authorized", "experiment_id", "protocol_version",
    "planned_run_label", "run_id", "protocol_repository",
    "protocol_commit", "factor_base_source_commit", "producer_commit",
    "verifier_commit", "supervisor_commit", "producer_binary_sha256",
    "verifier_binary_sha256", "supervisor_binary_sha256",
    "predecessor_run_id", "predecessor_artifacts",
    "protected_protocol_blobs", "paths", "producer_fresh_argv",
    "producer_fault_argv", "producer_resume_argv",
    "independent_verifier_argv", "supervisor_argv"
  ],
  "properties": {
    "schema": {"const": "p192-wcm-role2-box0-dispatch-authorization-v1"},
    "decision_id": {"type": "string", "pattern": "^DEC-[0-9]{8}-[0-9a-f]{6}$"},
    "approved_by": {"const": "Coordinator"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "execution_authorized": {"const": true},
    "experiment_id": {"const": "EXP-SCURVE-1a8daf"},
    "protocol_version": {"const": 2},
    "planned_run_label": {"const": "P192-WCM-BOX0"},
    "run_id": {"type": "string", "pattern": "^RUN-SCURVE-[0-9a-f]{6}$"},
    "protocol_repository": {"const": "https://github.com/aburan28/crypto-autoresearcher"},
    "protocol_commit": {"$ref": "#/$defs/commit"},
    "factor_base_source_commit": {"$ref": "#/$defs/commit"},
    "producer_commit": {"$ref": "#/$defs/commit"},
    "verifier_commit": {"$ref": "#/$defs/commit"},
    "supervisor_commit": {"$ref": "#/$defs/commit"},
    "producer_binary_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_binary_sha256": {"$ref": "#/$defs/sha256"},
    "supervisor_binary_sha256": {"$ref": "#/$defs/sha256"},
    "predecessor_run_id": {"type": "string", "pattern": "^RUN-SCURVE-[0-9a-f]{6}$"},
    "predecessor_artifacts": {"$ref": "#/$defs/predecessorArtifacts"},
    "protected_protocol_blobs": {"$ref": "#/$defs/protectedProtocolBlobs"},
    "paths": {"$ref": "#/$defs/paths"},
    "producer_fresh_argv": {"$ref": "#/$defs/producerFreshArgv"},
    "producer_fault_argv": {"$ref": "#/$defs/producerFaultArgv"},
    "producer_resume_argv": {"$ref": "#/$defs/producerResumeArgv"},
    "independent_verifier_argv": {"$ref": "#/$defs/verifierArgv"},
    "supervisor_argv": {"$ref": "#/$defs/supervisorArgv"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "not": {"const": "0000000000000000000000000000000000000000"}
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/)\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)$)[^\\u0000-\\u001f<>]+$"
    },
    "predecessorArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor-base.json", "factor-base.sha256", "verification.json",
        "independent-verification.json", "independent-agreement.json",
        "independent-verifier-receipt.json"
      ],
      "properties": {
        "factor-base.json": {"$ref": "#/$defs/sha256"},
        "factor-base.sha256": {"$ref": "#/$defs/sha256"},
        "verification.json": {"$ref": "#/$defs/sha256"},
        "independent-verification.json": {"$ref": "#/$defs/sha256"},
        "independent-agreement.json": {"$ref": "#/$defs/sha256"},
        "independent-verifier-receipt.json": {"$ref": "#/$defs/sha256"}
      }
    },
    "protectedProtocolBlobs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification.v2.yaml", "protocol-amendment.v2.yaml",
        "run-family.yaml", "v2_addendum_role1_interface.yaml",
        "v2_addendum_role2_box0_interface.yaml",
        "README.md", "check_role2_box0_interface.py",
        "run-family.role2-box0-interface.yaml",
        "role2-artifacts.schema.json",
        "role2-dispatch-decision.schema.json", "SHA256SUMS",
        "test_p192_wcm_role2_interface.py"
      ],
      "properties": {
        "specification.v2.yaml": {"$ref": "#/$defs/sha256"},
        "protocol-amendment.v2.yaml": {"$ref": "#/$defs/sha256"},
        "run-family.yaml": {"$ref": "#/$defs/sha256"},
        "v2_addendum_role1_interface.yaml": {"$ref": "#/$defs/sha256"},
        "v2_addendum_role2_box0_interface.yaml": {"$ref": "#/$defs/sha256"},
        "README.md": {"$ref": "#/$defs/sha256"},
        "check_role2_box0_interface.py": {"$ref": "#/$defs/sha256"},
        "run-family.role2-box0-interface.yaml": {"$ref": "#/$defs/sha256"},
        "role2-artifacts.schema.json": {"$ref": "#/$defs/sha256"},
        "role2-dispatch-decision.schema.json": {"$ref": "#/$defs/sha256"},
        "SHA256SUMS": {"$ref": "#/$defs/sha256"},
        "test_p192_wcm_role2_interface.py": {"$ref": "#/$defs/sha256"}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_repository_path", "protocol_package_path", "decision_json",
        "producer_bin", "verifier_bin", "supervisor_bin",
        "producer_repository_path", "producer_package_path",
        "verifier_repository_path", "verifier_package_path",
        "supervisor_repository_path", "supervisor_package_path",
        "predecessor_dir", "factor_base_json", "run_dir", "control_dir",
        "audit_file"
      ],
      "properties": {
        "protocol_repository_path": {"$ref": "#/$defs/absolutePath"},
        "protocol_package_path": {"$ref": "#/$defs/absolutePath"},
        "decision_json": {"$ref": "#/$defs/absolutePath"},
        "producer_bin": {"$ref": "#/$defs/absolutePath"},
        "verifier_bin": {"$ref": "#/$defs/absolutePath"},
        "supervisor_bin": {"$ref": "#/$defs/absolutePath"},
        "producer_repository_path": {"$ref": "#/$defs/absolutePath"},
        "producer_package_path": {"$ref": "#/$defs/absolutePath"},
        "verifier_repository_path": {"$ref": "#/$defs/absolutePath"},
        "verifier_package_path": {"$ref": "#/$defs/absolutePath"},
        "supervisor_repository_path": {"$ref": "#/$defs/absolutePath"},
        "supervisor_package_path": {"$ref": "#/$defs/absolutePath"},
        "predecessor_dir": {"$ref": "#/$defs/absolutePath"},
        "factor_base_json": {"$ref": "#/$defs/absolutePath"},
        "run_dir": {"$ref": "#/$defs/absolutePath"},
        "control_dir": {"$ref": "#/$defs/absolutePath"},
        "audit_file": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "producerFreshArgv": {
      "type": "array", "minItems": 12, "maxItems": 12, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/absolutePath"}, {"const": "sieve"},
        {"const": "--shell"}, {"const": "BOX-0"},
        {"const": "--v-max"}, {"const": "8"},
        {"const": "--x-max-inclusive"}, {"const": "65536"},
        {"const": "--factor-base"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--out"}, {"$ref": "#/$defs/absolutePath"}
      ]
    },
    "producerFaultArgv": {
      "type": "array", "minItems": 14, "maxItems": 14, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/absolutePath"}, {"const": "sieve"},
        {"const": "--shell"}, {"const": "BOX-0"},
        {"const": "--v-max"}, {"const": "8"},
        {"const": "--x-max-inclusive"}, {"const": "65536"},
        {"const": "--factor-base"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--out"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--control-stop-after-committed-shard"}, {"const": "0"}
      ]
    },
    "producerResumeArgv": {
      "type": "array", "minItems": 13, "maxItems": 13, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/absolutePath"}, {"const": "sieve"},
        {"const": "--shell"}, {"const": "BOX-0"},
        {"const": "--v-max"}, {"const": "8"},
        {"const": "--x-max-inclusive"}, {"const": "65536"},
        {"const": "--factor-base"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--out"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--resume"}
      ]
    },
    "verifierArgv": {
      "type": "array", "minItems": 10, "maxItems": 10, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/absolutePath"}, {"const": "verify-shell"},
        {"const": "--shell"}, {"const": "BOX-0"},
        {"const": "--predecessor"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--source"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--out"}, {"$ref": "#/$defs/absolutePath"}
      ]
    },
    "supervisorArgv": {
      "type": "array", "minItems": 29, "maxItems": 29, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/absolutePath"},
        {"const": "--protocol-repository"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--decision"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--producer"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--verifier"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--producer-repository"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--producer-package"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--verifier-repository"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--verifier-package"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--supervisor-repository"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--supervisor-package"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--predecessor"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--run-dir"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--control-dir"}, {"$ref": "#/$defs/absolutePath"},
        {"const": "--audit-out"}, {"$ref": "#/$defs/absolutePath"}
      ]
    }
  }
}
