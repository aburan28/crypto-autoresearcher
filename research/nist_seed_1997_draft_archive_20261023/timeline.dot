digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", label="Dated sources and the missing selection trace", labelloc=t, fontsize=16, nodesep=0.28, ranksep=0.36];
  node [shape=box, style="rounded,filled", fillcolor="#eef3f8", color="#526578", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#526578"];
  may [label="15–18 May 1997\nreconstructed 192/239 seed runs"];
  aug [label="16 August 1997\nreconstructed P-256 seed run"];
  draft [label="17 November 1997\nX9.62 draft identified in IETF refs", fillcolor="#d7ecdf"];
  final [label="20 September 1998 cover\nPDF encoded 12 January 1999"];
  context [label="27 August 2002\nBaier–Buchmann workflow account", fillcolor="#e8edf9"];
  review [label="12 December 2013\nReview Group weak-class statement", fillcolor="#e8edf9"];
  letters [label="2014–15 correspondence\nReiter named as original coder", fillcolor="#e8edf9"];
  missing [label="1997 draft contents and\noriginal selection trace missing", fillcolor="#fff1ce"];
  may -> aug [label="reconstructed dates"];
  aug -> draft [label="contemporary reference"];
  draft -> final [label="later draft text; exact circulation unknown"];
