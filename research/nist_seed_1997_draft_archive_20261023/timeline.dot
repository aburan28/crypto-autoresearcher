digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", label="Dated public sources and the missing selection trace", labelloc=t, fontsize=16, nodesep=0.20, ranksep=0.22];
  node [shape=box, style="rounded,filled", fillcolor="#eef3f8", color="#526578", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#526578"];
  draft96 [label="31 August 1996\nX9.62 draft cited by later policy", fillcolor="#d7ecdf"];
  runs [label="May–August 1997\nreconstructed seed-stream starts"];
  draft [label="17 November 1997\nX9.62 draft identified by IETF", fillcolor="#d7ecdf"];
  pkix97 [label="21 November 1997\nPKIX profile cites draft; no curve list", fillcolor="#d7ecdf"];
  cover [label="20 September 1998 cover\nX9.62 PDF encoded January 1999"];
  pkix99 [label="1 June 1999\nPKIX revision lists seven prime curves", fillcolor="#d7ecdf"];
  missing [label="1997 draft contents and\noriginal acceptance trace missing", fillcolor="#fff1ce"];
  draft96 -> runs [style=dashed, label="earlier draft; contents missing"];
  runs -> draft [label="reconstructed dates"];
  draft -> pkix97 [label="cited"];
  pkix97 -> cover [style=dashed, label="does not date table"];
  cover -> pkix99 [label="later named-curve list"];
  draft -> missing [style=dashed, label="content not retrieved"];
  pkix99 -> missing [style=dashed, label="no keep/skip log"];
}
