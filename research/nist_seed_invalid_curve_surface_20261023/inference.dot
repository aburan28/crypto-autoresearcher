digraph G {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", label="Invalid-curve surface: exact conclusion and historical gap", labelloc=t, fontsize=17];
  node [shape=box, style="rounded,filled", fillcolor="#eef3f8", color="#526578", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#526578"];
  archived [label="19 archived curves\n11 omitted · 8 published"];
  same [label="Within each field:\nsame p, a = −3; b ≠ 0"];
  formulas [label="Affine short-Weierstrass\naddition omits b"];
  surface [label="Same alternate E_b′ points\nunder unvalidated formulas", fillcolor="#d7ecdf"];
  witness [label="E₀ nonsingular; Q=(0,0)\norder 2 and off each E_b", fillcolor="#d7ecdf"];
  implementation [label="Actual program accepts\nunvalidated input?", fillcolor="#fff1ce"];
  historical [label="Why eleven were skipped?\nstill unknown", fillcolor="#fff1ce"];
  archived -> same [label="exact check"];
  same -> surface [label="conditional on formulas"];
  formulas -> surface [label="algebra"];
  same -> witness [label="Sage checked"];
  witness -> surface [label="one shared witness"];
  implementation -> surface [style=dashed, label="unobserved assumption"];
  surface -> historical [style=dashed, label="does not explain"];
}
