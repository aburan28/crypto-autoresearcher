digraph Prefix {
  graph [rankdir=LR,bgcolor="white",fontname="Helvetica",pad="0.2"];
  node [shape=box,style="rounded,filled",fillcolor="#e7f0fa",color="#325d83",fontname="Helvetica",fontsize=11];
  seed [label="Recovered small seed\nzrstarts: no warm-up"];
  direct [label="Discard 7 outputs"];
  prob [label="zprobprime(v,7)\nbase 2 + 7 random tests"];
  prime [label="zprime(v,8,2)\nbase 2 + 7 random tests"];
  state [label="Same captured state\nafter 7 advances",fillcolor="#e5f1e8",color="#457a4e"];
  point [label="zrandomb(p) point loop\n6/6 published Gx",fillcolor="#e5f1e8",color="#457a4e"];
  history [label="Which call, if any,\nwas used historically?",style="rounded,dashed",color="#99613c",fillcolor="white"];
  seed -> direct;seed -> prob;seed -> prime;
  direct -> state;prob -> state [label="v = p or n"];prime -> state [label="v = p or n"];
  state -> point [label="26-bit limbs"];
  point -> history [style=dashed,color="#99613c"];
}
