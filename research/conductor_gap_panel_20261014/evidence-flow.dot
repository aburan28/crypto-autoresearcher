digraph conductor_gap_evidence {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", label="Conductor-gap evidence gates (2026-10-14)", labelloc=t, ranksep=0.62, nodesep=0.38];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, margin="0.13,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];

  geometry [label="GEOMETRY + FIELD EVIDENCE\nexact D_K, f_pi, prime ell\nsplit type, k; m*k status\n1 concrete-bound + 1 abstract-only / 41 upper", fillcolor="#dceaf8"];
  endpoint [label="ENDPOINT\nactual f_E and equal #E\ncomplete census or sampled model", fillcolor="#e8f2df"];
  map [label="EXECUTABLE TRANSFER\nphi + dual + exceptions\nsubgroup + planted recovery", fillcolor="#fff0cc"];
  action [label="DESTINATION MECHANISM\nbest certified action/attack\nor one-time return to source", fillcolor="#f6e2ef"];
  cost [label="FULL COST\ndiscovery + construction\nmap + solve + recovery\nH=1 and amortized", fillcolor="#f4dddd"];
  stats [label="CONFIDENCE\nclass-clustered pairing\nA/A + null controls\nfamily-wise lower bound", fillcolor="#eadff5"];
  verdict [label="WEAKNESS VERDICT\nrepresentative / transfer / class", fillcolor="#d8eee7"];

  { rank=same; geometry; endpoint; map; action; }
  { rank=same; cost; stats; verdict; }

  geometry -> endpoint [label="does not imply"];
  endpoint -> map [label="does not imply"];
  map -> action [label="permits testing"];
  action -> cost [label="must beat incumbent"];
  cost -> stats [label="repeat + censor"];
  stats -> verdict [label="all gates pass"];

  missing [shape=note, label="CURRENT NIST K STATUS\n15 exact prime directions\n0 full map+dual+subgroup+cost rows", fillcolor="#fff8e8"];
  missing -> map [style=dashed, color="#a36a00", label="open obligation"];
}
