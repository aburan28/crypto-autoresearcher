digraph chronology {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.4", ranksep="0.65", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#52657a", fillcolor="#edf3f9"];
  edge [color="#52657a", arrowsize=0.7, penwidth=1.4];
  draft96 [label="21 Jun 1996\nX9.62 draft date cited\nby NIST SP 800-15", fillcolor="#d6ebfa"];
  may97 [label="15 and 18 May 1997\nreconstructed prime-seed\nstream starts", fillcolor="#e9f1d8"];
  draft97 [label="11 Jun 1997\nX9.62 draft date cited\nby 1998 implementation paper", fillcolor="#d6ebfa"];
  aug97 [label="Aug 1997\nother reconstructed\nprime-seed starts", fillcolor="#e9f1d8"];
  nist98 [label="Jan 1998\nNIST SP 800-15\npublished", fillcolor="#f3e8d4"];
  unknown [label="Original generator rule\nand rejection trace\nnot recovered", fillcolor="#fff0e7", color="#b56b50"];
  draft96 -> may97 [label="earlier date"];
  may97 -> draft97;
  draft97 -> aug97;
  aug97 -> nist98;
  draft96 -> nist98 [label="citation", constraint=false];
  draft96 -> unknown [style=dashed, color="#b56b50", label="possible influence\nunverified"];
}
