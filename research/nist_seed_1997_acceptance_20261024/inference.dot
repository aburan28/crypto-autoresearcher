digraph acceptance {
  graph [rankdir=TB, bgcolor="white", label="Which filter produces the eleven?", labelloc=t, fontsize=19];
  node [shape=box, style="rounded,filled", fillcolor="#eef4f8", color="#527187", fontname="Helvetica", fontsize=12];
  input [label="Six recovered 20-byte streams\n21,753 positions up to published anchors"];
  prime [label="69 seed positions with certified\nprime full order (82 root branches)"];
  draft [label="All 69 meet listed numerical\nchecks of November 1997 draft"];
  narrow [label="Retrospective root and\norder-width screen"];
  eleven [label="11 named omissions\n+ 10 published", fillcolor="#fff2d8"];
  other [label="48 more unpublished:\n17 wider orders + 31 other-root only", fillcolor="#e4f3e7"];
  historical [label="Historical visitation and\nchoice remain unknown", style="rounded,dashed", fillcolor="white"];
  input -> prime [label="inherited exact census"];
  prime -> draft [label="dated SHA-1 and controls"];
  draft -> narrow [label="extra retrospective filters"];
  narrow -> eleven;
  draft -> other;
  historical -> eleven [style=dashed, label="unproven selection edge"];
  {rank=same; narrow; other}
}
