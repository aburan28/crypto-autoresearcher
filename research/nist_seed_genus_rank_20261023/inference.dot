digraph genus_rank {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", label="CM genus-rank screen: exact arithmetic, no selector", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#556274", fillcolor="#f4f7fb"];
  edge [color="#52606d", fontname="Helvetica", fontsize=10];
  factors [label="Certified factorizations\nof 19 Frobenius discriminants"];
  fundamental [label="Fundamental CM discriminants\nD_K = Delta_pi / f_pi²"];
  theorem [label="Genus theorem\n2-rank = number of prime divisors - 1", fillcolor="#e8f4ec"];
  overlap [label="Omitted and published ranks\noverlap at 2, 3, 4", fillcolor="#e8f4ec"];
  unknown [label="Historical selector and\nECDLP advantage unknown", fillcolor="#fff3e3", style="rounded,filled,dashed"];
  factors -> fundamental -> theorem -> overlap;
  overlap -> unknown [style=dashed, label="does not establish"];
}
