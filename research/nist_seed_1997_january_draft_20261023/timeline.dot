digraph chronology {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.3", ranksep="0.38", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#52657a", fillcolor="#edf3f9"];
  edge [color="#52657a", arrowsize=0.7, penwidth=1.4];
  june96 [label="21 June 1996 X9.62 draft\ncited by NIST SP 800-15", fillcolor="#d6ebfa"];
  jan97 [label="15 January 1997 X9.62 draft\ncited by USPS PCIBI-C", fillcolor="#d6ebfa"];
  may97 [label="15 and 18 May 1997\nreconstructed prime-seed starts", fillcolor="#e9f1d8"];
  june97 [label="11 June 1997 X9.62 draft\ncited by 1998 implementation paper", fillcolor="#d6ebfa"];
  unknown [label="Curve-selection rule and\noriginal rejection trace: missing", fillcolor="#fff0e7", color="#b56b50"];
  june96 -> jan97 -> may97 -> june97;
  jan97 -> unknown [style=dashed, color="#b56b50", label="historical influence unverified", constraint=false];
}
