digraph provenance {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", label="Prime-order decision paths: text versus missing 1997 execution", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#476477", fillcolor="#edf4f8"];
  a [label="1997 §F.2.2\nprobable-prime acceptance"];
  b [label="1997 §F.2.3\noptional GKA certificate path"];
  c [label="1998 §A.2.1–2\nprobable-prime acceptance;\nexternal alternative tests allowed"];
  d [label="21 archived prime orders\n11 omitted, 10 published", fillcolor="#e7f4eb", color="#398354"];
  e [label="Hypothetical old-code\ncertificate timeout / error", fillcolor="#fff0db", color="#bd7925"];
  f [label="Unknown keep/skip decisions", fillcolor="#f8e7e7", color="#b45757"];
  a -> d [label="necessary arithmetic gate passes"];
  c -> d [label="necessary arithmetic gate passes"];
  b -> e [style=dashed, color="#bd7925", label="only if actually invoked"];
  e -> f [style=dashed, color="#bd7925", label="would require logs and matched replay"];
  d -> f [style=dotted, color="#b45757", label="arithmetic alone does not decide"];
}
