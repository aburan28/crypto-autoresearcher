digraph reconciliation {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=18, labelloc=t, label="Public-table reconciliation", nodesep=0.35, ranksep=0.35];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=15, fillcolor="#eef4f8", color="#587588", margin="0.18,0.12"];
  edge [fontname="Helvetica", fontsize=12];
  a [label="Pinned 2026 public table\n19 seeds, orders and traces"];
  b [label="Sage-verified Δ symbols\nElkies / Atkin / ramified", fillcolor="#e7f3eb", color="#43825a"];
  c [label="31 ramified entries below 100\nlisted with Elkies in 16 rows", fillcolor="#fff0df", color="#b87e38"];
  d [label="One integer threshold + E/R\nreproduces 19 reported cutoffs", fillcolor="#fff0df", color="#b87e38"];
  e [label="Source author's implementation\nand 1997 program still unknown", fillcolor="#f9e9e8", color="#b96862"];
  a -> b [label="seeds, n, t match"];
  b -> c;
  b -> d;
  c -> d [label="possible convention"];
  d -> e [style=dashed, label="arithmetic fit does not prove code"];
}
