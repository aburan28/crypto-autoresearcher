digraph nist2014 {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=18, label="What the 2014 NIST record actually bounds", labelloc=t, ranksep=0.5];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14, margin="0.18,0.13", fillcolor="#eef4f8", color="#587588"];
  a [label="1997–98 generation\nOriginal candidate log unavailable", fillcolor="#fff0df", color="#b87e38"];
  b [label="2000 published parameters\nSeed-to-coefficient relation verifiable", fillcolor="#e7f3eb", color="#43825a"];
  c [label="2014 NIST review\nSeed attempt count could not be stated", fillcolor="#e7f3eb", color="#43825a"];
  d [label="2026 reconstructed prefixes\n21,753 windows; 21 qualifying blocks (10 published, 11 omitted)", fillcolor="#e7f3eb", color="#43825a"];
  e [label="Still missing\nTotal attempts and per-block 1997 decisions", fillcolor="#f9e9e8", color="#b96862"];
  a -> b [label="published result"];
  b -> c [label="retrospective account"];
  c -> d [label="later reconstruction adds observed windows"];
  d -> e [style=dashed, label="no complete execution trace"];
}
