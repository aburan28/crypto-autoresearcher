digraph workflow {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=18, label="A fixed two-cost workflow hypothesis", labelloc=t, ranksep=0.4, size="5,4.6!"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14, margin="0.17,0.12", fillcolor="#eef4f8", color="#587588"];
  a [label="19 exact same-field curve identities\n11 omitted + 8 published", fillcolor="#e7f3eb", color="#43825a"];
  b [label="Frozen earlier-omission pairs\n16 of 25 within-field pairs"];
  c [label="Strict Elkies cutoff\nLower is an optimistic count proxy"];
  d [label="n−1 proof structure\nFactor bits or component count"];
  e [label="Earlier omitted dominates later published\n5/16 by factor bits; 13/16 by components", fillcolor="#fff0df", color="#b87e38"];
  f [label="Original 1997 decision still unknown\nNo subgroup weakness inferred", fillcolor="#f9e9e8", color="#b96862"];
  a -> b;
  b -> c;
  b -> d;
  c -> e;
  d -> e;
  e -> f [style=dashed, label="proxy failure is not historical attribution"];
}
