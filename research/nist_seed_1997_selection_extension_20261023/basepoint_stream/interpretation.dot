digraph direct_stream {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.6", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#f4f7fb", color="#6583a5", fontname="Helvetica", fontsize=11, margin="0.14,0.10"];
  edge [color="#6583a5", arrowsize=0.7];
  clock [label="1997–98 timestamp\nsrand48 state"];
  bytes [label="Successive high bytes\nof lrand48 states"];
  seed [label="Published 20-byte seed\nmatched at exact ordinal", fillcolor="#e5f4e9", color="#3f8862"];
  gx [label="Published Gx as contiguous\nbig-endian bytes: 0/10 matches", fillcolor="#fcefe9", color="#b07551"];
  unknown [label="Different generator, encoding,\nstate handling, or software rule\nremains unobserved", style="rounded,dashed", fillcolor="white"];
  clock -> bytes;
  bytes -> seed [label="positive control"];
  bytes -> gx [label="bounded direct search"];
  gx -> unknown [style=dashed, label="does not identify"];
}
