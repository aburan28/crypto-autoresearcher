digraph screen {
  graph [rankdir=LR, bgcolor="white", labelloc=t, label="Small-prime signature: exact structure and limited inference", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4f8", color="#567184", fontname="Helvetica"];
  a [label="19 archived p,n pairs\n11 omitted + 8 published"];
  b [label="Exact trace t and\nFrobenius discriminant Δ"];
  c [label="3,173 checked\nsmall-prime symbols", fillcolor="#e6f3ea", color="#42845a"];
  d [label="Elkies-only CRT proxy\n24 / 25 pairs favor omissions", fillcolor="#e6f3ea", color="#42845a"];
  e [label="1997 point-counter\ncode + time limits missing", fillcolor="#fff0db", color="#b87d2a"];
  f [label="Shared weak-curve criterion\nnot established", fillcolor="#f8e7e7", color="#b55d5d"];
  a -> b -> c -> d;
  d -> e [style=dashed, label="runtime inference unsupported"];
  e -> f [style=dashed, label="requires actual keep/skip trace"];
}
