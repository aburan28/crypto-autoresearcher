// Isogeny volcano of ECC2K-130 (E: y^2+xy=x^3+1 over F_2^131 = F_2[x]/(x^131+x^8+x^3+x^2+1)), a2 = 0 class.
// Frobenius conductor f_pi = [O_K : Z[pi]] = 263 * 146505763881528721; K = Q(sqrt(-7)), h(O_K) = 1.
// Solid edge  = isogeny computed here, endpoint verified (#E = N by ellcard; twist 263-part; 11-cycle length).
// Dashed edge = isogeny that exists by volcano theory but cannot be written down (see report).
// Render: dot -Tsvg volcano_ecc2k130.dot -o volcano_ecc2k130.svg
digraph ecc2k130 {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.6, ranksep=1.0, bgcolor="white",
         label="ECC2K-130 isogeny class: conductor-changing prime-degree isogenies (solid: computed + verified; dashed: exist, not computable)", labelloc=t];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#52514e"];
  edge  [fontname="Helvetica", fontsize=9, color="#52514e"];

  crater [fillcolor="#fbe0d3", label="CRATER  f = 1   End = O_K\nECC2K-130: E_1 : y^2+xy = x^3+1  (b = 1, j = 1)\n1 curve; Frobenius tau (deg 2) in End\ntwist 263-part (Z/263)^2; 11-cycle 1 (measured)"];
  f263 [fillcolor="#d2f0e4", label="263-FLOOR  f = 263\n262 curves = 2 Galois orbits of 131 (all computed, floor263.txt)\nreps b' = 0x3415808f755dad3868860b0a0fb8103, 0xa05d3c82ee7321154f4f4fd13cea070 (a2 = 0)\nall #E = N (ellcard); twist 263-part Z/263^2 (all 262); 11-cycle 131 (all 262)"];
  fbig [fillcolor="#eeecf9", label="146505763881528721-FLOOR  f = 1.465e17\n146,505,763,881,528,722 curves\nno curve computable (2^-74 of all b; H_{-7 f^2} has degree 1.5e17)"];
  bottom [fillcolor="#ecebe8", label="BOTTOM  f = 263 * 146505763881528721   End = Z[pi]\n38,384,510,136,960,525,164 curves (2^65.06)\nno curve computable: a random b lies in the class w.p. 2^-66, and every route to it from a known curve needs a 1.465e17-isogeny"];

  crater -> crater [label="263, horizontal x2\n(back to E; 263 splits, h = 1)", style=solid, color="#888888"];
  crater -> f263   [label="263, descending x262\nkernel x-coords in F_2^131 (twist; pi = -1 on E[263])\nchar-2 Velu b' = 1+v+v^2   COMPUTED (all 262)", penwidth=2, color="#1baf7a"];
  crater -> fbig   [label="146505763881528721, descending\nx 1.465e17; kernel x-coords in F_2^(8.0e17)\nkernel poly deg 7.3e16 (1.2 EB)   NOT COMPUTABLE", style=dashed, color="#4a3aa7"];
  f263   -> bottom [label="146505763881528721, descending\nNOT COMPUTABLE", style=dashed, color="#4a3aa7"];
  fbig   -> bottom [label="263, descending\nendpoints not computable", style=dashed, color="#1baf7a"];
  {rank=same; f263; fbig;}
}
