// Which conductor levels of each Koblitz isogeny class were reached, and by which route.
// Solid green: computed, endpoints verified. Blue: computed by the CM route (class polynomial mod 2). Grey dashed: exists, out of reach.
digraph reach {
  rankdir=TB; newrank=true; nodesep=0.25; ranksep=0.45;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];
  subgraph cluster_131 { label="m = 131, a = 0 (ECC2K-130)"; fontname="Helvetica-Bold"; fontsize=10;
    c131 [label="crater f = 1\nb = 1"]; f131a [label="f = 263\nh = 262 (all computed)", fillcolor="#d9f2d9"];
    f131b [label="f = 1.47·10^17\nh = 1.47·10^17", fillcolor="#eeeeee", fontcolor="#666666"];
    c131 -> f131a [label="263, kernel\nF_2^131", color="#2e7d32", penwidth=2];
    c131 -> f131b [label="out of reach\n(F_2^(8·10^17))", style=dashed, color="#999999", fontcolor="#666666"]; }
  subgraph cluster_163 { label="m = 163, a = 1 (NIST K-163)"; fontname="Helvetica-Bold"; fontsize=10;
    c163 [label="crater f = 1\nb = 1"]; f163a [label="f = 45641\nh = 45640", fillcolor="#d9f2d9"]; f163b [label="f = 82153\nh = 82152", fillcolor="#d9f2d9"];
    f163c [label="f = 45641·82153\nh = 3.7·10^9", fillcolor="#d9f2d9"];
    f163d [label="f = 8610311, 56498081\n(and below)", fillcolor="#eeeeee", fontcolor="#666666"];
    c163 -> f163a [label="45641, kernel\nF_2^3260", color="#2e7d32", penwidth=2];
    c163 -> f163b [label="82153, kernel\nF_2^10269", color="#2e7d32", penwidth=2];
    f163a -> f163c [label="82153, kernel from\nnon-crater curve\nF_2^10269", color="#2e7d32", penwidth=2];
    c163 -> f163d [label="out of reach", style=dashed, color="#999999", fontcolor="#666666"]; }
  subgraph cluster_83 { label="m = 83, a = 0"; fontname="Helvetica-Bold"; fontsize=10;
    c83 [label="crater f = 1\nb = 1"]; f83a [label="f = 6473\nh = 6474 (all computed)", fillcolor="#d6e4f5"];
    f83b [label="f = 53676929\nh = 53676930", fillcolor="#eeeeee", fontcolor="#666666"];
    c83 -> f83a [label="CM, H_D mod 2\ndeg 6474, 20 s\n(kernel route needs F_2^268588)", color="#1f5fa8", penwidth=2];
    c83 -> f83b [label="out of reach", style=dashed, color="#999999", fontcolor="#666666"]; }
  subgraph cluster_51 { label="m = 51, a = 0 (composite m)"; fontname="Helvetica-Bold"; fontsize=10;
    c51 [label="crater f = 1\nb = 1"]; f51a [label="f = 271\nh = 272 (all computed)\ndefined over F_2^17", fillcolor="#d9f2d9"];
    f51b [label="f = 120871\nh = 120870", fillcolor="#f5f0d6"];
    c51 -> f51a [label="271: kernel F_2^2295\nand CM, agree", color="#2e7d32", penwidth=2];
    c51 -> f51b [label="CM possible, est. 7-10 h\n(not completed)", style=dotted, color="#a07d1f", fontcolor="#7a5f17"]; }
  subgraph cluster_53 { label="m = 53"; fontname="Helvetica-Bold"; fontsize=10;
    c53 [label="crater f = 1"]; f53a [label="f = 68476319\nh = 68476318", fillcolor="#eeeeee", fontcolor="#666666"];
    c53 -> f53a [label="out of reach\n(F_2^34238159; CM deg 6.8·10^7)", style=dashed, color="#999999", fontcolor="#666666"]; }
  subgraph cluster_sv { label="m = 101, 103, 107, 109 (survey)"; fontname="Helvetica-Bold"; fontsize=10;
    sv [label="m=101: f = 5857, 18583 (CM)\nm=103: f = 11329 (CM)\nm=107: f = 3209 (CM, a = 0 and 1)\nm=109: f = 3271 (kernel, F_2^545)", fillcolor="#d6e4f5"]; }
  // layout only: second row
  f131a -> c51 [style=invis]; f163c -> c53 [style=invis]; f83a -> sv [style=invis];
}
