+            let mask = (1u64 << n)-1;
+            let mut x = 0xd1b54a32d192ed03u64;
+            for i in 0..256 {
+                x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+                let a = if i == 0 {0} else if i == 1 {mask} else {x & mask};
+                let b = x.rotate_left(17) & mask;
