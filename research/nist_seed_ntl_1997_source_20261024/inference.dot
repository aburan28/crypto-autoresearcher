digraph Source {
  graph [rankdir=LR,bgcolor="white",fontname="Helvetica",pad="0.2"];
  node [shape=box,style="rounded,filled",fillcolor="#e7f0fa",color="#325d83",fontname="Helvetica",fontsize=11];
  source [label="March / August 1997 NTL\nmodular RNG (not lrand48)\nraw payloads match CDX digests"];
  default [label="Default ProbPrime(n)\n1 small + 10 full-size bases"];
  bounds [label="26-bit source-derived minimum\n192 bits: 91 advances\n239 bits: 111 advances"];
  library [label="Prior raw FreeLIP call replay\n4 call routes × 6 May curves"];
  seven [label="7 advances; 6/6 published Gx\nall 21 prime orders pass"];
  missing [label="Original caller, point counter\nand rejection log still missing",style="rounded,dashed",color="#99613c",fillcolor="white"];
  source -> default;default -> bounds;
  library -> seven;
  bounds -> missing [style=dashed,label="no original-program attribution"];
  seven -> missing [style=dashed];
}
