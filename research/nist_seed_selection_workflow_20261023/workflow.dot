digraph ANSI {
  graph [rankdir=TB, bgcolor="white", labelloc=t, label="X9.62-1998 Annex A.3.2: 21 archived curves", fontsize=21];
  node [shape=box, style="rounded,filled", fillcolor="#eaf4ff", fontname="Helvetica", fontsize=18];
  seed [label="Seed -> a,b\nthen count u", fillcolor="#eaf4ff"];
  near [label="Near prime u=hn\n11 omitted + 10 published\nrecorded h=1, n prime", fillcolor="#eaf4ff"];
  checks [label="MOV B>=20\nnonanomalous\nall 21 pass B=100", fillcolor="#eaf4ff"];
  base [label="Find point G\nwith order n", fillcolor="#fff4d6"];
  result [label="For h=1, any nonidentity\npoint has order n", fillcolor="#e8f6e8"];
  unknown [label="Original implementation / logs\nunknown acceptance path", fillcolor="#ffe6e6"];
  seed -> near -> checks -> base -> result;
  checks -> unknown [style=dashed, label="historical inference unresolved"];
}
