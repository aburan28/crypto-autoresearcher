digraph research { rankdir=TB; graph [bgcolor="white",ranksep=0.35]; node [shape=box,style="rounded,filled",fillcolor="#eff6ff",fontname="Helvetica",fontsize=14]; edge [fontsize=12];
n0 [label="Supplied CM order and\ncandidate generators"];
n1 [label="Norm/index selection\ndiagnostics"];
n2 [label="Faithful full-module\ndivision check"];
n3 [label="Map discovery and\ncomplete cost accounting"];
n0 -> n1 [label="exact supplied fixtures"]; n1 -> n2 [label="necessary checks"]; n2 -> n3 [style=dashed,label="open research obligation"];
}
