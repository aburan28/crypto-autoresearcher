digraph cm_pair_screen {
  graph [rankdir=LR, bgcolor="white", pad="0.22", nodesep="0.38", ranksep="0.65", fontname="Helvetica", label="Exact pairwise structural screen of 21 seed-level curve classes", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", color="#90a8c4", fillcolor="#f2f7fc", fontname="Helvetica", fontsize=12, margin="0.16,0.12"];
  edge [color="#6a829d", arrowsize=0.72, fontname="Helvetica", fontsize=10];

  input [label="11 omitted + 10 published\nexact curve UIDs, p, n, j", fillcolor="#eaf2fa"];
  delta [label="Compute t = p + 1 − n\nand Δ = t² − 4p", fillcolor="#eaf2fa"];
  cm [label="For 210 pairs:\nΔᵢΔⱼ a perfect square?", fillcolor="#eaf2fa"];
  cm_result [label="0 / 210 pairs share a CM field\n(also 0 / 55 omitted pairs)", color="#5b8f7e", fillcolor="#e5f3ed"];
  small_cm [label="For each curve:\nscan all fundamental D with |D| ≤ 1,000,000", fillcolor="#eaf2fa"];
  small_cm_result [label="0 / 21 curves in that CM-field range", color="#5b8f7e", fillcolor="#e5f3ed"];
  same_p [label="For 45 pairs over the same p:\ncompare n, opposite t, and j", fillcolor="#eaf2fa"];
  same_p_result [label="0 equal orders, 0 opposite traces,\n0 equal j-invariants", color="#5b8f7e", fillcolor="#e5f3ed"];
  limit [label="Only named-curve pair relations excluded.\nOther endpoints or mechanisms remain open.", color="#c9974d", fillcolor="#fff4df"];

  input -> delta;
  delta -> cm;
  delta -> small_cm;
  delta -> same_p;
  cm -> cm_result;
  small_cm -> small_cm_result;
  same_p -> same_p_result;
  cm_result -> limit;
  small_cm_result -> limit;
  same_p_result -> limit;
}
