digraph inference {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.55", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
        color="#9aabc1", fillcolor="#edf4fb", fontcolor="#172943", margin="0.15,0.1"];
  edge [color="#60748f", penwidth=1.3, arrowsize=0.7];
  data [label="21 exact seed classes\n11 omitted; 10 published"];
  test [label="For each odd prime ℓ ≤ 10,000:\nFrobenius split, repeated, or inert?"];
  single [label="0 single-degree rules\nseparate every label", fillcolor="#fff0e2"];
  pair [label="ℓ = 2099 and 9013: all 11 inert\nbut 3 and 6 published controls inert", fillcolor="#fff0e2"];
  rank [label="Exact within-field allocation rank:\n853 / 4,480 have ≥ 2 all-omitted-inert primes", fillcolor="#fff0e2"];
  open [label="Historical selection and\nunknown weakness remain open", fillcolor="#f4eaf7"];
  data -> test;
  test -> single;
  test -> pair;
  pair -> rank;
  single -> open;
  rank -> open;
}
