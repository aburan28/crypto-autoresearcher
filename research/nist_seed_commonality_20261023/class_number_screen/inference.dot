digraph class_number_screen {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12,
        color="#8092a8", fillcolor="#f5f8fc", fontcolor="#172b4d"];
  edge [fontname="Arial", fontsize=10, color="#51677f", arrowsize=0.75];

  theorem [label="2026 paper: complete list\nof fields with h(K) ≤ 2,000",
           style="rounded,dashed,filled", fillcolor="#fff7e7", color="#ca8e2f"];
  exact [label="Exact integer test on 21 curves\nΔ = t² − 4p = f² D_K\n345,523,353 comparisons"];
  result [label="Zero CM-field matches\n11 omitted; 10 published", fillcolor="#e9f4ed", color="#4c8a66"];
  bounded [label="Low CM-field class number\ncannot classify the omissions", fillcolor="#e9f4ed", color="#4c8a66"];
  open [label="Historical rule and other\nweakness mechanisms remain open", fillcolor="#fff4ec", color="#c27a4b"];

  theorem -> bounded [style=dashed, label="assumed completeness"];
  exact -> result [label="verified arithmetic"];
  result -> bounded [label="conditional inference"];
  bounded -> open [label="bounded scope"];
}
