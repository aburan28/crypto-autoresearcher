digraph Atkin {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", pad="0.2"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f0fa", color="#315c85", fontname="Helvetica", fontsize=11];
  source [label="1995 source\nAtkin trace restrictions"];
  input [label="19 exact archived p,n\n11 omitted + 8 published"];
  arithmetic [label="3,173 finite-prime cells\ncompanion matrices + GF(ell^2)"];
  cutoff [label="Fixed residue-density cutoff\n20 lower / 3 higher / 2 ties", fillcolor="#fff0dc", color="#ab6428"];
  historical [label="Original point-counter\nand candidate log missing", style="rounded,dashed", color="#9b6340", fillcolor="white"];
  source -> arithmetic [label="method"];
  input -> arithmetic [label="exact parameters"];
  arithmetic -> cutoff [label="integer inequality"];
  cutoff -> historical [style=dashed, color="#9b6340", label="does not identify"];
}
