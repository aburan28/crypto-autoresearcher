digraph SingularSurface {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", label="Singular companions under unvalidated short-Weierstrass arithmetic", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eaf1f7", color="#5c7284", fontname="Helvetica"];
  source [label="19 source curves\n11 omitted + 8 published\na = −3 in four fields"];
  formulas [label="Arithmetic omits b\nwhen point is not validated"];
  singular [label="Two singular inputs\nb′ = +2 and b′ = −2"];
  surface [label="Within each field: same p and a\nsame smooth-locus orders"];
  history [label="1997 keep/skip reason\nstill unknown", style="rounded,dashed", fillcolor="#fff4e5", color="#c58335"];
  source -> formulas [label="conditional model"];
  formulas -> singular [label="derived algebra"];
  singular -> surface [label="exact 19-curve check"];
  surface -> history [label="does not determine", style=dashed];
}
