digraph Timeline {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=18, labelloc=t, label="1997 curve-source chronology", nodesep=0.6, ranksep=0.75];
  node [shape=box, style="rounded,filled", fillcolor="#edf3f9", color="#42677e", fontname="Helvetica", fontsize=14, width=2.8];
  edge [color="#42677e", fontname="Helvetica", fontsize=12];
  may [label="15–18 May 1997\nreconstructed 192/239-bit\nseed-stream starts", fillcolor="#e4edf7"];
  june [label="11 June 1997\nX9.62 draft date\ncited by 1998 paper", fillcolor="#d8e9d0"];
  example [label="1998 paper\n192-bit ANSI example\na = p − 3", fillcolor="#d8e9d0"];
  november [label="17 Nov 1997\nX9.62 draft date\ncited by IETF", fillcolor="#d8e9d0"];
  identity [label="Exact example identity\nand rejection trace\nunknown", fillcolor="#fff0cc", style="rounded,filled,dashed"];
  may -> june [label="chronology only", style=dashed];
  june -> example [label="paper cites [A97]"];
  june -> november [label="later draft cited", style=dotted];
  example -> identity [label="b, n, G, seed absent", style=dashed];
}
