digraph m51_conductor_lattice {
  graph [
    bgcolor="white",
    label="m=51 ordinary conductor lattice: certified edges versus unresolved adjacencies\nField GF(2^51), modulus x^51+x^6+x^3+x+1; model E_b: y^2+xy=x^3+b; N=2251799852369764",
    labelloc="t",
    fontsize=18,
    fontname="DejaVu Sans",
    pad=0.25,
    ranksep=1.25,
    nodesep=0.85
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.12", color="#334155", fillcolor="#f8fafc"];
  edge [fontname="DejaVu Sans", fontsize=9.5, color="#475569", penwidth=1.7, arrowsize=0.8];

  C [label="C: crater control\nE_b with b=1 over GF(2^51)\n(D_K=-7, f_pi=32756041, f_E=1)\ncontrol certificate: POSITIVE_CONTROL_F271_TO_CRATER", fillcolor="#ecfdf5"];
  A [label="A: f=271 control representative\nE_b with b=623162416261 over GF(2^51)\n(D_K=-7, f_pi=32756041, f_E=271)\n1 of the complete 16-orbit census", fillcolor="#ecfdf5"];
  P [label="P: selected parent example, pair 1\nE_b with b=23437064261573 over GF(2^51)\n(D_K=-7, f_pi=32756041, f_E=120871)\n32 selected; 42 certified in the full scan", fillcolor="#eff6ff"];
  B [label="B: selected bottom example, pair 1\nE_b with b=2217142749093508 over GF(2^51)\n(D_K=-7, f_pi=32756041, f_E=32756041=271*120871)\n32 selected; 42 certified in the full scan", fillcolor="#eff6ff"];

  { rank=same; C; }
  { rank=same; A; P; }
  { rank=same; B; }

  A -> C [label="degree=271 | separable=yes | field=GF(2^51) | ascending\npositive control; evaluator and dual not serialized", color="#15803d"];
  B -> P [label="degree=271 | separable=yes | field=GF(2^51) | ascending\ncertified pair 1 (42 total; first 32 selected)\nevaluator and dual not serialized", color="#0369a1", penwidth=2.8];

  P -> C [label="degree=120871 | separable=yes | field=unresolved | ascending\nconductor-lattice adjacency only; endpoint edge/map not supplied", style=dashed, color="#c2410c"];
  B -> A [label="degree=120871 | separable=yes | field=unresolved | ascending\nconductor-lattice adjacency only; endpoint edge/map not supplied", style=dashed, color="#c2410c"];

  note [shape=note, label="No horizontal edge was searched or measured in this run.\nKoblitz tau is a characteristic-power Frobenius endomorphism,\nnot a separable volcano edge. No transfer claim is permitted.", fillcolor="#fff7ed", color="#c2410c"];
  note -> B [style=invis];
}
