{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crypto-evidence:claim:1",
  "title": "Scoped advisory research claim",
  "type": "object",
  "required": [
    "assumptions",
    "basis",
    "broad_direction_closed",
    "contradicts",
    "created_at",
    "depends_on",
    "formal_verification",
    "id",
    "key",
    "lead",
    "lesson",
    "next_discriminating_test",
    "not_implied",
    "record_type",
    "review",
    "revisit_when",
    "schema_version",
    "scope",
    "scope_kind",
    "statement",
    "supersedes",
    "support"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^C-[0-9a-f]{12}$"
    },
    "lead": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "basis": {
      "enum": [
        "execution_limit",
        "implementation_gap",
        "bounded_observation",
        "finite_enumeration",
        "written_derivation",
        "native_certificate",
        "construction_fact"
      ]
    },
    "broad_direction_closed": {
      "const": false
    },
    "formal_verification": {
      "type": "object",
      "required": [
        "status",
        "assistant",
        "checked_theorem",
        "kernel_receipt",
        "axiom_audit"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_formalized",
            "draft"
          ]
        },
        "assistant": {
          "const": "Lean"
        }
      }
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_kind": {
      "type": "string",
      "minLength": 1
    },
    "lesson": {
      "type": "string",
      "minLength": 1
    },
    "next_discriminating_test": {
      "type": "string",
      "minLength": 1
    },
    "revisit_when": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_implied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "path",
          "sha256",
          "provenance"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance": {
            "enum": [
              "internal",
              "retrieved",
              "kb",
              "recalled"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "register_author",
        "independent_agent_review",
        "official_ledger_imported"
      ],
      "properties": {
        "official_ledger_imported": {
          "const": false
        }
      }
    }
  },
  "additionalProperties": true
}
