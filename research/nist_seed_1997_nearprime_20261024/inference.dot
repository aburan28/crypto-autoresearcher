digraph nearprime {
  graph [rankdir=TB, bgcolor="white", label="1997 near-prime lower bound from retained exact orders", labelloc=t, fontsize=19];
  node [shape=box, style="rounded,filled", fillcolor="#eef4f8", color="#527187", fontname="Helvetica", fontsize=12];
  seeded [label="11,042 seeded coefficient positions\nin six recovered prefixes"];
  positive [label="959 positions with positive exact order\non a seeded root"];
  censored [label="10,083 censored positions\nno exact eligible-root order", fillcolor="#f2f2f2"];
  result [label="99 certified near-prime positions\n69 full prime order + 30 smooth cofactor", fillcolor="#e5f3e8"];
  other [label="860 positive positions fail this\nspecified near-prime screen", fillcolor="#f7eee9"];
  history [label="Historical candidate visitation and\noriginal acceptance settings unknown", style="rounded,dashed", fillcolor="white"];
  seeded -> positive [label="retained exact counts"];
  seeded -> censored [label="early abort / no exact order"];
  positive -> result [label="l_max=255; 99 point certificates"];
  positive -> other;
  history -> result [style=dashed, label="unproven historical edge"];
  {rank=same; positive; censored}
  {rank=same; result; other}
}
