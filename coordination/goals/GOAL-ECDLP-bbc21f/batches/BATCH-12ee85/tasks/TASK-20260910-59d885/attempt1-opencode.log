\n45:     return d.sqrt()\n46: \n47: \n48: def compute_cap(W: Decimal) -> int:\n49:     eight_w = 8 * W\n50:     return int(eight_w.to_integral_value(rounding=ROUND_CEILING))\n51: \n52: \n53: def compute_dp_threshold(W: Decimal) -> int:\n54:     two64 = Decimal(1 << 64)\n55:     thr = (two64 / W).to_integral_value(rounding=ROUND_FLOOR)\n56:     return int(thr)\n57: \n58: \n59: def build_graph(N: int, K: int, K_dp: int, dp_threshold: int):\n60:     x = np.arange(N, dtype=np.uint64)\n61:     fx = (mix64_vec(x ^ np.uint64(K)) % np.uint64(N)).astype(np.int64)\n62:     dpval = mix64_vec(x ^ np.uint64(K_dp))\n63:     is_dp = dpval < np.uint64(dp_threshold)\n64:     return fx, is_dp\n65: \n66: \n67: def bfs_partition(N: int, fx: np.ndarray, is_dp: np.ndarray, cap: int):\n68:     \"\"\"\n69:     dist[x] = number of forward steps from x to first DP on its orbit,\n70:               computed EXACTLY (never truncated at cap), -1 if unreachable.\n71:     root[x] = the DP node first hit, -1 if unreachable.\n72:     Uses reverse-graph (predecessor) multi-source BFS from all DP nodes,\n73:     which is exact because each node has out-degree exactly 1 in the\n74:     forward graph, so \"shortest path from x to the DP set\" (computed by\n75:     reversing edges and searching from the set) equals the unique forward\n76:     hitting time.\n77:     \"\"\"\n78:     order = np.argsort(fx, kind='stable')          # x's sorted by fx(x)\n79:     counts = np.bincount(fx, minlength=N)\n80:     offsets = np.zeros(N + 1, dtype=np.int64)\n81:     np.cumsum(counts, out=offsets[1:])\n82:     pred_flat = order\n83: \n84:     dist = np.full(N, -1, dtype=np.int64)\n85:     root = np.full(N, -1, dtype=np.int64)\n86: \n87:     dp_nodes = np.nonzero(is_dp)[0]\n88:     dist[dp_nodes] = 0\n89:     root[dp_nodes] = dp_nodes\n90: \n91:     frontier = dp_nodes\n92:     depth = 0\n93:     while frontier.size > 0:\n94:         starts = offsets[frontier]\n95:         lengths = counts[frontier]\n96:         total = int(lengths.sum())\n97:         if total == 0:\n98:             break\n99:         block_id = np.repeat(np.arange(frontier.size), lengths)\n100:         cum = np.cumsum(lengths)\n101:         block_start_pos = cum - lengths\n102:         idx_within = np.arange(total) - np.repeat(block_start_pos, lengths)\n103:         src_idx = starts[block_id] + idx_within\n104:         preds = pred_flat[src_idx]\n105:         new_root = root[frontier][block_id]\n106: \n107:         mask = dist[preds] == -1          # exclude already-visited (e.g. DP-to-DP edges)\n108:         preds = preds[mask]\n109:         new_root = new_root[mask]\n110: \n111:         if preds.size == 0:\n112:             break\n113:         dist[preds] = depth + 1\n114:         root[preds] = new_root\n115:         frontier = preds\n116:         depth += 1\n117: \n118:     return dist, root\n119: \n120: \n121: def brute_force_partition(N: int, fx: np.ndarray, is_dp: np.ndarray, cap_for_reach_check=None):\n122:     \"\"\"Reference (slow, O(N * path length)) implementation for validation only.\"\"\"\n123:     dist = np.full(N, -1, dtype=np.int64)\n124:     root = np.full(N, -1, dtype=np.int64)\n125:     for start in range(N):\n126:         seen = {}\n127:         cur = start\n128:         steps = 0\n129:         path = []\n130:         while True:\n131:             if cur in seen:\n132:                 # entered a cycle without hitting DP (from 'path' local perspective)\n133:                 # everything in path is unreachable via this exploration alone;\n134:                 # but cur might have been resolved already from a previous start.\n135:                 break\n136:             if dist[cur] != -1:\n137:                 # already resolved\n138:                 base_dist = dist[cur]\n139:                 base_root = root[cur]\n140:                 for i, node in enumerate(reversed(path)):\n141:                     dist[node] = base_dist + i + 1\n142:                     root[node] = base_root\n143:     