{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-autoresearcher.invalid/schemas/matrix-summary-xor-v4.schema.json",
  "title": "EXP-XOR-44d232 complete matrix summary v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "matrix_id", "experiment_id", "status", "declared_arm_count", "arms", "shards", "totals", "source_blobs", "validator"],
  "properties": {
    "schema": {"const": "matrix-summary/xor-v4"},
    "matrix_id": {"type": "string", "pattern": "^MATRIX-XOR-[0-9a-f]{6}$"},
    "experiment_id": {"const": "EXP-XOR-44d232"},
    "status": {"enum": ["completed_valid", "completed_invalid", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget"]},
    "declared_arm_count": {"const": 400},
    "arms": {
      "type": "array",
      "minItems": 400,
      "maxItems": 400,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/arm"}
    },
    "shards": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/shard"}
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared", "attempted", "completed_valid", "completed_invalid",
        "failed_infrastructure", "failed_implementation", "resource_exhaustion",
        "cancelled_by_budget", "not_attempted", "coordinator_wall_seconds", "worker_wall_seconds",
        "replay_wall_seconds", "analysis_wall_seconds", "hashing_wall_seconds",
        "serialization_wall_seconds", "campaign_wall_seconds", "arm_cpu_seconds",
        "replay_cpu_seconds", "analysis_cpu_seconds", "hashing_cpu_seconds",
        "serialization_cpu_seconds", "cpu_seconds",
        "host_rss_peak_bytes", "arm_raw_bytes", "arm_stdout_bytes", "arm_stderr_bytes",
        "replay_bytes", "analysis_bytes", "global_log_bytes", "output_bytes"
      ],
      "properties": {
        "declared": {"const": 400},
        "attempted": {"type": "integer", "minimum": 0, "maximum": 400},
        "completed_valid": {"type": "integer", "minimum": 0, "maximum": 400},
        "completed_invalid": {"type": "integer", "minimum": 0, "maximum": 400},
        "failed_infrastructure": {"type": "integer", "minimum": 0, "maximum": 400},
        "failed_implementation": {"type": "integer", "minimum": 0, "maximum": 400},
        "resource_exhaustion": {"type": "integer", "minimum": 0, "maximum": 400},
        "cancelled_by_budget": {"type": "integer", "minimum": 0, "maximum": 400},
        "not_attempted": {"type": "integer", "minimum": 0, "maximum": 400},
        "coordinator_wall_seconds": {"type": "number", "minimum": 0},
        "worker_wall_seconds": {"type": "number", "minimum": 0, "maximum": 1800},
        "replay_wall_seconds": {"type": "number", "minimum": 0},
        "analysis_wall_seconds": {"type": "number", "minimum": 0},
        "hashing_wall_seconds": {"type": "number", "minimum": 0},
        "serialization_wall_seconds": {"type": "number", "minimum": 0},
        "campaign_wall_seconds": {"type": "number", "minimum": 0, "maximum": 1800},
        "arm_cpu_seconds": {"type": "number", "minimum": 0},
        "replay_cpu_seconds": {"type": "number", "minimum": 0},
        "analysis_cpu_seconds": {"type": "number", "minimum": 0},
        "hashing_cpu_seconds": {"type": "number", "minimum": 0},
        "serialization_cpu_seconds": {"type": "number", "minimum": 0},
        "cpu_seconds": {"type": "number", "minimum": 0, "maximum": 4000},
        "host_rss_peak_bytes": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "arm_raw_bytes": {"type": "integer", "minimum": 0},
        "arm_stdout_bytes": {"type": "integer", "minimum": 0},
        "arm_stderr_bytes": {"type": "integer", "minimum": 0},
        "replay_bytes": {"type": "integer", "minimum": 0},
        "analysis_bytes": {"type": "integer", "minimum": 0},
        "global_log_bytes": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0, "maximum": 27111981056}
      }
    },
    "source_blobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "run_schema", "matrix_schema", "event_schema", "validator", "predecessor_exclusion", "implementation", "arithmetic", "dependency_lock"],
      "properties": {
        "design": {"$ref": "#/$defs/sha256"},
        "run_schema": {"$ref": "#/$defs/sha256"},
        "matrix_schema": {"$ref": "#/$defs/sha256"},
        "event_schema": {"$ref": "#/$defs/sha256"},
        "validator": {"$ref": "#/$defs/sha256"},
        "predecessor_exclusion": {"$ref": "#/$defs/sha256"},
        "implementation": {"$ref": "#/$defs/sha256"},
        "arithmetic": {"$ref": "#/$defs/sha256"},
        "dependency_lock": {"$ref": "#/$defs/sha256"}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "version", "fixtures_manifest", "passed", "semantic_checks"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "version": {"const": "xor-validator/v4"},
        "fixtures_manifest": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "semantic_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "b_num", "b_den", "arm", "seed", "process_replica", "null_replica", "shard"],
      "properties": {
        "p": {"enum": [101, 103, 107, 211]},
        "b_num": {"enum": [1, 2]},
        "b_den": {"enum": [2, 5]},
        "arm": {"enum": ["A", "B", "D"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 5},
        "process_replica": {"type": "integer", "minimum": 0, "maximum": 4},
        "null_replica": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "shard": {"type": "integer", "minimum": 0, "maximum": 3}
      },
      "allOf": [
        {"if": {"properties": {"arm": {"enum": ["A", "B"]}}}, "then": {"properties": {"seed": {"const": 0}, "null_replica": {"const": 4294967295}, "process_replica": {"minimum": 0, "maximum": 4}}}},
        {"if": {"properties": {"arm": {"const": "D"}}}, "then": {"properties": {"seed": {"enum": [1, 2, 3, 4, 5]}, "process_replica": {"const": 0}, "null_replica": {"minimum": 0, "maximum": 7}}}}
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm_key", "state", "run_id", "terminal_reason", "included_in_metrics", "wall_repeats", "resource_bytes"],
      "properties": {
        "arm_key": {"$ref": "#/$defs/key"},
        "state": {"enum": ["completed_valid", "completed_invalid", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget", "not_attempted"]},
        "run_id": {"type": ["string", "null"], "pattern": "^RUN-XOR-[0-9a-f]{6}$"},
        "terminal_reason": {"type": ["string", "null"]},
        "included_in_metrics": {"type": "boolean"},
        "wall_repeats": {"type": "array", "minItems": 0, "maxItems": 5, "items": {"type": ["number", "null"]}},
        "resource_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "stdout", "stderr"],
          "properties": {
            "raw": {"type": "integer", "minimum": 0, "maximum": 67108864},
            "stdout": {"type": "integer", "minimum": 0},
            "stderr": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shard", "arm_keys", "max_concurrent", "schedule", "wall_seconds", "cpu_seconds", "host_rss_peak_bytes", "output_bytes"],
      "properties": {
        "shard": {"enum": [0, 1, 2, 3]},
        "arm_keys": {"type": "array", "minItems": 100, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
        "max_concurrent": {"const": 1},
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "within_shard", "between_shards"],
          "properties": {"mode": {"const": "four_shards_concurrent_each_sequential"}, "within_shard": {"const": "sequential"}, "between_shards": {"const": "concurrent"}}
        },
        "wall_seconds": {"type": "number", "minimum": 0, "maximum": 1800},
        "cpu_seconds": {"type": "number", "minimum": 0, "maximum": 4000},
        "host_rss_peak_bytes": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
