{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crypto-autoresearch/xor/matrix-summary-v3",
  "title": "EXP-XOR-44d232 matrix summary v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_id", "experiment_id", "status", "declared_arm_count", "arms", "shards", "totals", "source_blobs", "pareto_audit_path"],
  "properties": {
    "matrix_id": {"type": "string", "pattern": "^MATRIX-XOR-[0-9a-f]{6}$"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-Z0-9-]+-[0-9a-f]{6}$"},
    "status": {"type": "string", "enum": ["planned", "running", "completed_valid", "completed_invalid", "partial", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget"]},
    "declared_arm_count": {"const": 400},
    "arms": {
      "type": "array",
      "minItems": 400,
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_key", "state", "run_id", "terminal_reason", "included_in_metrics"],
        "properties": {
          "arm_key": {"type": "string", "minLength": 1},
          "state": {"type": "string", "enum": ["not_attempted", "attempted", "completed_valid", "completed_invalid", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget"]},
          "run_id": {"type": ["string", "null"], "pattern": "^RUN-[A-Z0-9-]+-[0-9a-f]{6}$"},
          "terminal_reason": {"type": ["string", "null"]},
          "included_in_metrics": {"type": "boolean"}
        }
      }
    },
    "shards": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shard", "arm_keys", "max_concurrent", "wall_seconds", "cpu_seconds", "host_rss_peak_bytes", "output_bytes"],
        "properties": {
          "shard": {"type": "integer", "minimum": 0, "maximum": 3},
          "arm_keys": {"type": "array", "items": {"type": "string"}},
          "max_concurrent": {"const": 1},
          "wall_seconds": {"type": "number", "minimum": 0},
          "cpu_seconds": {"type": "number", "minimum": 0},
          "host_rss_peak_bytes": {"type": "integer", "minimum": 0},
          "output_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared", "attempted", "completed_valid", "completed_invalid",
        "failed_infrastructure", "failed_implementation", "resource_exhaustion",
        "cancelled_by_budget", "not_attempted", "worker_wall_seconds",
        "replay_wall_seconds", "analysis_wall_seconds", "hashing_wall_seconds",
        "serialization_wall_seconds", "campaign_wall_seconds", "cpu_seconds",
        "host_rss_peak_bytes", "output_bytes"
      ],
      "properties": {
        "declared": {"const": 400},
        "attempted": {"type": "integer", "minimum": 0, "maximum": 400},
        "completed_valid": {"type": "integer", "minimum": 0, "maximum": 400},
        "completed_invalid": {"type": "integer", "minimum": 0, "maximum": 400},
        "failed_infrastructure": {"type": "integer", "minimum": 0, "maximum": 400},
        "failed_implementation": {"type": "integer", "minimum": 0, "maximum": 400},
        "resource_exhaustion": {"type": "integer", "minimum": 0, "maximum": 400},
        "cancelled_by_budget": {"type": "integer", "minimum": 0, "maximum": 400},
        "not_attempted": {"type": "integer", "minimum": 0, "maximum": 400},
        "worker_wall_seconds": {"type": "number", "minimum": 0},
        "replay_wall_seconds": {"type": "number", "minimum": 0},
        "analysis_wall_seconds": {"type": "number", "minimum": 0},
        "hashing_wall_seconds": {"type": "number", "minimum": 0},
        "serialization_wall_seconds": {"type": "number", "minimum": 0},
        "campaign_wall_seconds": {"type": "number", "minimum": 0, "maximum": 1800},
        "cpu_seconds": {"type": "number", "minimum": 0, "maximum": 4000},
        "host_rss_peak_bytes": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0, "maximum": 27111981056}
      }
    },
    "source_blobs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "pareto_audit_path": {"type": "string", "minLength": 1}
  }
}
