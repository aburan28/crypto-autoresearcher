{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crypto-autoresearch/xor/run-manifest-v3",
  "title": "EXP-XOR-44d232 per-arm run manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["run"],
  "properties": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "experiment_id", "status", "attempted", "terminal_reason",
        "code", "environment", "inputs", "matrix_key", "timing", "resources",
        "result", "artifacts", "provenance", "source_blobs", "phase_counters"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^RUN-[A-Z0-9-]+-[0-9a-f]{6}$"},
        "experiment_id": {"type": "string", "pattern": "^EXP-[A-Z0-9-]+-[0-9a-f]{6}$"},
        "status": {"type": "string", "enum": ["completed_valid", "completed_invalid", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget"]},
        "attempted": {"type": "boolean"},
        "terminal_reason": {"type": ["string", "null"]},
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "dirty", "command"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dirty": {"type": "boolean"},
            "command": {"type": "string", "minLength": 1}
          }
        },
        "environment": {"type": "object"},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p", "b_num", "b_den", "m", "seed", "input_digest", "parameters"],
          "properties": {
            "p": {"type": "integer", "minimum": 5},
            "b_num": {"type": "integer", "minimum": 1},
            "b_den": {"type": "integer", "minimum": 1},
            "m": {"const": 3},
            "seed": {"type": "integer", "minimum": 0, "maximum": 5},
            "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "parameters": {"type": "object"}
          }
        },
        "matrix_key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arm", "seed", "process_replica", "null_replica", "shard"],
          "properties": {
            "arm": {"type": "string", "enum": ["A", "B", "D"]},
            "seed": {"type": "integer", "minimum": 0, "maximum": 5},
            "process_replica": {"type": "integer", "minimum": 0, "maximum": 4},
            "null_replica": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "shard": {"type": "integer", "minimum": 0, "maximum": 3}
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "finished_at", "wall_seconds", "cpu_seconds"],
          "properties": {
            "started_at": {"type": "string", "minLength": 1},
            "finished_at": {"type": "string", "minLength": 1},
            "wall_seconds": {"type": "number", "minimum": 0},
            "cpu_seconds": {"type": "number", "minimum": 0}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peak_rss_bytes", "output_bytes", "stdout_bytes", "stderr_bytes"],
          "properties": {
            "peak_rss_bytes": {"type": "integer", "minimum": 0},
            "output_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
            "stdout_bytes": {"type": "integer", "minimum": 0},
            "stderr_bytes": {"type": "integer", "minimum": 0}
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "invalid_reason", "metrics"],
          "properties": {
            "valid": {"type": "boolean"},
            "invalid_reason": {"type": ["string", "null"]},
            "metrics": {"type": "object"}
          }
        },
        "artifacts": {"type": "object"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested_policy", "backend", "resolved_model_id", "model_verified", "reasoning_effort", "fallback_used", "degraded_requirements"],
          "properties": {
            "requested_policy": {"type": "string"},
            "backend": {"type": ["string", "null"]},
            "resolved_model_id": {"type": ["string", "null"]},
            "model_verified": {"type": "boolean"},
            "reasoning_effort": {"type": ["string", "null"]},
            "fallback_used": {"type": "boolean"},
            "degraded_requirements": {"type": "array", "items": {"type": "string"}}
          }
        },
        "source_blobs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "phase_counters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "curve", "factor_base", "table", "query", "verify", "serialize", "total"],
          "properties": {
            "input": {"type": "integer", "minimum": 0},
            "curve": {"type": "integer", "minimum": 0},
            "factor_base": {"type": "integer", "minimum": 0},
            "table": {"type": "integer", "minimum": 0},
            "query": {"type": "integer", "minimum": 0},
            "verify": {"type": "integer", "minimum": 0},
            "serialize": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
