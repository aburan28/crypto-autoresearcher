{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-autoresearcher.invalid/schemas/run-manifest-xor-v5.schema.json",
  "title": "EXP-XOR-44d232 per-arm run manifest v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run"],
  "properties": {
    "schema": {"const": "run-manifest/xor-v5"},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "experiment_id", "status", "attempted", "terminal_reason", "code", "environment", "inputs", "matrix_key", "timing", "resources", "provenance", "source_blobs", "phase_counters", "event_ledger", "candidate_counters", "query_counters", "table_bucket_sizes", "result", "artifacts"],
      "properties": {
        "id": {"type": "string", "pattern": "^RUN-XOR-[0-9a-f]{6}$"},
        "experiment_id": {"const": "EXP-XOR-44d232"},
        "status": {"enum": ["completed_valid", "completed_invalid", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget"]},
        "attempted": {"const": true},
        "terminal_reason": {"type": ["string", "null"]},
        "code": {"type": "object", "additionalProperties": false, "required": ["commit", "dirty", "command"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"type": "boolean"}, "command": {"type": "string", "minLength": 1}}},
        "environment": {"type": "object"},
        "inputs": {"$ref": "#/$defs/inputs"},
        "matrix_key": {"$ref": "#/$defs/key"},
        "timing": {
          "type": "object", "additionalProperties": false,
          "required": ["started_monotonic_ns", "finished_monotonic_ns", "clock_source", "unit", "c_wall_seconds", "cpu_seconds", "child_exit_status", "final_output_flush_complete", "interval_contract"],
          "properties": {
            "started_monotonic_ns": {"type": "integer", "minimum": 0},
            "finished_monotonic_ns": {"type": "integer", "minimum": 1},
            "clock_source": {"const": "monotonic_ns"},
            "unit": {"const": "nanoseconds"},
            "c_wall_seconds": {"type": "number", "minimum": 0, "maximum": 1800},
            "cpu_seconds": {"type": "number", "minimum": 0, "maximum": 4000},
            "child_exit_status": {"type": "integer", "minimum": 0, "maximum": 255},
            "final_output_flush_complete": {"const": true},
            "interval_contract": {"type": "object", "additionalProperties": false, "required": ["start", "stop", "included", "excluded"], "properties": {"start": {"const": "wrapper_timestamp_immediately_before_spawn_call"}, "stop": {"const": "child_exit_after_final_output_flush"}, "included": {"const": ["process_launch", "input_read", "curve", "factor_base", "all_E_add", "serialization", "output_flush"]}, "excluded": {"const": ["replay", "analysis", "global_hashing", "matrix_aggregation", "coordinator_queue"]}}}
          }
        },
        "resources": {"type": "object", "additionalProperties": false, "required": ["peak_rss_bytes", "stdout_bytes", "stderr_bytes", "raw_bytes", "output_bytes"], "properties": {"peak_rss_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}, "stdout_bytes": {"type": "integer", "minimum": 0}, "stderr_bytes": {"type": "integer", "minimum": 0}, "raw_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}, "output_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}}},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["requested_policy", "backend", "resolved_model_id", "model_verified", "reasoning_effort", "fallback_used", "degraded_requirements"], "properties": {"requested_policy": {"type": "string"}, "backend": {"type": ["string", "null"]}, "resolved_model_id": {"type": ["string", "null"]}, "model_verified": {"type": "boolean"}, "reasoning_effort": {"type": ["string", "null"]}, "fallback_used": {"type": "boolean"}, "degraded_requirements": {"type": "array", "items": {"type": "string"}}}},
        "source_blobs": {"$ref": "#/$defs/source_blobs"},
        "phase_counters": {"$ref": "#/$defs/phase_counters"},
        "event_ledger": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "event_count", "exception_count", "first_event_index", "last_event_index"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "event_count": {"type": "integer", "minimum": 0}, "exception_count": {"type": "integer", "minimum": 0}, "first_event_index": {"const": 0}, "last_event_index": {"type": "integer", "minimum": -1}}},
        "candidate_counters": {"$ref": "#/$defs/candidate_counters"},
        "query_counters": {"$ref": "#/$defs/query_counters"},
        "table_bucket_sizes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "result": {"type": "object", "additionalProperties": false, "required": ["valid", "invalid_reason", "metrics"], "properties": {"valid": {"type": "boolean"}, "invalid_reason": {"type": ["string", "null"]}, "metrics": {"type": "object"}}},
        "artifacts": {"type": "object", "additionalProperties": false, "required": ["raw_event_ledger", "output_blob", "prng_ledger"], "properties": {"raw_event_ledger": {"type": "string", "minLength": 1}, "output_blob": {"type": ["string", "null"]}, "prng_ledger": {"type": ["string", "null"]}}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "completed_valid"}}}, "then": {"properties": {"terminal_reason": {"const": null}, "result": {"properties": {"valid": {"const": true}, "invalid_reason": {"const": null}}}}}},
        {"if": {"properties": {"status": {"enum": ["completed_invalid", "failed_infrastructure", "failed_implementation", "resource_exhaustion", "cancelled_by_budget"]}}}, "then": {"properties": {"terminal_reason": {"type": "string", "minLength": 1}, "result": {"properties": {"valid": {"const": false}}}}}}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["m", "p", "b_num", "b_den", "seed", "input_digest"], "properties": {"m": {"const": 3}, "p": {"enum": [101, 103, 107, 211]}, "b_num": {"enum": [1, 2]}, "b_den": {"enum": [2, 5]}, "seed": {"type": "integer", "minimum": 0, "maximum": 5}, "input_digest": {"$ref": "#/$defs/sha256"}}},
    "key": {"type": "object", "additionalProperties": false, "required": ["p", "b_num", "b_den", "arm", "seed", "process_replica", "null_replica", "shard"], "properties": {"p": {"enum": [101, 103, 107, 211]}, "b_num": {"enum": [1, 2]}, "b_den": {"enum": [2, 5]}, "arm": {"enum": ["A", "B", "D"]}, "seed": {"type": "integer", "minimum": 0, "maximum": 5}, "process_replica": {"type": "integer", "minimum": 0, "maximum": 4}, "null_replica": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "shard": {"type": "integer", "minimum": 0, "maximum": 3}}, "allOf": [{"if": {"properties": {"arm": {"enum": ["A", "B"]}}}, "then": {"properties": {"seed": {"const": 0}, "null_replica": {"const": 4294967295}}}}, {"if": {"properties": {"arm": {"const": "D"}}}, "then": {"properties": {"seed": {"enum": [1, 2, 3, 4, 5]}, "process_replica": {"const": 0}, "null_replica": {"minimum": 0, "maximum": 7}}}}]},
    "source_blobs": {"type": "object", "additionalProperties": false, "required": ["design", "run_schema", "matrix_schema", "event_schema", "validator", "predecessor_exclusion", "implementation", "arithmetic", "dependency_lock", "fixtures_manifest"], "properties": {"design": {"$ref": "#/$defs/sha256"}, "run_schema": {"$ref": "#/$defs/sha256"}, "matrix_schema": {"$ref": "#/$defs/sha256"}, "event_schema": {"$ref": "#/$defs/sha256"}, "validator": {"$ref": "#/$defs/sha256"}, "predecessor_exclusion": {"$ref": "#/$defs/sha256"}, "implementation": {"$ref": "#/$defs/sha256"}, "arithmetic": {"$ref": "#/$defs/sha256"}, "dependency_lock": {"$ref": "#/$defs/sha256"}, "fixtures_manifest": {"$ref": "#/$defs/sha256"}}},
    "phase_counters": {"type": "object", "additionalProperties": false, "required": ["input", "curve", "factor_base", "table", "query", "verify", "serialize", "total"], "properties": {"input": {"type": "integer", "minimum": 0}, "curve": {"type": "integer", "minimum": 0}, "factor_base": {"type": "integer", "minimum": 0}, "table": {"type": "integer", "minimum": 0}, "query": {"type": "integer", "minimum": 0}, "verify": {"type": "integer", "minimum": 0}, "serialize": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}},
    "candidate_counters": {"type": "object", "additionalProperties": false, "required": ["attempts", "verified", "aborted", "unique", "duplicate_events", "relation_events", "false_positive_events", "relation_unique", "relation_duplicate_events"], "properties": {"attempts": {"type": "integer", "minimum": 0}, "verified": {"type": "integer", "minimum": 0}, "aborted": {"type": "integer", "minimum": 0}, "unique": {"type": "integer", "minimum": 0}, "duplicate_events": {"type": "integer", "minimum": 0}, "relation_events": {"type": "integer", "minimum": 0}, "false_positive_events": {"type": "integer", "minimum": 0}, "relation_unique": {"type": "integer", "minimum": 0}, "relation_duplicate_events": {"type": "integer", "minimum": 0}}},
    "query_counters": {"type": "object", "additionalProperties": false, "required": ["events", "unique", "duplicate_events"], "properties": {"events": {"type": "integer", "minimum": 0}, "unique": {"type": "integer", "minimum": 0}, "duplicate_events": {"type": "integer", "minimum": 0}}}
  }
}
