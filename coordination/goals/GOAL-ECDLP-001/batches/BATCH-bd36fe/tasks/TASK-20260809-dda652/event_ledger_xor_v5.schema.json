{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-autoresearcher.invalid/schemas/event-ledger-xor-v5.schema.json",
  "title": "EXP-XOR-44d232 E.add event ledger v5",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "scope", "event_count", "events", "counters"],
  "properties": {
    "schema": {"const": "event-ledger/xor-v5"},
    "run_id": {"type": "string", "pattern": "^RUN-XOR-[0-9a-f]{6}$"},
    "scope": {"const": "one_complete_arm_zero_based_event_stream"},
    "event_count": {"type": "integer", "minimum": 0},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "counters": {
      "type": "object", "additionalProperties": false,
      "required": ["event_count", "exception_count", "phase_counters", "candidate_counters", "query_counters", "table_bucket_sizes", "table_insert_events"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 0},
        "exception_count": {"type": "integer", "minimum": 0},
        "phase_counters": {"$ref": "#/$defs/phases"},
        "candidate_counters": {"$ref": "#/$defs/candidate"},
        "query_counters": {"$ref": "#/$defs/query"},
        "table_bucket_sizes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "table_insert_events": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phases": {"type": "object", "additionalProperties": false, "required": ["input", "curve", "factor_base", "table", "query", "verify", "serialize"], "properties": {"input": {"type": "integer", "minimum": 0}, "curve": {"type": "integer", "minimum": 0}, "factor_base": {"type": "integer", "minimum": 0}, "table": {"type": "integer", "minimum": 0}, "query": {"type": "integer", "minimum": 0}, "verify": {"type": "integer", "minimum": 0}, "serialize": {"type": "integer", "minimum": 0}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["attempts", "verified", "aborted", "unique", "duplicate_events", "relation_events", "false_positive_events", "relation_unique", "relation_duplicate_events"], "properties": {"attempts": {"type": "integer", "minimum": 0}, "verified": {"type": "integer", "minimum": 0}, "aborted": {"type": "integer", "minimum": 0}, "unique": {"type": "integer", "minimum": 0}, "duplicate_events": {"type": "integer", "minimum": 0}, "relation_events": {"type": "integer", "minimum": 0}, "false_positive_events": {"type": "integer", "minimum": 0}, "relation_unique": {"type": "integer", "minimum": 0}, "relation_duplicate_events": {"type": "integer", "minimum": 0}}},
    "query": {"type": "object", "additionalProperties": false, "required": ["events", "unique", "duplicate_events"], "properties": {"events": {"type": "integer", "minimum": 0}, "unique": {"type": "integer", "minimum": 0}, "duplicate_events": {"type": "integer", "minimum": 0}}},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_index", "phase", "operation", "arguments_digest", "outcome", "returned_identity", "exception_digest", "candidate_identity", "candidate_outcome", "relation_identity", "query_identity", "table_bucket"],
      "properties": {
        "event_index": {"type": "integer", "minimum": 0},
        "phase": {"enum": ["input", "curve", "factor_base", "table", "query", "verify", "serialize"]},
        "operation": {"const": "E.add"},
        "arguments_digest": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["returned", "exception"]},
        "returned_identity": {"type": ["boolean", "null"]},
        "exception_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "candidate_identity": {"type": ["string", "null"]},
        "candidate_outcome": {"enum": ["verified", "aborted", null]},
        "relation_identity": {"type": ["array", "null"], "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "items": false, "minItems": 3, "maxItems": 3},
        "query_identity": {"type": ["string", "null"]},
        "table_bucket": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "returned"}}}, "then": {"properties": {"exception_digest": {"const": null}}}},
        {"if": {"properties": {"outcome": {"const": "exception"}}}, "then": {"properties": {"returned_identity": {"const": null}, "exception_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
      ]
    }
  }
}
