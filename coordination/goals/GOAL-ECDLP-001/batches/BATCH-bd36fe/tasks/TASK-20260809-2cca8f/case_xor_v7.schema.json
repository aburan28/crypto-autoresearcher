{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-autoresearcher.invalid/schemas/case-xor-v7.schema.json",
  "title": "EXP-XOR strict accepted-case fixture schema v7",
  "oneOf": [
    {"$ref": "#/$defs/run_case"},
    {"$ref": "#/$defs/matrix_case"}
  ],
  "$defs": {
    "run_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "fixture_id", "kind", "base", "patch", "expected"],
      "properties": {
        "schema": {"const": "xor-fixture-case/v6"},
        "fixture_id": {"enum": ["completed_valid", "completed_invalid", "failed_infrastructure", "resource_exhaustion", "cancelled_by_budget"]},
        "kind": {"const": "run"},
        "base": {"const": "canonical_run.json"},
        "patch": {"type": "object", "additionalProperties": true},
        "expected": {"type": "object", "additionalProperties": false, "required": ["status", "attempted", "valid", "terminal_reason"], "properties": {"status": {"type": "string"}, "attempted": {"type": "boolean"}, "valid": {"type": "boolean"}, "terminal_reason": {"type": ["string", "null"]}}}
      }
    },
    "matrix_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "fixture_id", "kind", "arm_key", "state", "run_id", "terminal_reason", "included_in_metrics", "wall_repeats", "resource_bytes", "timing_interval", "rss_samples", "expected"],
      "properties": {
        "schema": {"const": "xor-fixture-case/v6"},
        "fixture_id": {"const": "unattempted_matrix_arm"},
        "kind": {"const": "matrix_arm"},
        "arm_key": {"type": "object", "additionalProperties": false, "required": ["p", "b_num", "b_den", "arm", "seed", "process_replica", "null_replica", "shard"], "properties": {"p": {"type": "integer"}, "b_num": {"type": "integer"}, "b_den": {"type": "integer"}, "arm": {"const": "A"}, "seed": {"const": 0}, "process_replica": {"const": 0}, "null_replica": {"const": 4294967295}, "shard": {"type": "integer"}}},
        "state": {"const": "not_attempted"},
        "run_id": {"type": "null"},
        "terminal_reason": {"type": "string", "minLength": 1},
        "included_in_metrics": {"const": false},
        "wall_repeats": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "null"}},
        "resource_bytes": {"type": "object", "additionalProperties": false, "required": ["raw", "stdout", "stderr"], "properties": {"raw": {"const": 0}, "stdout": {"const": 0}, "stderr": {"const": 0}}},
        "timing_interval": {"type": "object", "additionalProperties": false, "required": ["start_ns", "stop_ns", "clock_source", "unit", "flush_complete"], "properties": {"start_ns": {"type": "integer", "minimum": 0}, "stop_ns": {"type": "integer", "minimum": 1}, "clock_source": {"const": "monotonic_ns"}, "unit": {"const": "nanoseconds"}, "flush_complete": {"const": true}}},
        "rss_samples": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "expected": {"type": "object", "additionalProperties": false, "required": ["state", "run_id", "included_in_metrics"], "properties": {"state": {"const": "not_attempted"}, "run_id": {"type": "null"}, "included_in_metrics": {"const": false}}}
      }
    }
  }
}
