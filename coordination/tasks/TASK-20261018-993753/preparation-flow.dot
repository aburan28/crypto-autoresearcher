digraph preparation {
  graph [rankdir=TB, bgcolor="white", pad="0.2"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, fillcolor="#e9f0f7", color="#456b8a"];
  edge [color="#617c91"];
  specs [label="6 unchanged frozen specifications"];
  source [label="6 implementations\n2 non-importing routes + independent oracle each"];
  checks [label="14 synthetic/source tests pass\nNo frozen cell evaluated", fillcolor="#e8f3e9"];
  layouts [label="6 source-bound prospective layouts\n38 closure bindings checked"];
  admission [label="Coordinator IDs + native admission\nPENDING", fillcolor="#fff2d9"];
  trials [label="12 separate route trials\nPENDING", fillcolor="#fff2d9"];
  review [label="Independent checks + route agreement\nfrozen prediction comparisons PENDING", fillcolor="#fff2d9"];
  specs -> source -> checks -> layouts -> admission -> trials -> review;
}
