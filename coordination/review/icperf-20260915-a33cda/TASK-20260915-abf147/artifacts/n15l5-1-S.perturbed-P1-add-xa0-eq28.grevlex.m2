<< "GB_LEADTERMS_LINEAR " << #select(gl, g -> first degree leadTerm g == 1) << endl;
-- quotient dimension from the F4 basis, installed as a GB via forceGB
t2 = cpuTime();
Gf = forceGB G;
J = ideal G;
<< "GB_KRULL_DIM " << dim J << endl;
<< "GB_QUOTIENT_DIM " << (if dim J == 0 then degree J else "not_zero_dimensional") << endl;
<< "DEGREE_CPU_SECONDS " << (cpuTime() - t2) << endl;
<< "GB_ELEMENTS_BEGIN" << endl;
scan(gl, g -> << toString g << endl);
<< "GB_ELEMENTS_END" << endl;
exit 0;
