gl = flatten entries G;
<< "F4_CPU_SECONDS " << (t1 - t0) << endl;
<< "GB_CARDINALITY " << #gl << endl;
<< "GB_MAXDEG " << max apply(gl, g -> first degree g) << endl;
<< "GB_IS_UNIT " << toString any(gl, g -> g == 1_R) << endl;
