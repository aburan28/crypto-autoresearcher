  "command_txt": "# EXP-CERTBIN-ddfe75 / RUN-CERTBIN-6ebb0e -- exact launch (TASK-20260924-7c1fb2).\n# Working directory: repository root. Launched as one bash script; stdout of every\n# step is appended to stdout.log and stderr to stderr.log in this directory.\n# Written before launch (trial-plan-v1.json was written earlier by\n# python3 experiments/EXP-CERTBIN-ddfe75/impl/make_trial_plan.py).\n\nulimit -v 3145728          # 3 GiB address-space cap (machine protection, budget.maximum_memory_gb)\nexport CRYPTO_AR_GF2_BACKEND=native PYTHONDONTWRITEBYTECODE=1 CRYPTO_AR_GF2_THREADS=2 RUN_ID=RUN-CERTBIN-6ebb0e\nunset NCONV_DEV_SLOTS NCONV_DEV_SEED_OFFSET\nRUN=experiments/EXP-CERTBIN-ddfe75/runs/$RUN_ID\n\n# phases 0-4 (specification execution.command), watchdog 86400 s\ntimeout 86400 sh -c \"python3 experiments/EXP-CERTBIN-ddfe75/impl/engine_provenance.py --out $RUN/engine-provenance && \\\n  python3 experiments/EXP-CERTBIN-ddfe75/impl/selftest.py --out $RUN/selftest.json && \\\n  python3 experiments/EXP-CERTBIN-ddfe75/impl/driver.py --spec experiments/EXP-CERTBIN-ddfe75/specification.yaml \\\n    --plan experiments/EXP-CERTBIN-ddfe75/trial-plan-v1.json --run-id $RUN_ID --out $RUN\"\n\n# phase 5 (execution.determinism_command), separate process\ntimeout 86400 python3 experiments/EXP-CERTBIN-ddfe75/impl/driver.py --spec experiments/EXP-CERTBIN-ddfe75/specification.yaml \\\n  --plan experiments/EXP-CERTBIN-ddfe75/trial-plan-v1.json --run-id $RUN_ID --out $RUN --phase determinism\n\n# phase 6 (execution.verify_command), separate process\ntimeout 86400 python3 experiments/EXP-CERTBIN-ddfe75/verifier/verify_nconv.py --run $RUN \\\n  --curve experiments/EXP-CERTBIN-4e92d7/runs/RUN-CERTBIN-3b7e05/curve.json \\\n  --archived experiments/EXP-CERTBIN-e94b27/runs/RUN-CERTBIN-c417e0/instance-sets.json \\\n  --nell coordination/review/certbin-20260924-3d7e1a/reviews/TASK-20260924-d95e70/j9-ptm/n-ell-instances.json \\\n  --out $RUN\n\n# phase 7 (execution.command with --resume)\ntimeout 86400 python3 experiments/EXP-CERTBIN-ddfe75/impl/driver.py --spec experiments/EXP-CERTBIN-ddfe75/specification.yaml \\\n  --plan experiments/EXP-CERTBIN-ddfe75/trial-plan-v1.json --run-id $RUN_ID --out $RUN --resume\n",
