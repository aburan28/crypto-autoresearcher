FROM finite-yaml-qa-base:20260909
RUN ["apt-get", "update"]
RUN ["apt-get", "install", "-y", "--no-install-recommends", "git", "procps"]
RUN ["python", "-m", "pip", "install", "--no-cache-dir", "PyYAML==6.0.3", "jsonschema==4.26.0", "attrs==25.4.0", "jsonschema-specifications==2025.9.1", "referencing==0.37.0", "rpds-py==2026.6.3", "typing-extensions==4.16.0"]
