    "-c",
    "\nimport hashlib,json,os,pathlib,stat,sys\nA=pathlib.Path(sys.argv[1]); au=json.loads((A/'fixture-authority.json').read_text()); seen={}\ndef check(path, expected):\n p=pathlib.Path(path); st=p.lstat()\n assert p.is_absolute() and str(p.resolve())==str(p), str(p)\n assert stat.S_ISREG(st.st_mode) and st.st_nlink==1, (str(p),st.st_nlink)\n actual=hashlib.sha256(p.read_bytes()).hexdigest(); assert actual==expected, str(p)\n seen[str(p)]=actual\ndef walk(obj):\n if isinstance(obj,dict):\n  if 'sha256' in obj:\n   for key in ['path','image','executable']:\n    if key in obj and str(obj[key]).startswith('/'):\n     check(obj[key],obj['sha256']); break\n  for v in obj.values(): walk(v)\n elif isinstance(obj,list):\n  for v in obj: walk(v)\nassert os.getuid()==501\nwalk(au['tools'])\nfor case in au['cases']:\n plan=json.loads((pathlib.Path(case['fixture_root'])/case['plan']['path']).read_text())['execution_plan']\n walk(plan['dependency_closure'])\n assert sys.version==plan['dependency_closure']['python']['version']\n assert dict(os.environ)==plan['environment_policy']['outer'],dict(os.environ)\ncustody=json.loads((A/'linux-runtime-safe-custody.json').read_text()); walk(custody['git_system_config'])\nprint(json.dumps({'runtime_files_verified':len(seen),'path_sha256':seen,'python_version':sys.version,'uid':os.getuid(),'environment':dict(os.environ)},sort_keys=True))\n",
