  "source_excerpts": {
    "title": "Weighted character-support compression for a smaller rank field",
    "mechanism": "Encode available squareclasses as vectors in F_2^k and attach each its independently certified rational twist rank r_d. A subspace W corresponds to a multiquadratic field K_W of degree 2^dim(W). The eigenspace identity gives a lower bound sum_{d in W} r_d from transported displayed points. Optimizing this certified weight over subspaces, rather than taking the largest individual weights, respects the multiplicative closure that defines a field. The new tracked object is the weighted subspace lattice with provenance-bound witnesses. It can expose whether many moderate ranks fit inside degree8 while apparently better individual twists require degree16 or more.",
    "minimal_test": {
      "design": "Paper enumeration of all two-dimensional subspaces in F_2^3 using synthetic nonnegative weights, then verify one basis change and one adversarial support layout.",
      "controls": [
        "Matched null: uniform weights across all characters.",
        "Known-false: choose three high-weight independent characters but falsely assign their support a quadratic field.",
        "Witness control: duplicated point within one twist contributes no extra weight."
      ],
      "required_metrics": [
        "Subspace dimension",
        "Certified weight",
        "Point-certificate count",
        "Transport bit size",
        "Optimality relative to supplied weights"
      ],
      "fixtures": "F_2^3 synthetic weight tables; future actual E/Q and twist witnesses need a frozen contract.",
      "stopping_rule": "Proposal only. Future separately approved paper audit stops at the first counterexample, unmet prerequisite, or 2-hour/2-GB bound. No mathematical experiment executed here."
    },
    "falsification_conditions": [
      "Reported field degree disagrees with squareclass rank.",
      "Claimed optimum misses a supplied subspace.",
      "Transported points fail exact curve equations."
    ],
    "assumptions": [
      "Every r_d is an unconditional lower bound from displayed points on E^(d)/Q.",
      "Squareclass relations and twist transport identities are exact.",
      "k<=6 as in the assigned question; unmeasured twists have weight zero, not an estimated rank."
    ],
    "proof_search_map": {
      "bottleneck": "Rank weights must fit into a low-dimensional squareclass support.",
      "baseline_embedding": {
        "parameter_slice": "W=full space reproduces the standard sum over all twist characters.",
        "reproduction_check": "Uniform weights give A_h=2^h times the common weight."
      },
      "observation_collision": {
        "observable": "Certified weight function on the squareclass subspace lattice.",
        "distinct_preimage_search": "Equal total weights with different support dimensions."
      },
      "constructive_transforms": [
        {
          "transform": "specialization_pack",
          "proposed_object": "Rank-weighted character support.",
          "predicted_gain": "Reduce field degree without weakening witness strength."
        }
      ],
      "quantifier_order": "For the fixed curve and finite certified twist table, there exists an explicit subspace W with degree and rank certificate; no universal rank claim about all twists.",
      "method_ceiling": {
        "strongest_certifiable_claim": "An optimal lower-bound rung within the supplied finite witness set.",
        "nearby_object_control": "Independent squareclasses falsely collapsed into one generator."
      },
      "proof_obligations": [
        {
          "claim": "Squareclass basis certificate",
          "responsibility": "correctness"
        },
        {
          "claim": "Eigenspace independence and transport",
          "responsibility": "correctness"
        },
        {
          "claim": "Finite subspace optimum",
          "responsibility": "size"
        },
        {
          "claim": "Upstream witness charges",
          "responsibility": "runtime"
        }
      ],
      "not_applicable_reason": null
    },
    "interpretation_limits": [
      "Optimal for supplied lower bounds only; unknown ranks may change the best field.",
      "No rank-over-Q inference from nontrivial characters."
    ],
    "novelty_status": "unverified",
