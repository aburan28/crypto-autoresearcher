        "observable": "a disjoint target partition with a costed solver chart attached to each cell",
        "distinct_preimage_search": "Equal branch-stratum counts with different open-locus conditional costs require the retained open residual, not a monodromy-only prediction."
      },
      "constructive_transforms": [
        {
          "transform": "representation_reduction",
