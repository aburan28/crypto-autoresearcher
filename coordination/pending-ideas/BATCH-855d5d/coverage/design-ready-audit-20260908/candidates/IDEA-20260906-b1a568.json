          "responsibility": "size",
          "claim": "Bound all retained data for a disjoint target partition with a costed solver chart attached to each cell including routing cost, conditional solve cost, target coverage, informative rank by chart and certificate storage."
        },
        {
          "responsibility": "runtime",
          "claim": "Derive and charge the entire expression: All chart descriptions/membership+calibration+C_route+selected and fallback solves+union LA+descent+verification; M=all chart bases+models+solver workspace; data=calibration, validation and all target queries."
        },
        {
          "responsibility": "success_probability",
          "claim": "A predicate from the fixed eight-element family predicts a >=25% conditional cost gap that survives held-out targets and exceeds calibration/routing charges. Establish or test this separately from runtime and correctness."
        },
        {
          "responsibility": "strictness",
          "claim": "Exhibit completed controlled evidence or a theorem for C_route+E[C_selected] <=0.8 min_j E[C_j] after common setup, including failed targets; equal solution count or low output degree alone does not establish it."
        }
