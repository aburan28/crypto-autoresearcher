  "source_excerpts": {
    "title": "Rational interval Schur certificates for incremental rank witnesses",
    "mechanism": "From exact curve/point coordinates and a proved bound C on naive-minus-canonical height, repeated doubling gives a rationally enclosed height approximation with error <=C/4^n (and separately enclosed logarithms). Polarization encloses all pairings. First certify an existing block positive definite with rational interval LDL^T; then certify the new point's Schur complement strictly positive by outward rational bounds. The object is a nested positive cone certificate, paired with adding points to a Gram matrix; it discards exact real heights but retains a sound inequality. Cost includes all doubling-coordinate growth and logarithm enclosure, not merely small-matrix algebra.",
    "minimal_test": {
      "design": "Abstract 3x3 Gram matrices with final Schur complement {0,2^-20,1}, rational enclosure widths {2^-10,2^-30}; then source-gated supplied-point height certificates. Do not redispatch ECRANK N1 or alter EXP-ECRANK-76a70d.",
      "controls": [
        {
          "type": "exact_baseline",
          "design": "For an exact rational diagonal Gram matrix diag(1,...,1), zero-width intervals yield LDL pivots all 1 and determinant 1. This is an algebraic certificate fixture, not an elliptic height computation."
        },
        {
          "type": "matched_null",
          "design": "A duplicate point or an exact integer combination of earlier points, with independently permuted point order."
        },
        {
          "type": "known_false",
          "design": "Round interval endpoints inward on a singular matrix; a verifier checking the stated enclosure derivation must reject it."
        },
        {
          "type": "observation_collision",
          "design": "A positive floating approximation and an exactly singular Gram matrix can share coarse intervals; the verifier must return unresolved until the interval excludes singularity."
        }
      ],
      "required_metrics": [
        "certified positive pivot margin per bit of enclosure precision",
        "Rational lower bounds on every LDL pivot and on the final Schur complement.",
        "charged setup, acquisition, attempt, verification and peak-memory costs",
        "invalid/inconclusive outcomes and scope"
      ],
      "budget": {
        "status": "suggested_for_future_coordinator_freeze",
        "maximum_runs_current_task": 0,
        "first_gate_wall_clock_seconds": 600,
        "first_gate_memory_gb": 2,
        "larger_tests": "Unbudgeted and unauthorized; no launch before separate frozen contract."
      },
      "stopping_rules": [
        "Stop the pre-design derivation at any failed domain or baseline identity.",
        "Any missing height-error proof or interval including 0 makes the rank certificate unresolved; a dependent point accepted refutes soundness.",
        "Budget/resource failure is operational, never a mathematical falsification."
      ],
      "required_artifacts": [
        "Exact statement and input domain",
        "Baseline/null/known-false definitions",
        "Independent derivation or counterexample",
        "Symbolic cost decomposition; later runs require separately frozen artifacts"
      ]
    },
    "falsification_conditions": [
      "Any missing height-error proof or interval including 0 makes the rank certificate unresolved; a dependent point accepted refutes soundness.",
      "Round interval endpoints inward on a singular matrix; a verifier checking the stated enclosure derivation must reject it."
    ],
    "assumptions": [
      "Existing ECRANK review-breakthrough impediment remains intact. This is a later certificate alternative, not a replacement for approved current work.",
      "No heuristic supports the certificate. Performance assumption: rational enclosure precision needed for a supplied witness grows moderately with its regulator condition number.",
      "All tests in this card are proposals. No experiment, circuit simulation, solver or certificate verifier was executed."
    ],
