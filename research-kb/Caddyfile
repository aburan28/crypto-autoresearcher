{$KB_HOSTNAME} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
    }
    # Caddy's access log is disabled; bearer headers and private queries stay out of logs.
    reverse_proxy api:8080 {
        flush_interval -1
    }
}
