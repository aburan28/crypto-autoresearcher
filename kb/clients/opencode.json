{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "crypto-kb": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "run",
        "--directory",
        "kb",
        "--extra",
        "index",
        "--extra",
        "mcp",
        "python",
        "-m",
        "crypto_kb.mcp.server"
      ],
      "environment": {
        "CRYPTO_KB_CLIENT": "opencode"
      }
    }
  }
}
