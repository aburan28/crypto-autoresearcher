{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "crypto-kb": {
      "type": "local",
      "enabled": true,
      "command": [
        "uv",
        "--directory",
        "/absolute/path/to/crypto-autoresearcher/kb",
        "run",
        "python",
        "-m",
        "crypto_kb.mcp.server"
      ],
      "environment": {
        "CRYPTO_KB_STORE_BACKEND": "local",
        "CRYPTO_KB_LOCAL_ROOT": "/absolute/path/to/crypto-autoresearcher/kb/.kb-corpus",
        "CRYPTO_KB_QDRANT_URL": "http://localhost:6333",
        "CRYPTO_KB_COLLECTION": "crypto_knowledge_v1",
        "CRYPTO_KB_CLIENT": "opencode",
        "CRYPTO_KB_QUERY_LOG_PATH": "/absolute/path/to/crypto-autoresearcher/kb/.kb-queries.jsonl"
      }
    }
  }
}
