# Copy to terraform.tfvars and edit. That file is gitignored — it names your
# organization and may hold credentials.

# Required. The organization must already exist; create it at
# https://app.terraform.io/app/organizations/new (the free tier is enough for
# this configuration).
organization = "your-org-name"

# Optional overrides.
# project_name      = "crypto-kb"
# workspace_prefix  = "crypto-kb"
# aws_region        = "us-west-2"
# corpus_bucket     = "crypto-autoresearcher"
# terraform_version = "1.9.8"

# -- VCS-driven runs (optional; can be added later) -------------------------
# Connect GitHub under Settings -> Providers first, then paste the token id.
# vcs_repo_identifier = "aburan28/crypto-autoresearcher"
# vcs_branch          = "main"
# vcs_oauth_token_id  = "ot-xxxxxxxxxxxxxxxx"

# -- AWS credentials --------------------------------------------------------
# Leave these unset and use dynamic credentials (OIDC) instead — see the OIDC
# section of ../README.md. Setting them creates a long-lived key that has to
# be rotated by hand and that lives in HCP Terraform indefinitely.
# aws_access_key_id     = ""
# aws_secret_access_key = ""

# notification_email = "you@example.com"
