# Copy to kb/.env. Every setting is also an environment variable.
# Defaults are the local vertical slice: filesystem corpus, embedded Qdrant.

# -- object store ----------------------------------------------------------
CRYPTO_KB_STORE_BACKEND=local          # local | s3
CRYPTO_KB_LOCAL_ROOT=./.kb-corpus
# CRYPTO_KB_S3_BUCKET=crypto-autoresearcher
# CRYPTO_KB_AWS_REGION=us-west-2
# CRYPTO_KB_AWS_PROFILE=crypto-research
# CRYPTO_KB_S3_ENDPOINT_URL=            # MinIO / LocalStack

# -- index -----------------------------------------------------------------
# ":memory:" is per-process. An MCP server started with it serves an empty
# index -- run `make qdrant-up` and point at it before connecting a client.
# This file is where machine-specific settings belong: the MCP client configs
# deliberately set only CRYPTO_KB_CLIENT, because anything they do set
# overrides .env and would need editing in three places per machine.
CRYPTO_KB_QDRANT_URL=http://localhost:6333
# A file-backed embedded index needs no Docker, but is single-writer: a
# connected MCP server holds the lock and `crypto-kb ingest` will fail.
# CRYPTO_KB_QDRANT_URL=./.kb-index
# CRYPTO_KB_QDRANT_API_KEY=
CRYPTO_KB_COLLECTION=crypto_knowledge_v1

# -- embedding -------------------------------------------------------------
# Changing the backend, the model, or the dimension changes vector semantics.
# Bump CRYPTO_KB_COLLECTION with it; never mutate a collection in place.
CRYPTO_KB_DENSE_BACKEND=hashing        # hashing | sentence-transformers
CRYPTO_KB_DENSE_MODEL_NAME=hashing-ngram-v1
CRYPTO_KB_DENSE_DIMENSION=512

# -- retrieval -------------------------------------------------------------
CRYPTO_KB_DEFAULT_TOP_K=6
CRYPTO_KB_MAX_TOP_K=10
CRYPTO_KB_MAX_CHUNKS_PER_SOURCE=2
CRYPTO_KB_RERANK_BACKEND=none          # none | cross-encoder
# CRYPTO_KB_RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# -- ingestion worker ------------------------------------------------------
# CRYPTO_KB_SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/…/crypto-kb-prod-ingest
CRYPTO_KB_SQS_VISIBILITY_TIMEOUT=900   # must exceed the slowest Docling parse

# -- observability ---------------------------------------------------------
CRYPTO_KB_LOG_LEVEL=info
# CRYPTO_KB_QUERY_LOG_PATH=./.kb-queries.jsonl
# CRYPTO_KB_METRICS_PORT=9090

# -- client identity (set by the MCP client, recorded in the query log) -----
# CRYPTO_KB_CLIENT=claude-code
# CRYPTO_KB_AGENT=idea-generator
# CRYPTO_KB_TASK_ID=TASK-20260803-001
