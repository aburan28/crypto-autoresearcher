{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-autoresearcher/knowledge/metadata-schema.json",
  "title": "Knowledge source sidecar metadata",
  "description": "Companion to every object under knowledge/source/. Written by hand or derived deterministically from repository records. Model-suggested values are permitted only in `topics` and must set provenance_class accordingly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "title", "source_type"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[^\\s]+$",
      "description": "Namespaced stable id, e.g. paper:eprint-2026-1486 or experiment:EXP-SIG-001."
    },
    "title": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": ["paper", "internal-note", "experiment", "proof", "ledger", "repository-doc"]
    },
    "authors": {"type": "array", "items": {"type": "string"}},
    "publication_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
    "publication_status": {"type": ["string", "null"]},
    "primitive": {"type": "array", "items": {"type": "string"}},
    "field_type": {"type": "array", "items": {"type": "string"}},
    "curves": {"type": "array", "items": {"type": "string"}},
    "topics": {"type": "array", "items": {"type": "string"}},
    "claim_status": {
      "enum": [
        "external-source", "published", "supported", "reproduced",
        "weakened", "rejected-scoped", "inconclusive", "hypothesis"
      ]
    },
    "evidence_level": {
      "enum": [
        "machine-checked", "independently-reproduced", "replicated",
        "single-run", "analytical", "none", null
      ]
    },
    "authority": {
      "enum": [
        "machine-checked-proof", "reproduced-experiment", "single-run-experiment",
        "peer-reviewed-source", "unreviewed-preprint", "internal-analysis",
        "agent-hypothesis", "primary-source", null
      ]
    },
    "superseded": {"type": "boolean"},
    "superseded_by": {"type": ["string", "null"]},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "experiment_id": {"type": ["string", "null"]},
    "related_experiments": {"type": "array", "items": {"type": "string"}},
    "run_ids": {"type": "array", "items": {"type": "string"}},
    "git_commit": {"type": ["string", "null"]},
    "verification_artifacts": {"type": "array", "items": {"type": "string"}},
    "source_url": {"type": ["string", "null"]},
    "provenance_class": {
      "enum": ["deterministic", "human-authored", "model-suggested"],
      "default": "human-authored"
    }
  }
}
