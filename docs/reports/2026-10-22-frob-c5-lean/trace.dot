digraph C5 {
  graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", fontsize=14,
         label="EXP-FROB-91ee9c C5: algebraic proof boundary", labelloc=t,
         pad=0.25, nodesep=0.3, ranksep=0.5];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#425466", fillcolor="#eaf3fc", margin="0.12,0.08"];
  edge [color="#425466", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  premise [label="Lean hypotheses\nF⁵ = 1; 5 ≠ 0 in R"];
  identity [label="Proved polynomial identities\nT(F)(F−1) = 0\nT(F)−5 = (F−1)P(F)", fillcolor="#d8eadb"];
  core [label="Kernel theorem\nker T(F) = range(F−1)", fillcolor="#cde9d1"];
  fixed [label="Fixed-space exclusion\nFix(F) ∩ ker T(F) = {0}", fillcolor="#cde9d1"];
  frozen [label="Archived cells q=11,13,19\nreported dim ker T = 4", fillcolor="#f8ecd4"];
  full [label="Full C5 cell claim\nfactor-kernel direct sum = ker Tr\ncell-specific dimension and Frobenius map", fillcolor="#f8ecd4"];
  premise -> identity -> core;
  premise -> fixed;
  identity -> fixed;
  frozen -> full [style=dashed, label="reported computation"];
  core -> full [style=dashed, color="#b36b36", label="Lean linkage open"];
}
