digraph C5QuotientKernelTransport {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.35, ranksep=0.42, pad=0.14];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
  edge [arrowsize=0.7, penwidth=1.3];
  frozen [label="Frozen C5 moduli and matrices\nq=11, 13, 19", fillcolor="#fff6e5", color="#b87823"];
  columns [label="Lean quotient-basis divisions\n75 exact q-power coordinates", fillcolor="#eaf4ee", color="#297148"];
  fullmap [label="Lean full q-power map\ntoMatrix = frozen 5×5 matrix", fillcolor="#eaf4ee", color="#297148"];
  matrix [label="Lean exact matrix controls\ntrace rank 1; M⁵ = I", fillcolor="#eaf4ee", color="#297148"];
  factors [label="Lean factor polynomials\nq11: four linear; q13: quartic; q19: two quadratic", fillcolor="#eaf4ee", color="#297148"];
  quotient [label="NEW: actual quotient endomorphisms\nfactor sums = trace kernels; dim 4\nfixed dim 1 and disjoint; F⁵ = I", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  open [label="Open historical bridge: Sage refinement, execution-source custody,\nindependent semantic/code review; C8 and full run gate", style="rounded,dashed,filled", fillcolor="#fff1ef", color="#aa4b3c"];
  frozen -> columns -> fullmap;
  frozen -> matrix;
  fullmap -> quotient;
  matrix -> quotient;
  factors -> quotient;
  quotient -> open [style=dashed, color="#aa4b3c"];
}
