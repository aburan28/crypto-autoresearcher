digraph ecml {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.22", ranksep="0.3",
         fontname="DejaVu Sans", label="ML proposes; exact mathematics evaluates", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#edf4f7", color="#246477",
        fontname="DejaVu Sans", fontsize=10, margin="0.12,0.08"];
  edge [color="#246477", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  data [label="Public curves, targets and factor bases\nSplit whole prime fields before fitting"];
  generator [label="Implemented: EC summation polynomial S3\nPublic input features; no hidden logs"];
  ml [label="Implemented: ridge / contextual bandit\nChoose one of four fixed algebra solvers"];
  roots [label="Solve; lift x roots to signed points\nVerify P1 + P2 - Q = O exactly"];
  rank [label="Merge point aliases and negations\nIndependent rows modulo n; is q identified?"];
  cost [label="Retain valid rank and verified scalars\nCharge generation, labels, fit, solve and checks"];
  controls [label="Fixed / random / shuffled-label controls\nPositive / constant controls; exact BSGS comparator"];
  newsearch [label="Proposed: learned lift / factor-base / map search",
             color="#888888", fillcolor="#f5f5f5", style="rounded,filled,dashed"];
  confirm [label="Proposed: fresh matched-field confirmation\n99.9% joint coverage; independent review",
           color="#888888", fillcolor="#f5f5f5", style="rounded,filled,dashed"];
  data -> generator -> ml -> roots -> rank -> cost;
  generator -> newsearch [style=dashed, color="#888888"];
  newsearch -> roots [style=dashed, color="#888888"];
  controls -> cost;
  cost -> confirm [style=dashed, color="#888888"];
  cost -> ml [style=dashed, label="training fields only", constraint=false];
}
