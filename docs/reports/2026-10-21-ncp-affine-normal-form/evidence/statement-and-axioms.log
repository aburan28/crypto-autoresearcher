CryptoResearch.NCP.word_action_affine_normal_form {B n : ℕ} (s : Fin B → ZMod n)
  (w : List (CryptoResearch.NCP.Letter B)) (x : ZMod n) :
  CryptoResearch.NCP.wordAction s w x =
    ↑(CryptoResearch.NCP.shadowSign w) * x + ∑ i, ↑(CryptoResearch.NCP.signedCount w i) * s i
CryptoResearch.NCP.cyclic_word_action_affine_normal_form.{u_1} {B : ℕ} {G : Type u_1} [AddCommGroup G] (P : G)
  (s : Fin B → ℤ) (w : List (CryptoResearch.NCP.Letter B)) (x : G) :
  CryptoResearch.NCP.groupWordAction (fun i => s i • P) w x =
    CryptoResearch.NCP.shadowSign w • x + (∑ i, CryptoResearch.NCP.signedCount w i * s i) • P
CryptoResearch.NCP.group_same_shadow_same_action.{u_1} {B : ℕ} {G : Type u_1} [AddCommGroup G] (T : Fin B → G)
  (w v : List (CryptoResearch.NCP.Letter B)) (hsign : CryptoResearch.NCP.shadowSign w = CryptoResearch.NCP.shadowSign v)
  (hcount : ∀ (i : Fin B), CryptoResearch.NCP.signedCount w i = CryptoResearch.NCP.signedCount v i) (x : G) :
  CryptoResearch.NCP.groupWordAction T w x = CryptoResearch.NCP.groupWordAction T v x
'CryptoResearch.NCP.word_action_affine_normal_form' depends on axioms: [propext, Classical.choice, Quot.sound]
'CryptoResearch.NCP.cyclic_word_action_affine_normal_form' depends on axioms: [propext, Classical.choice, Quot.sound]
'CryptoResearch.NCP.group_same_shadow_same_action' depends on axioms: [propext, Classical.choice, Quot.sound]
