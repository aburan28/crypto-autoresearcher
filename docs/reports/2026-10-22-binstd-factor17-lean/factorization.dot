digraph BINSTDFactorProof {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.45, ranksep=0.6, pad=0.2];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.11"];
  edge [arrowsize=0.7, penwidth=1.3];
  archived [label="Frozen n=17 Stage-1 table\nbitmask factors 3, 313, 471", fillcolor="#eef2f9", color="#4b6584"];
  factors [label="F₂[X] polynomials\nX+1\nX⁸+X⁵+X⁴+X³+1\nX⁸+X⁷+X⁶+X⁴+X²+X+1", fillcolor="#eaf4ee", color="#297148"];
  product [label="Lean theorem x17_factorization\nproduct = X¹⁷+1", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  gap1 [label="Not yet proved in Lean\neach degree-8 factor irreducible", style="rounded,dashed,filled", fillcolor="#fff6e5", color="#b87823"];
  gap2 [label="Not yet proved in Lean\nnormal-basis Frobenius module bridge\nall invariant dimensions", style="rounded,dashed,filled", fillcolor="#fff6e5", color="#b87823"];
  yield [label="Empirical toy yield\nseparate archived run evidence\nno theorem of performance", style="rounded,dashed,filled", fillcolor="#f2f3f7", color="#6d7280"];
  archived -> factors -> product;
  product -> gap1 -> gap2 -> yield;
}
