digraph frob_c5 {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.38", ranksep="0.62", fontname="DejaVu Sans", fontsize=17, label="FROB C5: finite-field trace core proved; run bridge open", labelloc=t];
  node [shape=box, style="rounded,filled", color="#34536a", fillcolor="#e6f1fa", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.1"];
  edge [color="#66829a", penwidth=1.4, arrowsize=0.65];

  mathlib [label="Mathlib finite-field facts\nFrobenius powers, trace sum\ntrace surjectivity, rank-nullity", fillcolor="#dcecff"];
  orderfive [label="Earlier Lean OrderFive theorem\nker(1+F+...+F^4)=range(F-1)\nif F^5=1 and char != 5", fillcolor="#dcecff"];
  new [label="New Lean finite-field theorem\ntrace5 = embedded field trace\nker dimension = 4\nker = range(F-1), char != 5", fillcolor="#d7efe3"];
  cells [label="GaloisField q 5 instances\nq = 11, 13, 19\ndimension 4", fillcolor="#d7efe3"];
  factors [label="Open: direct sum of nontrivial\nX^5-1 factor kernels", fillcolor="#fff0d6"];
  model [label="Open: archived Fq[z]/(g) basis,\nFrobenius code and source custody", fillcolor="#f8dedc", color="#a34c48"];
  review [label="Independent semantic and code review\npending; C5 run verdict not promoted", fillcolor="#fff0d6"];

  mathlib -> new;
  orderfive -> new;
  new -> cells;
  cells -> factors [style=dashed];
  cells -> model [style=dashed, color="#a34c48"];
  {factors model} -> review [style=dashed];
}
