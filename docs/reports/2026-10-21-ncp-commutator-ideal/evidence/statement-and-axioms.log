theorem CryptoResearch.NCP.kernel_not_generated_by_commutators : ∀ (B n : ℕ) (s : Fin B → ZMod n),
  TwoSidedIdeal.ker (CryptoResearch.NCP.evalRho B n s) ≠ CryptoResearch.NCP.commutatorIdeal B :=
fun B n s heq =>
  have hker := CryptoResearch.NCP.neg_witness_mem_evalRho_ker B n s;
  CryptoResearch.NCP.neg_square_sub_one_not_mem_commutatorIdeal B
    (Eq.mp (congrArg (fun _a => CryptoResearch.NCP.negGenerator B ^ 2 - 1 ∈ _a) heq) hker)
'CryptoResearch.NCP.kernel_not_generated_by_commutators' depends on axioms: [propext, Classical.choice, Quot.sound]
'CryptoResearch.NCP.neg_square_sub_one_not_mem_commutatorIdeal' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'CryptoResearch.NCP.neg_witness_mem_evalRho_ker' depends on axioms: [propext, Classical.choice, Quot.sound]
