digraph C5FactorProof {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.38, ranksep=0.36, pad=0.14];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, color="#274c77", fillcolor="#edf5ff", margin="0.16,0.10"];
  edge [color="#526b88", arrowsize=0.75, penwidth=1.4];
  frozen [label="Frozen C5 factors\nq11: four linears\nq13: one quartic\nq19: two quadratics", fillcolor="#fff6e5", color="#b87823"];
  exact [label="Lean: exact Φ₅ factorization\n+ irreducibility\n+ coprimality", fillcolor="#eaf4ee", color="#297148"];
  crt [label="Mathlib kernel CRT\nprogressive disjoint sum\n= ker Φ₅(F)", fillcolor="#eaf4ee", color="#297148"];
  trace [label="FiniteFieldTrace.lean\nΦ₅(F) = embedded trace\ntrace kernel dimension 4", fillcolor="#eaf4ee", color="#297148"];
  result [label="Canonical GaloisField models\nq11, q13, q19: factor sum\n= trace kernel, dim 4", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  replay [label="Source-bound 5×5 matrix replay\nq11: 1+1+1+1; q13: 4; q19: 2+2\nfull C5 gate rejects matrix mutation", fillcolor="#fff6e5", color="#b87823"];
  char5 [label="Lean negative control: q=5\nX⁵−1 = (X−1)⁵\nnot squarefree", fillcolor="#fff1ef", color="#aa4b3c"];
  bridge [label="Open: archived Fq[z]/g basis,\nFrobenius matrix and input bytes\n→ canonical field model", style="rounded,dashed,filled", fillcolor="#fff1ef", color="#aa4b3c"];
  frozen -> exact -> crt -> result;
  trace -> result;
  frozen -> replay [color="#b87823"];
  replay -> bridge [style=dashed, color="#aa4b3c"];
  char5 -> bridge [style=dotted, color="#aa4b3c", label="proof boundary", fontcolor="#aa4b3c"];
  bridge -> result [style=dashed, color="#aa4b3c", label="not yet checked", fontcolor="#aa4b3c"];
}
