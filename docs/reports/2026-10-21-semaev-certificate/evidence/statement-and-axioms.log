theorem CryptoResearch.Semaev.decidable_validDecomposition.{u_1, u_2} : ∀ {F : Type u_1} {K : Type u_2} [inst : Field F]
  [inst_1 : Fintype F] [inst_2 : Field K] [inst_3 : DecidableEq K] [inst_4 : Algebra F K] {b m : ℕ}
  (W : WeierstrassCurve.Affine K) (basis : Fin b → K) (P : Fin m → W.Point) (R : W.Point),
  decide (CryptoResearch.Semaev.validDecomposition W basis P R) = true ↔
    (∀ (i : Fin m),
        match P i with
        | WeierstrassCurve.Affine.Point.zero => False
        | WeierstrassCurve.Affine.Point.some x y h => W.Equation x y ∧ x ∈ Submodule.span F (Set.range basis)) ∧
      ∑ i, P i = R :=
fun {F} {K} [Field F] [Fintype F] [Field K] [DecidableEq K] [Algebra F K] {b m} W basis P R =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          _a ↔
            (∀ (i : Fin m),
                match P i with
                | WeierstrassCurve.Affine.Point.zero => False
                | WeierstrassCurve.Affine.Point.some x y h => W.Equation x y ∧ x ∈ Submodule.span F (Set.range basis)) ∧
              ∑ i, P i = R)
        decide_eq_true_eq))
    (CryptoResearch.Semaev.validDecomposition_iff_curve_span_sum W basis P R)
