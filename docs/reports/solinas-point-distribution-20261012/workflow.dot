digraph PointDistribution {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.3", ranksep="0.25"];
  node [shape=box, style="rounded,filled", fillcolor="#edf3f9", color="#3d607c", fontname="DejaVu Sans", fontsize=11];
  edge [color="#60768a", arrowsize=0.6];
  fields [label="18-/20-bit sparse prime blocks\nS + 2 random + 2 residue controls\n5,120 fields / 20,480 curves"];
  nist [label="P-192 / P-224 public pools\n3,328 whole curves\n578 fields; S prime fixed per case"];
  weights [label="Exact toy census + probes on every curve\n4,096 uniform / 2,048 contiguous x coordinates\nw(x) = 1 + chi(x^3 + Ax + B)\n0, 1 or 2 points above each x", fillcolor="#e8f1e8"];
  controls [label="Verified coordinate isomorphism\nShuffled windows\nSynthetic clustered-statistic check", fillcolor="#fff3df"];
  metrics [label="Point-count variation\nAdjacent-coordinate correlation\nWeighted x-bin dispersion"];
  uncertainty [label="24 fixed comparisons\nField/curve-cluster intervals\nApprox. nominal 99.9% joint coverage", fillcolor="#e8f1e8"];
  fields -> weights;
  nist -> weights;
  weights -> metrics -> uncertainty;
  weights -> controls -> metrics;
  {rank=same; fields; nist;}
  {rank=same; controls; metrics;}
}
