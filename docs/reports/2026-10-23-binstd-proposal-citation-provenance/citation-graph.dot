digraph citation_provenance {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.45", ranksep="0.7", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#3b5266", fillcolor="#edf4f8"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#42677c"];

  upstream [label="Four literature sources\nabstracts read only", fillcolor="#f5f2e9"];
  card [label="KR-IC-73db3f\ninternal heuristic card\nsmall V product spaces", fillcolor="#d9e9f3"];
  first [label="IDEA-20261003-94078e\nadaptation proposal\narchived record preserved", fillcolor="#e8f5e8"];
  second [label="IDEA-20261003-c9c6c3\nadaptation proposal\narchived record preserved", fillcolor="#e8f5e8"];

  upstream -> card [label="reported by card", style=dashed];
  card -> first [label="source read; citation narrowed"];
  card -> second [label="source read; citation narrowed"];
}
