digraph HigherOrder {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.25", ranksep="0.4", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#edf3f8", color="#66849a", fontname="DejaVu Sans", fontsize=10, margin="0.15"];
  edge [color="#667b8b", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  old [label="Frozen previous run\n46.4 million public points", fillcolor="#f0f0f0"];
  discover [label="Old-data feature scan\nExploratory comparisons + locked ML training", fillcolor="#f0f0f0"];
  standard [label="Exact standard curves\nEC1P192Cniststandardhb4bdde6340ec\nEC1P224Cniststandardhe2397ca7cfb5"];
  walks [label="Fresh paired random-start walks\nPublished G versus new random H"];
  bank [label="98,304 random H per curve\nTrimmed prefix: 17H ... 272H"];
  targets [label="160 targeted H per curve\nFive special-coordinate regions"];
  fields [label="Random coefficient models\nFixed S prime + matched R/C fields"];
  verify [label="Hashes + all on-curve checks\nIndependent affine oracle\nShuffle, sort, wrong-step, u=2 controls", fillcolor="#e8f4ee"];
  statistics [label="78 frozen primary comparisons\n58 mean/accuracy intervals + 20 rarity benchmarks\nNominal family confidence 99.9%", fillcolor="#e8f4ee"];
  inference [label="Measured descriptive observations\nFinite scope; no ECDLP-resistance inference", fillcolor="#fbf1df"];
  old -> discover;
  standard -> walks; standard -> bank; standard -> targets;
  walks -> verify; bank -> verify; targets -> verify; fields -> verify;
  verify -> statistics;
  discover -> statistics [label="fixed classifier on fresh test points"];
  statistics -> inference;
}
