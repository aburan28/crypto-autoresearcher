digraph frob_audit {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.7", fontname="DejaVu Sans", fontsize=18, label="FROB historical validation: exact replay, incomplete source custody", labelloc=t];
  node [shape=box, style="rounded,filled", color="#284766", fillcolor="#e7f1fb", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.11"];
  edge [color="#607e99", penwidth=1.5, arrowsize=0.7];

  manifest [label="Frozen run manifest\nRUN-FROB-91ee9c-7119f2", fillcolor="#dcecff"];
  artifacts [label="14 / 14 artifact hashes and sizes match\n566,042 recorded bytes", fillcolor="#d7efe3"];
  checker [label="Pure-Python checker replay\noutput byte-identical to archive", fillcolor="#d7efe3"];
  checked [label="3 / 3 trace-kernel dimensions\n6 / 6 orbit divisibility values\n3 / 6 curve witnesses checked\n23 / 23 aggregate identities; mutant rejected", fillcolor="#d7efe3"];
  core [label="All-core object replay\n370,100 subgroup points classified\n20,960 tuple identities (400 multi-slot sums)\n3 q11n5 mutations rejected", fillcolor="#d7efe3"];
  controls [label="First-curve C2 exact replay\n238,350 points; 13,242 archived singleton tuples\n3 residue lists matched; mutant rejected\nC3: 6 aggregate rows only", fillcolor="#d7efe3"];
  nulls [label="C4 null-curve geometry\n3 accepted + 2 rejected curve orders certified\nLean: conditional order uniqueness\n143,568 points; 3 mutants rejected\n6 rows; generated samples only", fillcolor="#d7efe3"];
  partial [label="C8 gate incomplete:\nC3/C4 historical sample identities absent\nArchived checker skips 3 curve entries\nExtension: not_run_resource", fillcolor="#fff0d6"];
  source [label="Recorded pre-run HEAD cb06b8c\ndoes not contain driver\nrun directory was untracked", fillcolor="#f8dedc", color="#a34c48"];
  boundary [label="No Sage generator replay or original\nexecution-source binding\nNo performance or attack certification", fillcolor="#f8dedc", color="#a34c48"];

  manifest -> artifacts -> checker -> checked;
  artifacts -> core;
  artifacts -> controls;
  artifacts -> nulls;
  checker -> partial [style=dashed];
  manifest -> source [style=dashed, color="#a34c48"];
  {checked core controls nulls partial source} -> boundary [color="#a34c48"];
}
