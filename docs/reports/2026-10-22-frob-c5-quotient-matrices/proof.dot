digraph QuotientMatrix {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.35, ranksep=0.32, pad=0.12];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, color="#274c77", fillcolor="#edf5ff", margin="0.16,0.10"];
  edge [color="#526b88", arrowsize=0.75, penwidth=1.4];
  frozen [label="RUN-FROB-91ee9c-7119f2\nthree quotient moduli\nand q-power matrix outputs", fillcolor="#fff6e5", color="#b87823"];
  replay [label="Source-bound replay receipt\nSHA-256 22bcbdbd…\n5×5 matrices q11, q13, q19", fillcolor="#fff6e5", color="#b87823"];
  generator [label="Independent long division\nX^(q·j) = remainder + g·quotient\nchecks 75 recorded entries", fillcolor="#edf5ff", color="#274c77"];
  lean [label="Lean / AdjoinRoot power basis\n12 exact division certificates\n75 quotient-basis matrix entries", fillcolor="#eaf4ee", color="#297148"];
  factor [label="Separate canonical-field proof\nnontrivial factor kernels\n= trace kernel, dimension 4", fillcolor="#eaf4ee", color="#297148"];
  open [label="Open: historical Sage refinement,\noriginal source custody and\nindependent semantic review", style="rounded,dashed,filled", fillcolor="#fff1ef", color="#aa4b3c"];
  frozen -> replay -> generator -> lean;
  lean -> open [style=dashed, color="#aa4b3c"];
  factor -> open [style=dashed, color="#aa4b3c"];
}
