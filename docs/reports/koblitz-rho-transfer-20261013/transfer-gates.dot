digraph KoblitzTransfer {
  graph [rankdir=TB, bgcolor="white", fontname="Helvetica", labelloc="t",
         label="K-163 vertical-transfer decision graph (status at 2026-10-13)"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
        color="#34495e", fillcolor="#eef4f8"];
  edge [fontname="Helvetica", fontsize=9, color="#34495e"];

  source [label="sect163k1 source\n(D_K=-7, f_pi=1824026374634505274957943, f_E=1)\narchived native tau checks",
          fillcolor="#d9f2e6"];
  source_tau [label="source signed-tau rho\n2m=326 orbit\nmodel: 12.767x fewer transitions vs negation",
              fillcolor="#d9f2e6"];
  source_neg [label="source negation rho\ncomparison arm", fillcolor="#f6f1dc"];
  floor [label="conductor-45641 endpoint\n(D_K=-7, same f_pi, f_E=45641)\nendpoint/level archived; point map+dual missing",
         fillcolor="#fde2df", color="#b03a2e"];
  floor_conj [label="Frobenius-conjugate endpoint E_(b^2)\nnot a self-action on E_b", fillcolor="#f7e9d7"];
  floor_neg [label="endpoint negation rho\nconditional arm", fillcolor="#f6f1dc"];
  transported [label="endpoint T diagnostic\n[d^-1] phi tau dual(phi)\nsubgroup action untested", fillcolor="#fde2df", color="#b03a2e"];
  once [label="one-time transfer control\ndual(G'), dual(Q') -> solve on source -> verify",
        fillcolor="#dce8f7"];

  source -> source_tau [label="inseparable tau action\ndegree 2; native"];
  source -> source_neg [label="negation only"];
  source -> floor [label="degree 45641; separable; F_(2^163)\nendpoint-producing kernel computation archived\nevaluable phi/dual NOT retained",
                   style=dashed, color="#b03a2e"];
  floor -> floor_conj [label="absolute Frobenius", style=dotted, color="#9a7d0a"];
  floor -> floor_neg [label="only if no better action is certified"];
  floor -> transported [label="requires phi + dual + composition + subgroup checks",
                        style=dashed, color="#b03a2e"];
  floor -> once [label="requires dual once", style=dashed, color="#2e86c1"];
  once -> source_tau [label="native incumbent"];
  transported -> once [label="must beat complete one-time route", style=dotted];
}
