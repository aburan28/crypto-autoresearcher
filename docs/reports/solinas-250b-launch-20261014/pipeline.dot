digraph campaign {
  graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.25", ranksep="0.3"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#234357", fillcolor="#edf5fa"];
  edge [color="#234357", arrowsize=0.7];
  inputs [label="Frozen source, public curves and fresh seed\nExact target: 250,000,000,000 observations"];
  cohorts [label="P-192 / P-224: selected, published and random steps\n125 ordinary-prime control models (62 R + 63 C)"];
  workers [label="3 detached worker processes\n256-point windows; bounded chunk queue"];
  checks [label="Every point finite and on-curve\nEvery score replayed; separate coordinate-frame checks"];
  retained [label="Aggregate retention selected October 14\nExact counts and hashes + fixed full-coordinate samples", fillcolor="#eaf5ec"];
  final [label="Only after exact completion\nAutomatic locked analysis; no agent per batch", fillcolor="#fff4dc"];
  inputs -> cohorts -> workers -> checks -> retained -> final;
}
