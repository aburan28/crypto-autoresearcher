digraph PriorArt {
  graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", label="Archived prior-art correction: KB attribution only", labelloc=t, fontsize=16];
  node [fontname="DejaVu Sans", fontsize=10, style=filled, color="#516174"];
  edge [fontname="DejaVu Sans", fontsize=8, color="#64748b", label="kb · adjacent"];
  subgraph cluster_cards {
    label="Read committed cards (upstream literature not re-reviewed)";
    color="#cbd5e1";
    "KR-IC-f5c584" [label="f5c584\nbinary trace", fillcolor="#dbeafe"];
    "KR-IC-fbdb61" [label="fbdb61\nfall invariants", fillcolor="#dbeafe"];
    "KR-IC-889857" [label="889857\ndispute", fillcolor="#dbeafe"];
    "KR-IC-73db3f" [label="73db3f\nV choice", fillcolor="#dbeafe"];
    "KR-IC-1fcdbc" [label="1fcdbc\nmeasured negative", fillcolor="#dbeafe"];
    "KR-RHO-825bca" [label="825bca\nprime-field rho", fillcolor="#fef3c7"];
  }
  subgraph cluster_proposals {
    label="Additive replacements; frozen proposals retained";
    color="#cbd5e1";
    "486aa2" [label="486aa2\nodd-p control", fillcolor="#dcfce7"];
    "839ced" [label="839ced\nshift null", fillcolor="#dcfce7"];
    "8f4f02" [label="8f4f02\nbinary shift", fillcolor="#dcfce7"];
    "ef3939" [label="ef3939\ncost audit", fillcolor="#dcfce7"];
  }
  "KR-IC-f5c584" -> "486aa2";
  "KR-IC-fbdb61" -> "486aa2";
  "KR-IC-889857" -> "486aa2";
  "KR-IC-73db3f" -> "839ced";
  "KR-IC-fbdb61" -> "839ced";
  "KR-IC-889857" -> "839ced";
  "KR-IC-fbdb61" -> "8f4f02";
  "KR-IC-f5c584" -> "8f4f02";
  "KR-IC-889857" -> "8f4f02";
  "KR-IC-1fcdbc" -> "ef3939";
  "KR-IC-889857" -> "ef3939";
  "KR-IC-73db3f" -> "ef3939";
  "KR-RHO-825bca" -> "ef3939" [style=dashed, label="discipline only"];
}
