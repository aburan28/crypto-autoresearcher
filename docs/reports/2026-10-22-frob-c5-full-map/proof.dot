digraph C5FullFrobenius {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.38, ranksep=0.42, pad=0.14];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.15,0.10"];
  edge [arrowsize=0.7, penwidth=1.3];
  frozen [label="Frozen C5 moduli and q-power matrices\nq11, q13, q19", fillcolor="#fff6e5", color="#b87823"];
  columns [label="Lean quotient-basis certificate\n75 exact q-power image coordinates", fillcolor="#eaf4ee", color="#297148"];
  linear [label="Mathlib Frobenius algebra homomorphism\nfull q-power map is base-field linear", fillcolor="#eaf4ee", color="#297148"];
  matrix [label="Lean toMatrix theorem\nall 75 entries equal frozen matrices", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  kernels [label="Lean exact matrix C5 theorem\nfactor sums = trace kernels, dim 4", fillcolor="#eaf4ee", color="#297148"];
  quotient [label="Lean quotient-level C5 controls\nfactor sums, trace dim 4, fixed dim 1", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  open [label="Open: historical Sage refinement, custody and review; C8", style="rounded,dashed,filled", fillcolor="#fff1ef", color="#aa4b3c"];
  frozen -> columns -> matrix;
  linear -> matrix -> kernels -> quotient;
  quotient -> open [style=dashed, color="#aa4b3c"];
}
