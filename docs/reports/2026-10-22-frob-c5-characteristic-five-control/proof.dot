digraph CharFiveControl {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.6, ranksep=0.8, pad=0.25];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.17,0.11"];
  edge [arrowsize=0.75, penwidth=1.4, color="#526b88"];

  scope [label="EXP-FROB-91ee9c C5\ncharacteristic boundary", fillcolor="#edf5ff", color="#274c77"];
  archived [label="Archived q = 11, 13, 19\n5 is invertible; distinct\nnontrivial factors of Φ₅", fillcolor="#eaf4ee", color="#297148"];
  char5 [label="Countercontrol q = 5\nX⁵ − 1 = (X − 1)⁵\nΦ₅ = (X − 1)⁴", fillcolor="#fff6e5", color="#b87823"];
  squarefree [label="Lean: X⁵ − 1 is not squarefree\nrepeated nonunit factor X − 1", fillcolor="#fff1ef", color="#aa4b3c"];
  boundary [label="Coprime-factor CRT premise\nfails in characteristic five", fillcolor="#fff1ef", color="#aa4b3c", penwidth=2];
  bridge [label="Still open: archived quotient-field\ncode and historical C5/C8 gates", style="rounded,dashed,filled", fillcolor="#f5f3f9", color="#76668e"];

  scope -> archived [label="recorded cells", fontcolor="#297148"];
  scope -> char5 [label="negative control", fontcolor="#b87823"];
  char5 -> squarefree -> boundary;
  archived -> bridge [style=dashed, color="#76668e"];
  boundary -> bridge [style=dashed, color="#76668e", label="no run verdict", fontcolor="#76668e"];
}
