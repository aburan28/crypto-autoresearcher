digraph RMFFTGuard {
  graph [rankdir=LR, bgcolor="white", pad="0.12", nodesep="0.35", ranksep="0.48", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#55718d", fontname="Helvetica", fontsize=11];
  edge [color="#55718d", arrowsize=0.7];
  fft [label="FFT correlation\nreal-valued S(t)"];
  finite [label="All outputs finite?\nraise otherwise", fillcolor="#dff3e7", color="#38865c"];
  residual [label="max |S - round(S)| <= 0.001?\nraise otherwise", fillcolor="#dff3e7", color="#38865c"];
  count [label="Rounded integer counts\nsmall-prime tests pass", fillcolor="#fff1d6", color="#a8781e"];
  boundary [label="56,630-member archival survey\nindependent exact replay still open", fillcolor="#fff1d6", color="#a8781e"];
  fft -> finite -> residual -> count -> boundary;
}
