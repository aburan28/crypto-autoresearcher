digraph BINSTDSourceAudit {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.45, ranksep=0.55, pad=0.16];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.10"];
  edge [arrowsize=0.7, penwidth=1.3];
  frozen [label="Frozen EV-BINSTD-030b4e\n5 internal citations lack named readers", fillcolor="#fff6e5", color="#b87823"];
  sources [label="Read H, EXP, approval DEC,\nsource HEUR, AGENTS.md", fillcolor="#eaf4ee", color="#297148"];
  mismatch [label="Found policy attribution error\ncore rule 3 is experiment design\ncore rule 5 bars mathematical inference\nfrom implementation failure", fillcolor="#fff1ef", color="#aa4b3c"];
  correction [label="Hash-bound additive v2\n5 scoped source readings\npolicy citation corrected", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  boundary [label="No new run, timing or HEUR verdict\nStage 1 XOR-SAT pin still absent", style="rounded,dashed,filled", fillcolor="#f2f3f7", color="#6d7280"];
  frozen -> sources -> mismatch -> correction -> boundary;
}
