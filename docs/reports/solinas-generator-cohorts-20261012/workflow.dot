digraph cohorts {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.25", ranksep="0.35"];
  node [shape=box, style="rounded,filled", fillcolor="#edf3f9", color="#365671", fontname="DejaVu Sans", fontsize=10];
  edge [color="#365671", fontname="DejaVu Sans", fontsize=9];
  inputs [label="Frozen public inputs + protocol + source hashes\nP-192 / P-224 exact p, A, B, n, published G"];
  published [label="Published generator G\n2,560 walks + 256 iid blocks per curve"];
  random [label="Random generators H = [r]G\nSame curves and paired scalar schedules"];
  fields [label="Prime / random-model baseline\n512 S models; 144 R + 144 C fields per case\n4 models per control field; uniform affine points"];
  raw [label="Deterministic public sampling; restartable chunks\n46,399,488 exact coordinate pairs + seeds + checksums", fillcolor="#e9f1e7"];
  checks [label="Every point on curve; full feature replay\nIndependent scalar and walk arithmetic\nShuffle / sorted / isomorphic coordinate controls", fillcolor="#e9f1e7"];
  stats [label="Paired generator-block and field-cluster inference\n20 prespecified mean comparisons\nNominal 99.9% simultaneous intervals (approximate)"];
  store [label="Large filesystem + immutable manifests\nCSV / JSON results; deduplicated SQLite catalog\nSeparate future discovery and confirmation batches"];
  inputs -> published; inputs -> random; inputs -> fields;
  published -> raw; random -> raw; fields -> raw;
  raw -> checks -> stats -> store;
}
