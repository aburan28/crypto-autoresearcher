digraph C5MatrixKernels {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.35, ranksep=0.42, pad=0.14];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.15,0.10"];
  edge [arrowsize=0.7, penwidth=1.3];
  frozen [label="Frozen C5 moduli and matrices\nq11, q13, q19", fillcolor="#fff6e5", color="#b87823"];
  basis [label="Lean quotient-basis certificate\n75 q-power matrix entries", fillcolor="#eaf4ee", color="#297148"];
  factors [label="Lean cyclotomic factors\n4 linear; 1 quartic; 2 quadratic", fillcolor="#eaf4ee", color="#297148"];
  kernel [label="Exact matrix factor kernels\ndirect sums = five-term trace kernels", fillcolor="#eaf4ee", color="#297148"];
  rank [label="Lean computes each trace matrix\nrank 1, kernel dimension 4", fillcolor="#eaf4ee", color="#297148"];
  result [label="Three exact matrix C5 controls\nfactor sums = trace kernels, dim 4", fillcolor="#dcefe7", color="#1b6644", penwidth=2];
  open [label="Open: historical Sage refinement,\noriginal source custody and review; C8", style="rounded,dashed,filled", fillcolor="#fff1ef", color="#aa4b3c"];
  frozen -> basis -> kernel;
  factors -> kernel;
  basis -> rank;
  kernel -> result;
  rank -> result;
  result -> open [style=dashed, color="#aa4b3c"];
}
