digraph Campaign {
  rankdir=TB;
  graph [fontname="DejaVu Sans", bgcolor="white", pad="0.25"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4f8", fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10];
  source [label="Frozen public inputs + fresh seed\nExact target: 250,000,000,000 point observations"];
  named [label="Selected / published / fresh random G\n44,389,200 motif and parity windows/arm\n177,556,850 long-run windows/arm"];
  controls [label="125 ordinary-prime matched models\n62 R +63 C\n1,420,454 uniform affine starts/model", fillcolor="#f5efe3"];
  checks [label="16,384-window chunks\nEvery point finite/on-curve\nEvery bit-score replay + separate frame arithmetic"];
  store [label="Required storage choice\nFull compact chunks: large filesystem or S3\nOr explicitly selected bounded aggregate retention", fillcolor="#f6e8e5"];
  inference [label="Infer after exact fixed completion\n18 exact paired +2 approximate field tests\nNominal99.99% primary family; separate30-rate CP family"];
  {rank=same;named;controls;}
  source -> named;
  source -> controls;
  named -> checks;
  controls -> checks;
  checks -> store;
  store -> inference [label="scientific launch pending storage selection"];
}
