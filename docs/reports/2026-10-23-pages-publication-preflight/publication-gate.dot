digraph pages_gate {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.28", ranksep="0.5",
         fontname="DejaVu Sans", fontsize=12];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10,
        color="#334155", fillcolor="#e2e8f0", margin="0.16,0.10"];
  edge [color="#475569", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

  local [label="Full-history local build\n27,585 records · 55,318 files\n9 comparison rows · dates available", fillcolor="#dcfce7"];
  tests [label="Local checks\n132 Python + 19 Node pass\n7 source hashes + 234 fields pass", fillcolor="#dcfce7"];
  queue [label="Current PR/CI checks\nqueued; all-pass gate open", fillcolor="#fef3c7"];
  approval [label="Owner decision\npublish after checks pass", fillcolor="#dbeafe"];
  deploy [label="Enable Pages + dispatch\nthen hosted build/deploy", fillcolor="#f1f5f9"];
  readback [label="Read back public meta and\n9-row comparison payload", fillcolor="#f1f5f9"];

  local -> tests;
  tests -> deploy [label="fresh main build required"];
  queue -> deploy [label="must pass"];
  approval -> deploy;
  deploy -> readback;

  stale [label="Public snapshot: Oct 11\nPages disabled manually", fillcolor="#fee2e2"];
  warnings [label="Visible integrity warnings\n24 parse · 225 duplicate IDs\n306 path mismatches · 1,678 dangling refs", fillcolor="#fef3c7"];
  stale -> readback [style=dashed, label="replace only after gate"];
  warnings -> deploy [style=dashed, label="publish with scope shown"];
}
