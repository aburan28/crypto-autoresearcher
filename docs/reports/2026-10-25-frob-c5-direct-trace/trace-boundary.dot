digraph C5TraceBoundary {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.65", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#456681", fontname="Helvetica", fontsize=12, margin="0.16,0.12"];
  edge [color="#456681", arrowsize=0.8, fontname="Helvetica", fontsize=10];

  raw [label="SHA-bound frozen output\nq, degree 5, modulus", fillcolor="#dceafa"];
  direct [label="Independent quotient arithmetic\nrepeat u -> u^q on each basis vector", fillcolor="#dff2e7"];
  t [label="Direct trace matrix T\nrank 1; nullity 4", fillcolor="#dff2e7"];
  archived [label="Prior source-bound replay\nreconstructed q-power matrix M", fillcolor="#f1eafa"];
  h [label="Matrix polynomial h(M)\nh = 1 + X + ... + X^4", fillcolor="#f1eafa"];
  compare [label="T = h(M) in all 3 cells\nq13 matrix mutation rejected", fillcolor="#fff1d6", color="#a86b1b"];
  limit [label="Historical Sage process custody missing\nC5 run verdict remains unestablished", fillcolor="#fae4e4", color="#af5151"];

  raw -> direct -> t -> compare;
  archived -> h -> compare;
  compare -> limit [style=dashed, label="scope limit", color="#af5151"];
}
