digraph Study {
  rankdir=TB;
  graph [fontname="DejaVu Sans", bgcolor="white", pad="0.25", nodesep="0.3"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4f8", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#567080"];
  historical [label="3 historical rare-prefix candidates\nThresholds locked before new data"];
  uniform [label="Uniform public Q = kG\nSame Q within each 3-arm window"];
  arms [label="Selected H / published G / fresh rG\n256 points per window\n1,048,576 or 4,194,304 windows/arm"];
  fields [label="64 ordinary-prime models\nA=-3, same B and step x\n65,536 uniform affine starts/model", fillcolor="#f4efe3"];
  bits [label="Every x bit 64 + exact scores\nAll rare and fixed witness xy frames\nFull transient xy-stream SHA256"];
  comparisons [label="9 exact paired event-rate tests\n2 approximate field comparisons\nFamily alpha 0.001"];
  limits [label="Conditional rates and intervals\nNo ECDLP or prime-family conclusion", fillcolor="#f2e9e7"];
  { rank=same; arms; fields; }
  historical -> uniform;
  uniform -> arms;
  arms -> bits;
  fields -> bits [label="matched coefficients/step x\ngroup order unmatched"];
  bits -> comparisons;
  comparisons -> limits;
}
