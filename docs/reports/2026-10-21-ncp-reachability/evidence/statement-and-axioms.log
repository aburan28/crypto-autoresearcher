theorem CryptoResearch.NCP.shadow_reachable_iff : ∀ {B : ℕ} (e : ℤ) (a : Fin B → ℤ),
  e = 1 ∨ e = -1 →
    ∀ (d : ℕ),
      (∃ w,
          w.length ≤ d ∧
            CryptoResearch.NCP.shadowSign w = e ∧ ∀ (i : Fin B), CryptoResearch.NCP.signedCount w i = a i) ↔
        CryptoResearch.NCP.vectorWeight a + CryptoResearch.NCP.shadowPenalty e a ≤ d :=
fun {B} e a he d =>
  {
    mp := fun a_1 =>
      Exists.casesOn a_1 fun w h =>
        And.casesOn h fun hlen right =>
          And.casesOn right fun hsign hcount =>
            have hlower := CryptoResearch.NCP.shadow_length_lower✝ w;
            have ha := funext hcount;
            have hw :=
              of_eq_true
                (Eq.trans
                  (congrFun'
                    (congrArg Eq
                      (Finset.sum_congr (Eq.refl Finset.univ) fun x a_2 => congrArg Int.natAbs ((fun i => hcount i) x)))
                    (∑ x, (a x).natAbs))
                  (eq_self (∑ x, (a x).natAbs)));
            Decidable.byContradiction fun a_2 =>
              CryptoResearch.NCP.shadow_reachable_iff._proof_1_3 e a d w hlen
                (Eq.mp
                  (congrArg
                    (fun _a => CryptoResearch.NCP.vectorWeight a + CryptoResearch.NCP.shadowPenalty e _a ≤ w.length) ha)
                  (Eq.mp
                    (congrArg
                      (fun _a =>
                        CryptoResearch.NCP.vectorWeight a +
                            CryptoResearch.NCP.shadowPenalty _a (CryptoResearch.NCP.signedCount w) ≤
                          w.length)
                      hsign)
                    (Eq.mp
                      (congrArg
                        (fun _a =>
                          _a +
                              CryptoResearch.NCP.shadowPenalty (CryptoResearch.NCP.shadowSign w)
                                (CryptoResearch.NCP.signedCount w) ≤
                            w.length)
                        hw)
                      hlower)))
                hw a_2,
    mpr := fun hbound =>
      Exists.casesOn (CryptoResearch.NCP.shadow_realized_with_length✝ e a he) fun w h =>
        And.casesOn h fun hsign right =>
          And.casesOn right fun hcount hlen =>
            Exists.intro w
              ⟨Decidable.byContradiction fun a_1 =>
                  CryptoResearch.NCP.shadow_reachable_iff._proof_1_4 e a d hbound w hlen a_1,
                ⟨hsign, hcount⟩⟩ }
'CryptoResearch.NCP.shadow_reachable_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
