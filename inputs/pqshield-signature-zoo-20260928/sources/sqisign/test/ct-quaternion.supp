# ---------------------------------------------------------------------------
# Valgrind's own replacement string routines, VALUE USES ONLY.
#
{
   ct-quat: valgrind replacement mem* copying tainted payload bytes (never a branch)
   Memcheck:Value8
   obj:*vgpreload_memcheck*
}

