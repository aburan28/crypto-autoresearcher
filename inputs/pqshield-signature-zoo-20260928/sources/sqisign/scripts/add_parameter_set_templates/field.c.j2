void
fp_set_small(fp_t *x, const digit_t val)
{
    modint((int)val, x->fp);
}

void
fp_mul_small(fp_t *x, const fp_t *a, const uint32_t val)
{
    // via modmul (radix-independent; avoids modmli small-multiplier limits)
    fp_t t;
    modint((int)val, t.fp);
    modmul(a->fp, t.fp, x->fp);
}

