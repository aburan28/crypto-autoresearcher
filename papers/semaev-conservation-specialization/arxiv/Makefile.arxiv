TARBALL := semaev-monodromy.tar.gz
RUN     := ../../../experiments/EXP-SMON-e5cbe6
RESULT_SHA := a7f3cb1265cf110291e8169bcea184374c807372fb7ca3ad841f29eed4b57974

.PHONY: all pdf stage tarball check clean

all: check tarball

# The ancillary code is NOT duplicated into git: it is staged from the
# experiment that produced it, so the two can never drift apart. Only
# anc/README.md is tracked.
stage:
	cp ../paper.tex paper.tex
	cp $(RUN)/code/semaev_cover.py $(RUN)/code/verify.py anc/
	cp $(RUN)/runs/RUN-SMON-e5cbe6-001/raw-result.json anc/
	@echo "$(RESULT_SHA)  anc/raw-result.json" | sha256sum -c - \
	  || { echo "REFUSING: staged raw-result.json does not match the recorded hash"; exit 1; }

pdf: stage
	pdflatex -interaction=nonstopmode -halt-on-error paper.tex
	pdflatex -interaction=nonstopmode paper.tex
	pdflatex -interaction=nonstopmode paper.tex

# Refuse to build a tarball from a manuscript that does not compile cleanly,
# still carries the author placeholder, or embeds Type 3 bitmap fonts (which
# arXiv flags).
check: pdf
	@! grep -q "AUTHOR NAME" paper.tex || \
	  { echo "REFUSING: author block is still the placeholder"; exit 1; }
	@! grep -qE "Warning: (Reference|Citation)" paper.log || \
	  { echo "REFUSING: undefined reference or citation"; exit 1; }
	@if command -v pdffonts >/dev/null 2>&1; then \
	  ! pdffonts paper.pdf | grep -q "Type 3" || \
	    { echo "REFUSING: Type 3 bitmap fonts present"; exit 1; }; \
	fi
	@echo "OK: compiles clean, author filled in, no Type 3 fonts"

tarball: stage
	rm -rf anc/__pycache__
	tar czf $(TARBALL) --exclude='__pycache__' --exclude='*.pyc' paper.tex anc/
	@echo "wrote $(TARBALL) -- upload this, not the PDF:"
	@tar tzf $(TARBALL) | sed 's/^/  /'

clean:
	rm -rf anc/__pycache__
	rm -f paper.tex paper.aux paper.log paper.out paper.toc paper.pdf $(TARBALL)
