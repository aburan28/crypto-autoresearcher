  rw [Matrix.rank_mul_eq_right_of_isUnit_det U A hdet, pivotCount] at h
  exact h
theorem sourceRank : (matrixOfRows 80 (rows 3)).rank = 53 := by
  rw [← literalRows_eq]
  exact actualRank
