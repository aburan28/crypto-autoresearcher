import Mathlib.Algebra.FreeAlgebra
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.Algebra.Field.ZMod
import Mathlib.RingTheory.TwoSidedIdeal.Kernel
import Mathlib.RingTheory.TwoSidedIdeal.Operations

set_option autoImplicit false

namespace CryptoResearch.NCP

abbrev WordAlgebra (B : ℕ) := FreeAlgebra ℤ (Option (Fin B))

def negLetter (B : ℕ) : WordAlgebra B := FreeAlgebra.ι ℤ none

def commutatorIdeal (B : ℕ) : TwoSidedIdeal (WordAlgebra B) :=
  TwoSidedIdeal.span {z | ∃ x y : WordAlgebra B, z = x*y - y*x}

/-- Evaluation in integers kills every commutator but sends v²-1 to 3.
This avoids assuming a theorem about the abelianization quotient. -/
theorem neg_square_not_in_commutators (B : ℕ) :
    negLetter B ^ 2 - 1 ∉ commutatorIdeal B := by
  let ev : WordAlgebra B →ₐ[ℤ] ℤ := FreeAlgebra.lift ℤ (fun _ => 2)
  have hle : commutatorIdeal B ≤ TwoSidedIdeal.ker ev.toRingHom := by
    apply TwoSidedIdeal.span_le.mpr
    rintro z ⟨x, y, rfl⟩
    apply (TwoSidedIdeal.mem_ker ev.toRingHom).mpr
    simp [mul_comm]
  intro h
  have hz := (TwoSidedIdeal.mem_ker ev.toRingHom).mp (hle h)
  norm_num [ev, negLetter, map_sub, map_pow, FreeAlgebra.lift_ι_apply] at hz

def affineGroup (n : ℕ) : Subgroup (Equiv.Perm (ZMod n)) :=
  Subgroup.closure ({Equiv.neg (ZMod n)} ∪ Set.range (fun b : ZMod n => Equiv.addRight b))

def affineNeg (n : ℕ) : affineGroup n :=
  ⟨Equiv.neg (ZMod n), Subgroup.subset_closure (Or.inl (by simp))⟩

def affineTranslation {n : ℕ} (b : ZMod n) : affineGroup n :=
  ⟨Equiv.addRight b, Subgroup.subset_closure (Or.inr ⟨b, rfl⟩)⟩

/-- The actual action-algebra evaluation into the group ring of the group
generated by all translations and negation of the cyclic scalar group. -/
noncomputable def actionEvaluation {B n : ℕ} (s : Fin B → ZMod n) :
    WordAlgebra B →ₐ[ℤ] MonoidAlgebra ℤ (affineGroup n) :=
  FreeAlgebra.lift ℤ (fun letter =>
    MonoidAlgebra.of ℤ (affineGroup n)
      (match letter with
       | none => affineNeg n
       | some i => affineTranslation (s i)))

theorem neg_square_in_action_kernel {B n : ℕ} (s : Fin B → ZMod n) :
    negLetter B ^ 2 - 1 ∈ TwoSidedIdeal.ker (actionEvaluation s).toRingHom := by
  rw [TwoSidedIdeal.mem_ker, map_sub, map_pow, map_one]
  have hneg : affineNeg n ^ 2 = 1 := by
    apply Subtype.ext
    ext x
    simp [pow_two, affineNeg]
  have hv : actionEvaluation s (negLetter B) =
      MonoidAlgebra.of ℤ (affineGroup n) (affineNeg n) := by
    simp [actionEvaluation, negLetter]
  change (actionEvaluation s (negLetter B)) ^ 2 - 1 = 0
  rw [hv]
  rw [← map_pow, hneg, map_one, sub_self]

/-- Proposition 1: a concrete element in the actual evaluation kernel and
outside the TWO-SIDED commutator ideal proves the ideals are different. -/
theorem kernel_not_generated_by_commutators {B n : ℕ} (s : Fin B → ZMod n) :
    TwoSidedIdeal.ker (actionEvaluation s).toRingHom ≠ commutatorIdeal B := by
  intro h
  have hw := neg_square_in_action_kernel s
  rw [h] at hw
  exact neg_square_not_in_commutators B hw

end CryptoResearch.NCP
