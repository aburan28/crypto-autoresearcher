/-
Chain endomorphisms: the modular arithmetic of the recorded eigenvalues.

Source: research/endosweep_chainsweep_20261006/README.md and
        research/endosweep_20261005/README.md (appended "Lean verification"
        sections), data in research/endosweep_chainsweep_20261006/chains.constants.json,
        research/endosweep_curves_20261006/curves.json,
        research/endosweep_20261005/cryptopro_b_chain_5_5_7.constants.json and
        cryptopro_b_chain_5_31.constants.json.
Targets: formal/targets/endosweep-chain-glv-basis.yaml
         formal/targets/endosweep-chain-cryptopro-b-certificate.yaml
         formal/targets/endosweep-chain-cp6-782-certificate.yaml

`explicit.build_chain_endomorphism` accepts a closed isogeny walk as the
element `a + bω` when it acts on a point of prime order `n` as the scalar
`a' + b'·λ_ω mod n`, where `(a', b')` is the element times a unit (`±1` here)
and `λ_ω` is a root of `x² − τx + N(ω)` mod `n`. It then checks a GLV-2
decomposition `k ≡ k₁ + k₂·λ (mod n)` with the reduced relation-lattice basis.

WHAT IS PROVED HERE.

* `eigenvalue_root_charpoly` -- if `λ_ω² ≡ τλ_ω − m (mod n)` and
  `e ≡ a + bλ_ω (mod n)` then `e` is a root mod `n` of the characteristic
  polynomial `x² − (2a + bτ)x + N(a + bω)` of the element (a ring identity).
* `glv_basis_spans_relation_lattice` -- two vectors of the relation lattice
  `{(x, y) : x + y·e ≡ 0 (mod n)}` whose determinant is `±n` form a basis of
  it (Cramer's rule).
* `cryptopro_b_chain_certificate` -- for all 22 orderings (11 elements) of the
  frozen chain set: `λ_ω² − λ_ω + 155 ≡ 0 (mod n)`; `N(a + bω) = ` the
  recorded norm `= ` the product of the step degrees (e.g. `N(4 + ω) = 175 =
  7·5·5`); the matched element is `±(a + bω)`; the recorded eigenvalue is
  `a' + b'λ_ω mod n` and a root of the matched element's characteristic
  polynomial; both reduced GLV basis vectors lie in the relation lattice with
  determinant `±n`; and both recorded test vectors satisfy
  `k ≡ k₁ + k₂·e (mod n)`. Also: the two chains exported in
  `endosweep_20261005` (`5·5·7`, matched `−5 + ω`; `5·31`, matched `−ω`) carry
  the eigenvalues of `−5 + λ'` and `−λ'` for the conjugate root
  `λ' = 1 − λ_ω`; the first is the same scalar `−(4 + λ_ω)` as the chain
  sweep's `4 + ω` (the second, `λ_ω − 1`, is `−ω̄` in the chain sweep's
  convention, not its `ω` chain, which acts as `−λ_ω`).
* `cp6_782_chain_certificate` -- with `λ := e(4 + ω) − 4` (derived, as
  `subgroup.py` derives it): `λ² − λ + 85 ≡ 0 (mod r)`, and every one of the
  18 recorded eigenvalues of `curves.json` is `±(a + bλ) mod r` with
  `N(a + bω)` = recorded norm = product of the steps (`N(4 + ω) = 105 = 3·5·7`,
  `N(9 + ω) = 175 = 5·5·7`): the "eigenvalues consistent" flag. For the
  conjugate root `λ' = 1 − λ`, `e(4 + ω) = 5 − λ'` and `e(9 + ω) = λ' − 10`,
  the forms quoted in `endosweep_20261005/cp6_782/README.md`.

WHAT IS NOT PROVED HERE. That any isogeny walk exists, that it is an
endomorphism, that it acts on points as the recorded scalar (the harness
checks that on points), that the curve's group order is `n`/`h·r`, primality
of `n`, `r` or `p`, the class number, the completeness bounds, or any cost.
These theorems certify the ARITHMETIC of the recorded eigenvalues, GLV bases
and test vectors, not the isogeny computation.
-/
import Mathlib.Tactic.Ring

namespace CryptoResearch.Endosweep.ChainEigen

/-! ## General lemmas -/

/-- `N(a + bω) = a² + abτ + b²m` for `ω² = τω − m`. -/
def qnorm (τ m a b : Int) : Int := a * a + a * b * τ + b * b * m

/-- **The eigenvalue of `a + bω` is a root of its characteristic polynomial.**
If `ω` acts as `λ` (`λ² − τλ + m ≡ 0`) and `e ≡ a + bλ (mod n)`, then
`e² − (2a + bτ)e + N(a + bω) ≡ 0 (mod n)`. -/
theorem eigenvalue_root_charpoly (n τ m lam a b e : Int)
    (hlam : n ∣ lam * lam - τ * lam + m) (he : n ∣ e - (a + b * lam)) :
    n ∣ e * e - (2 * a + b * τ) * e + qnorm τ m a b := by
  obtain ⟨k1, hk1⟩ := hlam
  obtain ⟨k2, hk2⟩ := he
  have key : e * e - (2 * a + b * τ) * e + qnorm τ m a b
      = b * b * (lam * lam - τ * lam + m) + (e - (a + b * lam)) * (e - a + b * lam - b * τ) := by
    simp only [qnorm]; ring
  refine ⟨b * b * k1 + k2 * (e - a + b * lam - b * τ), ?_⟩
  rw [key, hk1, hk2]; ring

/-- **A determinant-`±n` pair in the GLV relation lattice is a basis of it.**
If `b₁, b₂` satisfy `bᵢ.1 + bᵢ.2·e ≡ 0 (mod n)` and `det [b₁ b₂] = ±n ≠ 0`,
then `(x, y)` satisfies `x + y·e ≡ 0 (mod n)` iff it is an integer combination
of `b₁, b₂`. -/
theorem glv_basis_spans_relation_lattice (n e : Int) (b1 b2 : Int × Int) (hn : n ≠ 0)
    (h1 : n ∣ b1.1 + b1.2 * e) (h2 : n ∣ b2.1 + b2.2 * e)
    (hdet : b1.1 * b2.2 - b1.2 * b2.1 = n ∨ b1.1 * b2.2 - b1.2 * b2.1 = -n) (x y : Int) :
    n ∣ x + y * e ↔ ∃ p q : Int, x = p * b1.1 + q * b2.1 ∧ y = p * b1.2 + q * b2.2 := by
  obtain ⟨u1, v1⟩ := b1
  obtain ⟨u2, v2⟩ := b2
  simp only at h1 h2 hdet ⊢
  constructor
  · intro hv
    obtain ⟨c, hc⟩ := hv
    obtain ⟨c1, hc1⟩ := h1
    obtain ⟨c2, hc2⟩ := h2
    -- the two minors det[v b₂], det[v b₁] are multiples of n
    have m2 : x * v2 - y * u2 = n * (c * v2 - y * c2) := by
      have : x * v2 - y * u2 = (x + y * e) * v2 - y * (u2 + v2 * e) := by ring
      rw [this, hc, hc2]; ring
    have m1 : x * v1 - y * u1 = n * (c * v1 - y * c1) := by
      have : x * v1 - y * u1 = (x + y * e) * v1 - y * (u1 + v1 * e) := by ring
      rw [this, hc, hc1]; ring
    -- Cramer: det[b₁ b₂]·v = det[v b₂]·b₁ − det[v b₁]·b₂
    have cx : (u1 * v2 - v1 * u2) * x = (x * v2 - y * u2) * u1 - (x * v1 - y * u1) * u2 := by ring
    have cy : (u1 * v2 - v1 * u2) * y = (x * v2 - y * u2) * v1 - (x * v1 - y * u1) * v2 := by ring
    rcases hdet with hd | hd
    · refine ⟨c * v2 - y * c2, -(c * v1 - y * c1), ?_, ?_⟩
      · apply Int.eq_of_mul_eq_mul_left hn
        rw [← hd, cx, m2, m1, hd]; ring
      · apply Int.eq_of_mul_eq_mul_left hn
        rw [← hd, cy, m2, m1, hd]; ring
    · refine ⟨-(c * v2 - y * c2), c * v1 - y * c1, ?_, ?_⟩
      · apply Int.eq_of_mul_eq_mul_left hn
        have hd' : n = -(u1 * v2 - v1 * u2) := by rw [hd]; ring
        rw [hd', Int.neg_mul, cx, m2, m1, hd]; ring
      · apply Int.eq_of_mul_eq_mul_left hn
        have hd' : n = -(u1 * v2 - v1 * u2) := by rw [hd]; ring
        rw [hd', Int.neg_mul, cy, m2, m1, hd]; ring
  · rintro ⟨p, q, rfl, rfl⟩
    obtain ⟨c1, hc1⟩ := h1
    obtain ⟨c2, hc2⟩ := h2
    refine ⟨p * c1 + q * c2, ?_⟩
    have : p * u1 + q * u2 + (p * v1 + q * v2) * e = p * (u1 + v1 * e) + q * (u2 + v2 * e) := by
      ring
    rw [this, hc1, hc2]; ring

/-! ## GOST CryptoPro-B, `D = −619` (`ω² = ω − 155`) -/

/-- One ordering of `chains.constants.json`. -/
structure ChainRow where
  id : String
  a : Int
  b : Int
  ma : Int
  mb : Int
  norm : Int
  order : List Int
  e : Int
  b1 : Int × Int
  b2 : Int × Int
  tests : List (Int × Int × Int)

/-- What is checked for one ordering. -/
def ChainRow.Valid (n lam τ m : Int) (c : ChainRow) : Prop :=
  qnorm τ m c.a c.b = c.norm ∧ c.order.foldr (· * ·) 1 = c.norm ∧
  ((c.ma = c.a ∧ c.mb = c.b) ∨ (c.ma = -c.a ∧ c.mb = -c.b)) ∧
  0 ≤ c.e ∧ c.e < n ∧ (c.e - (c.ma + c.mb * lam)) % n = 0 ∧
  (c.e * c.e - (2 * c.ma + c.mb * τ) * c.e + c.norm) % n = 0 ∧
  (c.b1.1 + c.b1.2 * c.e) % n = 0 ∧ (c.b2.1 + c.b2.2 * c.e) % n = 0 ∧
  (c.b1.1 * c.b2.2 - c.b1.2 * c.b2.1 = n ∨ c.b1.1 * c.b2.2 - c.b1.2 * c.b2.1 = -n) ∧
  ∀ t ∈ c.tests, (t.1 - t.2.1 - t.2.2 * c.e) % n = 0

instance (n lam τ m : Int) (c : ChainRow) : Decidable (c.Valid n lam τ m) := by
  unfold ChainRow.Valid; infer_instance

