# Copy to `.env` and fill in what you use:  cp .env.example .env
#
# `.env` is gitignored and loaded automatically by the `autoresearch` command
# (never overriding a variable already set in your shell). Everything here is
# also just ordinary environment variables — `export` them instead if you
# prefer, or use your own secret manager.
#
# You do NOT need all of these. One backend is enough. Check what you have:
#
#     autoresearch backends      # endpoints, env vars, what is bound
#     autoresearch doctor        # what is missing, and the next command
#
# ---------------------------------------------------------------------------
# Which backend to use by default
# ---------------------------------------------------------------------------
# One of: anthropic | zai | zai-anthropic | fireworks | fireworks-anthropic
#         | openai | openrouter | local
AUTORESEARCH_BACKEND=anthropic

# ---------------------------------------------------------------------------
# Anthropic  —  https://api.anthropic.com  (Anthropic Messages wire)
# ---------------------------------------------------------------------------
# Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only set this to point at a gateway or proxy; the default is correct otherwise.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------------------
# GLM via Z.ai  —  two backends, same models, different wire protocols
# ---------------------------------------------------------------------------
# Key from https://z.ai/manage-apikey/apikey-list  (one key serves both)
ZAI_API_KEY=
#
#   backend `zai`            OpenAI-compatible   https://api.z.ai/api/paas/v4
#   backend `zai-anthropic`  Anthropic-compatible https://api.z.ai/api/anthropic
#
# Use `zai` for OpenAI-protocol clients and this repository's own runtime.
# Use `zai-anthropic` to point an Anthropic-protocol CLI at GLM.
#
# Mainland-China deployments — override rather than editing providers.yaml:
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZAI_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# ---------------------------------------------------------------------------
# Fireworks AI  —  two backends, same models, different wire protocols
# ---------------------------------------------------------------------------
# Key from https://fireworks.ai/account/api-keys  (one key serves both)
FIREWORKS_API_KEY=
#
#   backend `fireworks`            OpenAI-compatible    https://api.fireworks.ai/inference/v1
#   backend `fireworks-anthropic`  Anthropic-compatible https://api.fireworks.ai/inference
#
# IMPORTANT: Fireworks serves OPEN-WEIGHT models (GLM, Kimi, DeepSeek, Qwen,
# Llama and similar). The two protocols are wire compatibility, NOT access to
# Anthropic's or OpenAI's proprietary models — there is no Claude here.
#
# The Anthropic-compatible endpoint authenticates with X-Fireworks-Api-Key
# rather than x-api-key (declared per-backend in providers.yaml), so a real
# ANTHROPIC_API_KEY in your environment cannot be sent to it by accident.
#
# Ships UNBOUND: fill model ids in orchestration/model-bindings.yaml first.
#     autoresearch adapter models --backend fireworks
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# FIREWORKS_ANTHROPIC_BASE_URL=https://api.fireworks.ai/inference

# ---------------------------------------------------------------------------
# OpenAI  —  https://api.openai.com/v1  (OpenAI Chat wire)
# ---------------------------------------------------------------------------
# Key from https://platform.openai.com/api-keys
# NOTE: this backend ships UNBOUND (model: null for every policy). Fill in
# model ids in orchestration/model-bindings.yaml before it can resolve:
#     autoresearch adapter models --backend openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# OpenRouter  —  https://openrouter.ai/api/v1  (one key, many vendors)
# ---------------------------------------------------------------------------
# Key from https://openrouter.ai/keys
# Also ships unbound. Model ids here are namespaced, e.g. `vendor/model`.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Self-hosted  —  vLLM, SGLang, Ollama, or anything OpenAI-compatible
# ---------------------------------------------------------------------------
# The key is optional; most local servers ignore it.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_API_KEY=
#
# Worth considering for review runs: a pinned local weight set is the only
# configuration where `resolved_model_id` stays stable across time, so a run
# record stays reproducible after a vendor deprecates a model.

# ---------------------------------------------------------------------------
# Per-run overrides (normally set by `autoresearch adapter env`, not by hand)
# ---------------------------------------------------------------------------
# AUTORESEARCH_POLICY=research-deep
# AUTORESEARCH_FALLBACK_ALLOWED=false
# AUTORESEARCH_DEGRADED_ALLOWED=false
# Independence is a fact about how the session was launched, so the launcher
# has to assert it; the adapter never assumes it on a run's behalf.
# AUTORESEARCH_INDEPENDENT_SESSION=false
